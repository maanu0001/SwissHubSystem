# PostgreSQL 16 mit pgBackRest.
#
# Wird von docker-compose.prod.yml fuer den Dienst `postgres` gebaut, sobald
# Sicherungen eingerichtet sind.
#
# WARUM pgBackRest IM DATENBANKCONTAINER LIEGEN MUSS
#
# Ein physisches Backup kopiert die Dateien des Clusters. Die liegen im Volume,
# und an das Volume kommt nur der Container - vom Host aus gaebe es sie nur,
# wenn man in /var/lib/docker hineingriffe. Das ist genau die Art Abkuerzung,
# die bei einem Versionswechsel des Abbilds still bricht.
#
# Deshalb laeuft pgBackRest dort, wo die Dateien sind.

FROM postgres:16-alpine

# pgBackRest aus dem Alpine-Paketbestand.
#
# Die Fassung muss zu der auf dem Host passen: ein Repository, das mit 2.50
# geschrieben wurde, liest 2.45 nicht. `--no-cache` statt eines festen
# Versionsstifts, weil Alpine je Abbildfassung genau eine pgBackRest-Fassung
# fuehrt - und die passt zu dem PostgreSQL darin.
#
# Welche Fassung es geworden ist, sagt `swisshub-backup konfiguration`: der
# Systemstand im Backup notiert sie. Bei einer Wiederherstellung ist das die
# Angabe, die man braucht - ein Repository laesst sich nicht mit einer
# aelteren pgBackRest-Fassung lesen als der, die es geschrieben hat.
RUN apk add --no-cache pgbackrest \
    && pgbackrest version

# Verzeichnisse, die pgBackRest braucht und selbst nicht anlegt.
RUN mkdir -p /var/lib/swisshub-backup /etc/swisshub-backup \
    && chown -R postgres:postgres /var/lib/swisshub-backup

# Das Entrypoint bleibt das des Basisabbilds: dieser Container ist weiterhin
# PostgreSQL und nicht ein Backup-Werkzeug. pgBackRest wird von aussen per
# `docker exec` aufgerufen.
