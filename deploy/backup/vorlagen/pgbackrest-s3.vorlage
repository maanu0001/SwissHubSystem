# --- Repository 2: extern, S3-kompatibel, unveraenderbar -----------------
#
# Die Kopie, die den Verlust des Servers ueberlebt. Object Lock wird im Bucket
# gesetzt, nicht hier - pgBackRest schreibt nur, und mehr soll es auch nicht
# koennen.
#
# Die Zugangsdaten hier duerfen ANLEGEN und LESEN, nicht loeschen und nicht
# ueberschreiben. Wer diesen Server uebernimmt, bekommt sie - und kann mit
# ihnen die Historie nicht vernichten. Siehe vorlagen/s3-richtlinien.md.
repo2-type=s3
repo2-path=/pgbackrest
repo2-s3-bucket=@S3_BUCKET@
repo2-s3-endpoint=@S3_ENDPOINT_HOST@
repo2-s3-region=@S3_REGION@
repo2-s3-key=@S3_WRITE_KEY_ID@
repo2-s3-key-secret=@S3_WRITE_SECRET@
repo2-s3-uri-style=@S3_URI_STYLE@

repo2-cipher-type=aes-256-cbc
repo2-cipher-pass=@PGBACKREST_CIPHER_PASS@

# Aufbewahrung im externen Repository grosszuegiger als lokal.
#
# Der Grund ist der Angriffsfall: eine Beschaedigung, die erst nach Wochen
# auffaellt, ist lokal schon herausgerotiert. Die externe Kopie ist die, die
# weit genug zurueckreicht - und sie ist zugleich die, die nicht geloescht
# werden kann.
repo2-retention-full=@RETENTION_FULL_EXTERN@
repo2-retention-archive-type=full

# Der externe Speicher wird nicht bei jedem Lauf vollstaendig geprueft -
# das kostet Uebertragungsvolumen. Die Pruefung laeuft im eigenen Lauf
# (`swisshub-backup-verify`).
repo2-bundle=y
