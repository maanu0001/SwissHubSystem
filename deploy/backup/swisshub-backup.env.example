# ---------------------------------------------------------------------------
# SwissHub Backup - die einzige Konfigurationsdatei
#
# Ziel: /etc/swisshub-backup/swisshub-backup.env
# Rechte: root:swisshub-backup 0640 - der Dienstbenutzer liest, sonst niemand.
#
#   install -o root -g swisshub-backup -m 0640 \
#     deploy/backup/swisshub-backup.env.example /etc/swisshub-backup/swisshub-backup.env
#
# Diese Datei enthaelt Geheimnisse. Sie wird selbst mitgesichert - aber
# ausschliesslich im Wiederherstellungspaket (siehe RECOVERY_AGE_RECIPIENTS
# unten), niemals im gewoehnlichen Datei-Backup.
# ---------------------------------------------------------------------------

# === Was gesichert wird ====================================================

# Projektverzeichnis der System-WebApp (enthaelt .env, Compose, Quelltext).
SWISSHUB_PROJECT_DIR=/opt/swisshub

# Upload-Verzeichnis. Bei Docker der Pfad im Wirtsdateisystem, nicht im
# Container - zu finden mit:
#   docker volume inspect swisshub-uploads --format '{{.Mountpoint}}'
SWISSHUB_UPLOAD_DIR=/var/lib/docker/volumes/swisshub-uploads/_data

# Weitere Verzeichnisse, die mitgesichert werden sollen, durch Doppelpunkt
# getrennt. Leer lassen, wenn es keine gibt.
#
# Hier gehoeren die Daten der uebrigen SwissHub-Dienste hinein, SOBALD
# entschieden ist, dass sie in dasselbe Verfahren aufgenommen werden -
# siehe docs/DISASTER-RECOVERY.md, «Weitere SwissHub-Dienste».
SWISSHUB_EXTRA_PATHS=

# Konfigurationsdateien auf dem Host, die in keinem Repository stehen und die
# ein neuer Server braucht. Durch Doppelpunkt getrennt.
SWISSHUB_CONFIG_PATHS=/etc/nginx/sites-available:/etc/letsencrypt:/etc/swisshub-backup

# === Datenbank =============================================================

# Wie PostgreSQL erreichbar ist: `docker` oder `host`.
#
# `docker`  - PostgreSQL laeuft im Compose-Stack. pgBackRest laeuft dann
#             ebenfalls im Datenbankcontainer, weil es direkten Zugriff auf
#             das Datenverzeichnis braucht (ein physisches Backup kopiert
#             Dateien, nicht Zeilen).
# `host`    - PostgreSQL ist auf dem System installiert. pgBackRest laeuft
#             direkt daneben. Das ist der einfachere und schnellere Weg.
SWISSHUB_PG_MODE=docker

# Nur bei SWISSHUB_PG_MODE=docker: Name des Datenbankcontainers.
SWISSHUB_PG_CONTAINER=swisshub-postgres-1

# Datenverzeichnis des Clusters, aus Sicht von pgBackRest.
SWISSHUB_PG_DATA=/var/lib/postgresql/data

# Datenbankbenutzer fuer pgBackRest. Braucht Replikationsrechte, KEIN
# Superuser:
#   CREATE ROLE pgbackrest WITH LOGIN REPLICATION PASSWORD '...';
#   GRANT pg_read_all_settings TO pgbackrest;
#   GRANT EXECUTE ON FUNCTION pg_backup_start(text, boolean) TO pgbackrest;
#   GRANT EXECUTE ON FUNCTION pg_backup_stop(boolean) TO pgbackrest;
#   GRANT EXECUTE ON FUNCTION pg_switch_wal() TO pgbackrest;
#   GRANT EXECUTE ON FUNCTION pg_create_restore_point(text) TO pgbackrest;
SWISSHUB_PG_USER=postgres
SWISSHUB_PG_PORT=5432

# Die Anwendungsdatenbank - fuer die logischen Zusatzexporte und die
# Pruefungen nach einem Restore.
SWISSHUB_PG_DATABASE=swisshub

# === Lokales Backup-Repository (Stufe 1) ===================================

SWISSHUB_BACKUP_ROOT=/var/lib/swisshub-backup
SWISSHUB_PGBACKREST_REPO=/var/lib/swisshub-backup/pgbackrest
SWISSHUB_RESTIC_REPO=/var/lib/swisshub-backup/restic

# Untergrenze an freiem Platz. Wird sie unterschritten, bricht der Lauf ab,
# BEVOR er schreibt - ein volles Laufwerk nimmt PostgreSQL mit, und dann
# steht nicht nur die Sicherung, sondern der Dienst.
SWISSHUB_MIN_FREE_GB=10

# === Externes Repository (Stufe 2 und 3) ===================================
#
# S3-kompatibel. Getestet gedacht fuer Backblaze B2, Wasabi, Hetzner Object
# Storage, Scaleway, AWS S3 - alle mit Object Lock.
#
# Leer lassen schaltet die externe Kopie ab. Der Lauf meldet das dann als
# ausdrueckliche Warnung und nicht als Erfolg: eine Sicherung, die nur auf dem
# gesicherten Server liegt, ist gegen dessen Verlust keine.

SWISSHUB_S3_ENDPOINT=
SWISSHUB_S3_REGION=
SWISSHUB_S3_BUCKET=

# --- Zugangsdaten 1: SCHREIBEN (liegt auf diesem Server) -------------------
#
# Diese Zugangsdaten duerfen NUR anlegen und lesen. NICHT loeschen,
# NICHT ueberschreiben, NICHT die Object-Lock-Einstellung aendern.
#
# Genau darauf beruht der Schutz gegen Ransomware: wer diesen Server
# uebernimmt, bekommt diese Zugangsdaten - und kann mit ihnen die Historie
# nicht vernichten.
#
# Die genaue Richtlinie steht in deploy/backup/vorlagen/s3-richtlinien.md.
SWISSHUB_S3_WRITE_KEY_ID=
SWISSHUB_S3_WRITE_SECRET=

# --- Zugangsdaten 2: WIEDERHERSTELLEN (NICHT auf diesem Server!) -----------
#
# Nur lesend, und sie stehen hier bewusst NICHT. Sie gehoeren in das
# Wiederherstellungspaket und an den getrennten Aufbewahrungsort. Auf dem
# produktiven Server haben sie keinen Zweck - wiederhergestellt wird auf einem
# anderen.
#
# SWISSHUB_S3_RESTORE_KEY_ID=   <- bleibt leer
# SWISSHUB_S3_RESTORE_SECRET=   <- bleibt leer

# === Verschluesselung der Repositories =====================================
#
# Beide Werte einmalig erzeugen und NIE aendern: ein geaenderter Wert macht
# das bestehende Repository unlesbar.
#
#   openssl rand -base64 48
#
# Sie stehen hier, weil der Server sie zum Schreiben braucht. Sie stehen
# zusaetzlich im Wiederherstellungspaket, weil ohne sie kein Restore moeglich
# ist - und das Paket ist der einzige Ort, der den Serververlust ueberlebt.
SWISSHUB_PGBACKREST_CIPHER_PASS=
SWISSHUB_RESTIC_PASSWORD=

# === Wiederherstellungspaket (Schluesselverwaltung) ========================
#
# DAS HERZSTUECK. Ohne diesen Abschnitt ist jede Sicherung unvollstaendig.
#
# Das Paket enthaelt alles, was ein Restore braucht und was in keiner
# Sicherung stehen darf: MASTER_ENCRYPTION_KEY, die .env, die beiden
# Repository-Passwoerter oben, die lesenden S3-Zugangsdaten und eine
# Kurzanleitung.
#
# Verschluesselt wird mit `age` und AUSSCHLIESSLICH auf oeffentliche
# Empfaengerschluessel. Der zugehoerige private Schluessel liegt NICHT auf
# diesem Server. Der Server kann das Paket also schreiben und danach selbst
# nicht mehr lesen - und wer den Server uebernimmt, bekommt aus dem Paket
# nichts.
#
# Erzeugen (auf einem ANDEREN Rechner, nicht hier):
#   age-keygen -o swisshub-recovery.key
#   # Die Zeile "public key: age1..." hierher uebertragen.
#   # swisshub-recovery.key an zwei getrennte Orte: Passwortmanager und
#   # ein Medium im Safe. NIE auf diesen Server.
#
# Mindestens zwei Empfaenger eintragen, durch Leerzeichen getrennt. Zwei,
# weil ein einzelner verlorener privater Schluessel sonst alles verliert -
# jeder Empfaenger kann das Paket allein oeffnen.
SWISSHUB_RECOVERY_AGE_RECIPIENTS=

# === Aufbewahrung ==========================================================
#
# WICHTIG: Die WAL-Aufbewahrung muss zu den Basis-Backups passen. pgBackRest
# rechnet das selbst aus, wenn `repo1-retention-archive-type=full` gesetzt
# ist - siehe die erzeugte pgbackrest.conf. Ein zu knapper Wert loescht WAL,
# das das aelteste Basis-Backup noch braucht, und macht es unbrauchbar.

# Vollstaendige Basis-Backups, die aufbewahrt werden.
SWISSHUB_RETENTION_FULL=4
# Differentielle Backups je Vollbackup.
SWISSHUB_RETENTION_DIFF=14

# Restic: Anzahl der Wiederherstellungspunkte je Zeitraum.
SWISSHUB_RETENTION_HOURLY=48
SWISSHUB_RETENTION_DAILY=30
SWISSHUB_RETENTION_WEEKLY=12
SWISSHUB_RETENTION_MONTHLY=12

# Aufbewahrungsfrist des Object Lock in Tagen. Innerhalb dieser Frist kann
# NIEMAND die Objekte loeschen - auch nicht der Betreiber, auch nicht der
# Anbieter-Support. Das ist der Zweck.
#
# 30 Tage ist die Untergrenze fuer «spaet erkannte Beschaedigung»: weniger
# heisst, dass ein erst nach drei Wochen bemerkter Schaden bereits aus der
# Historie herausgelaufen ist.
SWISSHUB_OBJECT_LOCK_DAYS=30

# === Ausfuehrungsfenster und Ressourcen ====================================
#
# Backups laufen neben dem produktiven Bot. Sie duerfen ihn nicht verdraengen.

# Prozesse, die pgBackRest parallel verwendet. Bei 2 vCPU ist 1 richtig -
# 4 Prozesse auf 2 Kernen machen die Sicherung nicht schneller, aber den Bot
# langsamer.
SWISSHUB_PGBACKREST_PROCESSES=1

# I/O- und CPU-Gewichtung. Die systemd-Units setzen das; hier stehen die
# Werte, damit sie an einer Stelle gepflegt werden.
SWISSHUB_IO_WEIGHT=20
SWISSHUB_CPU_WEIGHT=20

# Bandbreitengrenze der Uebertragung nach aussen, in KiB/s. 0 = unbegrenzt.
SWISSHUB_UPLOAD_LIMIT_KIB=0

# === Alarmierung ===========================================================
#
# MINDESTENS EIN WEG MUSS UNABHAENGIG VOM EIGENEN SERVER SEIN.
#
# Der Discord-Bot taugt dafuer nicht: faellt der Server aus, faellt der Bot
# mit aus, und die Meldung ueber den Ausfall kommt nie an. Er ist als
# zusaetzlicher Weg sinnvoll, nie als einziger.

# --- Weg 1: E-Mail ueber einen externen Anbieter ---------------------------
# SMTP eines Anbieters, der NICHT auf diesem Server laeuft.
SWISSHUB_ALERT_SMTP_HOST=
SWISSHUB_ALERT_SMTP_PORT=587
SWISSHUB_ALERT_SMTP_USER=
SWISSHUB_ALERT_SMTP_PASSWORD=
SWISSHUB_ALERT_SMTP_FROM=
SWISSHUB_ALERT_SMTP_TO=

# --- Weg 2: Webhook eines externen Dienstes -------------------------------
# Beliebiger Dienst, der ein JSON-POST annimmt (ntfy.sh, Pushover, Gotify,
# Healthchecks.io, Better Stack, ...).
SWISSHUB_ALERT_WEBHOOK_URL=

# --- Weg 3: Totmannschalter (die wichtigste Meldung) ----------------------
#
# Eine Adresse, die nach JEDEM erfolgreichen Lauf angepingt wird. Der externe
# Dienst schlaegt Alarm, wenn der Ping AUSBLEIBT.
#
# Das ist der einzige Mechanismus, der auch dann funktioniert, wenn der Server
# vollstaendig ausfaellt: eine Meldung, die nicht kommt, faellt auf. Jede
# Alarmierung, die vom Server ausgehen muss, faellt mit ihm aus.
#
# Einrichten z.B. bei healthchecks.io (kostenloser Tarif genuegt) mit einer
# Erwartung von 26 Stunden.
SWISSHUB_ALERT_HEARTBEAT_URL=

# --- Weg 4: Discord (ergaenzend, nie allein) ------------------------------
# Discord-Webhook. Nuetzlich fuer den Alltag, nutzlos beim Serverausfall.
SWISSHUB_ALERT_DISCORD_WEBHOOK=

# Ab welchem Schweregrad alarmiert wird: info | warnung | kritisch
SWISSHUB_ALERT_MIN_SEVERITY=warnung

# === Restore-Tests =========================================================

# Port, auf dem die isolierte Testinstanz laeuft. Muss von jedem produktiven
# Port abweichen.
SWISSHUB_RESTORE_TEST_PORT=55432

# Verzeichnis fuer den Testlauf. Wird bei jedem Lauf geleert.
SWISSHUB_RESTORE_TEST_DIR=/var/lib/swisshub-backup/restore-test

# Wie viele Tage ein Restore-Test alt sein darf, bevor die Ueberwachung
# warnt.
SWISSHUB_RESTORE_TEST_MAX_AGE_DAYS=8
