#!/usr/bin/env bash
# SwissHub - Sicherung.
#
#   swisshub-backup <befehl>
#
# Befehle:
#   konfiguration-schreiben   pgbackrest.conf aus der .env erzeugen
#   einrichten                Stanza anlegen, Archivierung pruefen
#   db-voll                   Vollstaendiges physisches Basis-Backup
#   db-diff                   Differentielles Basis-Backup
#   db-inkrementell           Inkrementelles Basis-Backup
#   db-logisch                Zusaetzlicher logischer Export (pg_dump/pg_dumpall)
#   wal-pruefen               Laeuft die WAL-Archivierung? Wie weit hinterher?
#   dateien                   Uploads sichern (Restic)
#   konfiguration             Konfiguration und Quelltextstand sichern
#   geheimnisse               Wiederherstellungspaket erzeugen
#   release                   Commit, Abbild-Digests, Migrationsstand festhalten
#   extern                    Alles ins externe Repository uebertragen
#   aufraeumen                Aufbewahrung anwenden - nur mit geprueftem Ersatz
#   punkte                    Wiederherstellungspunkte neu erheben
#   stuendlich                Der stuendliche Durchgang
#   taeglich                  Der taegliche Durchgang
#   woechentlich              Der woechentliche Durchgang
#   status                    Zustand als JSON
#
# Laeuft als Benutzer `swisshub-backup`. Braucht KEIN root fuer die
# Datenbanksicherung - nur Lesezugriff auf das Datenverzeichnis bzw. den
# Docker-Socket.

set -uo pipefail

HIER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/gemeinsam.sh
source "${SWISSHUB_LIB_DIR:-$HIER/../lib}/gemeinsam.sh"

LOG_KONTEXT='backup'
lade_konfiguration || exit 1

BEFEHL="${1:-hilfe}"
shift || true

# Jeder Lauf bekommt eine Kennung. Sie steht im Protokoll, in der
# Verlaufsdatei und - falls es schiefgeht - im Alarm. Ohne sie ist eine
# Fehlermeldung eine Aussage ohne Bezug.
LAUF_ID="$(date +%Y%m%dT%H%M%S)-$$"
LAUF_START=$(date +%s)

protokoll_eroeffnen "$BEFEHL"

# --------------------------------------------------------------------------
# Verlauf
# --------------------------------------------------------------------------

# Was am Ende jedes Laufs festgehalten wird. Die Uebersicht im Dashboard liest
# genau diese Zeilen - deshalb stehen hier alle Felder, die sie zeigt.
lauf_abschliessen() {
  local art="$1" status="$2" meldung="$3" bytes="${4:-0}" ziel="${5:-lokal}"
  local dauer=$(( $(date +%s) - LAUF_START ))
  verlauf_anhaengen 'laeufe' "$(printf \
    '{"id":%s,"art":%s,"status":%s,"beginn":%s,"dauer_s":%s,"bytes":%s,"ziel":%s,"meldung":%s}' \
    "$(json_text "$LAUF_ID")" "$(json_text "$art")" "$(json_text "$status")" \
    "$(json_text "$(date -d "@$LAUF_START" --iso-8601=seconds)")" "$dauer" "${bytes:-0}" \
    "$(json_text "$ziel")" "$(json_text "$meldung")")"

  if [[ "$status" == 'erfolg' ]]; then
    zustand_schreiben "letzter-erfolg-$art" "$(printf '{"id":%s,"zeit":%s,"dauer_s":%s,"bytes":%s}' \
      "$(json_text "$LAUF_ID")" "$(json_text "$(date --iso-8601=seconds)")" "$dauer" "${bytes:-0}")"
  else
    zustand_schreiben "letzter-fehler-$art" "$(printf '{"id":%s,"zeit":%s,"meldung":%s}' \
      "$(json_text "$LAUF_ID")" "$(json_text "$(date --iso-8601=seconds)")" "$(json_text "$meldung")")"
  fi
}

# --------------------------------------------------------------------------
# konfiguration-schreiben
# --------------------------------------------------------------------------

befehl_konfiguration_schreiben() {
  local vorlagen="${SWISSHUB_VORLAGEN_DIR:-$HIER/../vorlagen}"
  local haupt="$vorlagen/pgbackrest.conf.vorlage"
  local s3="$vorlagen/pgbackrest-s3.vorlage"
  [[ -r "$haupt" ]] || { fehler "Vorlage fehlt: $haupt"; return 1; }

  if [[ -z "$SWISSHUB_PGBACKREST_CIPHER_PASS" ]]; then
    fehler 'SWISSHUB_PGBACKREST_CIPHER_PASS ist leer. Erzeugen mit: openssl rand -base64 48'
    return 1
  fi

  local s3_block=''
  if hat_externes_ziel; then
    s3_block=$(cat "$s3")
    # pgBackRest will den Endpunkt ohne Protokoll.
    local endpunkt_host="${SWISSHUB_S3_ENDPOINT#http://}"
    endpunkt_host="${endpunkt_host#https://}"
    endpunkt_host="${endpunkt_host%/}"

    # Pfad- oder Host-Stil.
    #
    # Backblaze B2 und Wasabi verlangen den Host-Stil, MinIO und manche
    # Selbstbetriebe den Pfad-Stil. Falsch geraten heisst: jeder Zugriff
    # scheitert mit einer Meldung ueber einen nicht gefundenen Bucket, und die
    # Ursache sucht man lange. Abgeleitet wird sie deshalb aus dem Endpunkt und
    # laesst sich ueberschreiben.
    local uri_stil="${SWISSHUB_S3_URI_STYLE:-}"
    if [[ -z "$uri_stil" ]]; then
      case "$endpunkt_host" in
        *backblazeb2.com|*wasabisys.com|*amazonaws.com) uri_stil='host' ;;
        *) uri_stil='path' ;;
      esac
    fi

    s3_block="${s3_block//@S3_BUCKET@/$SWISSHUB_S3_BUCKET}"
    s3_block="${s3_block//@S3_ENDPOINT_HOST@/$endpunkt_host}"
    s3_block="${s3_block//@S3_REGION@/${SWISSHUB_S3_REGION:-us-east-1}}"
    s3_block="${s3_block//@S3_WRITE_KEY_ID@/$SWISSHUB_S3_WRITE_KEY_ID}"
    s3_block="${s3_block//@S3_WRITE_SECRET@/$SWISSHUB_S3_WRITE_SECRET}"
    s3_block="${s3_block//@S3_URI_STYLE@/$uri_stil}"
    s3_block="${s3_block//@PGBACKREST_CIPHER_PASS@/$SWISSHUB_PGBACKREST_CIPHER_PASS}"
    # Extern doppelt so viele Vollbackups behalten wie lokal - spaet erkannte
    # Schaeden sollen dort noch erreichbar sein.
    s3_block="${s3_block//@RETENTION_FULL_EXTERN@/$(( SWISSHUB_RETENTION_FULL * 2 ))}"
  else
    s3_block='# Kein externes Repository konfiguriert - siehe SWISSHUB_S3_* in der .env.
# ACHTUNG: Ohne externe Kopie schuetzt diese Sicherung nicht gegen den Verlust
# des Servers. Das ist der haeufigste Ernstfall.'
  fi

  local inhalt
  inhalt=$(cat "$haupt")
  inhalt="${inhalt//@PGBACKREST_REPO@/$SWISSHUB_PGBACKREST_REPO}"
  inhalt="${inhalt//@PGBACKREST_CIPHER_PASS@/$SWISSHUB_PGBACKREST_CIPHER_PASS}"
  inhalt="${inhalt//@BACKUP_ROOT@/$SWISSHUB_BACKUP_ROOT}"
  inhalt="${inhalt//@RETENTION_FULL@/$SWISSHUB_RETENTION_FULL}"
  inhalt="${inhalt//@RETENTION_DIFF@/$SWISSHUB_RETENTION_DIFF}"
  inhalt="${inhalt//@PGBACKREST_PROCESSES@/$SWISSHUB_PGBACKREST_PROCESSES}"
  inhalt="${inhalt//@PG_DATA@/$SWISSHUB_PG_DATA}"
  inhalt="${inhalt//@PG_PORT@/$SWISSHUB_PG_PORT}"
  inhalt="${inhalt//@PG_USER@/$SWISSHUB_PG_USER}"
  # Zuletzt, weil der Block selbst Platzhalter enthielt.
  inhalt="${inhalt//@S3_BLOCK@/$s3_block}"

  local ziel="${PGBACKREST_CONF}"
  mkdir -p "$(dirname "$ziel")"
  # 0640, nie 0644: die Datei enthaelt das Repository-Passwort und die
  # S3-Zugangsdaten.
  ( umask 027; printf '%s\n' "$inhalt" > "$ziel" )

  # Und die Gruppe so, dass der Benutzer sie lesen kann, der pgBackRest
  # WIRKLICH ausfuehrt.
  #
  # Im Host-Betrieb ist das der PostgreSQL-Systembenutzer: nur er kommt an das
  # Datenverzeichnis, und ein physisches Backup kopiert Dateien. Bleibt die
  # Datei root:root, scheitert jeder Aufruf mit «Permission denied» - und diese
  # Meldung liest sich wie ein Problem des Repositories, nicht wie ein
  # Rechteproblem. Der Fehler kostet eine halbe Stunde Suche.
  local gruppe
  if [[ "$SWISSHUB_PG_MODE" == 'host' ]]; then
    gruppe=$(id -gn "${SWISSHUB_PG_SYSTEM_USER:-postgres}" 2>/dev/null)
  else
    gruppe="${SWISSHUB_SERVICE_GROUP:-swisshub-backup}"
  fi
  if [[ -n "$gruppe" ]] && chgrp "$gruppe" "$ziel" 2>/dev/null; then
    info "pgbackrest.conf geschrieben: $ziel (Gruppe $gruppe, 0640)"
  else
    warnung "pgbackrest.conf geschrieben: $ziel - die Gruppe «${gruppe:-?}» liess sich nicht setzen. pgBackRest kann die Datei dann moeglicherweise nicht lesen; der Fehler lautet «unable to open file ... Permission denied»."
  fi

  if [[ "$SWISSHUB_PG_MODE" == 'docker' ]]; then
    cat <<'HINWEIS'

  Bei SWISSHUB_PG_MODE=docker muss der Datenbankcontainer diese Datei sehen
  und pgBackRest enthalten. In docker-compose.prod.yml beim Dienst `postgres`:

      volumes:
        - swisshub-postgres:/var/lib/postgresql/data
        - /etc/swisshub-backup:/etc/swisshub-backup:ro
        - /var/lib/swisshub-backup:/var/lib/swisshub-backup

  und als Abbild ein postgres:16-alpine mit pgBackRest - siehe
  deploy/backup/vorlagen/Dockerfile.postgres.

  Ohne diese beiden Ergaenzungen findet pgBackRest im Container weder seine
  Konfiguration noch sein Repository, und `einrichten` scheitert mit einer
  Meldung ueber eine fehlende Stanza.
HINWEIS
  fi
  return 0
}

# --------------------------------------------------------------------------
# einrichten
# --------------------------------------------------------------------------

# Das Verzeichnisgeruest, und zwar mit Rechten, die beide Seiten benutzen
# koennen.
#
# Hier arbeiten zwei Benutzer im selben Baum:
#   - pgBackRest laeuft als der PostgreSQL-Systembenutzer, weil nur er an das
#     Datenverzeichnis kommt.
#   - Restic und die Orchestrierung laufen als Dienstbenutzer.
#
# Gehoert der Baum einem von beiden allein, scheitert der andere - und die
# Meldung lautet «Permission denied» beim Schreiben einer Protokolldatei, was
# nach einem Nebenschauplatz aussieht und den ganzen Lauf abbricht.
#
# Die Loesung ist eine gemeinsame Gruppe und das setgid-Bit: 2770 sorgt dafuer,
# dass jede neu angelegte Datei die Gruppe des Verzeichnisses erbt, statt die
# des Erzeugers. Ohne setgid liefe es beim ersten Lauf und beim zweiten nicht
# mehr.
geruest_anlegen() {
  local gruppe="$1"
  local verzeichnis
  for verzeichnis in \
      "$SWISSHUB_BACKUP_ROOT" \
      "$SWISSHUB_PGBACKREST_REPO" \
      "$SWISSHUB_BACKUP_ROOT/spool-wal" \
      "$SWISSHUB_BACKUP_ROOT/log" \
      "$SWISSHUB_BACKUP_ROOT/log/pgbackrest" \
      "$SWISSHUB_BACKUP_ROOT/state" \
      "$SWISSHUB_BACKUP_ROOT/spool" \
      "$SWISSHUB_BACKUP_ROOT/spool/eingang" \
      "$SWISSHUB_BACKUP_ROOT/spool/ergebnis" \
      "$SWISSHUB_BACKUP_ROOT/cache" \
      "$SWISSHUB_BACKUP_ROOT/lock" \
      "$SWISSHUB_BACKUP_ROOT/logisch" \
      "$SWISSHUB_BACKUP_ROOT/recovery"; do
    mkdir -p "$verzeichnis"
    if [[ -n "$gruppe" ]]; then
      chgrp "$gruppe" "$verzeichnis" 2>/dev/null || true
    fi
    # 2770: Eigentuemer und Gruppe duerfen alles, alle anderen nichts, und die
    # Gruppe wird vererbt. Hier liegen vollstaendige Kopien aller Personendaten.
    chmod 2770 "$verzeichnis" 2>/dev/null || chmod 770 "$verzeichnis" 2>/dev/null || true
  done
}

befehl_einrichten() {
  werkzeug_pruefen pgbackrest || return 1

  # Welche Gruppe beide Seiten teilen.
  local gruppe="${SWISSHUB_SERVICE_GROUP:-}"
  if [[ -z "$gruppe" ]] || ! getent group "$gruppe" >/dev/null 2>&1; then
    # Ohne eigene Dienstgruppe die des PostgreSQL-Benutzers - im Host-Betrieb
    # ist er derjenige, der pgBackRest ausfuehrt.
    gruppe=$(id -gn "${SWISSHUB_PG_SYSTEM_USER:-postgres}" 2>/dev/null)
  fi
  geruest_anlegen "$gruppe"
  info "Verzeichnisgeruest angelegt unter $SWISSHUB_BACKUP_ROOT (Gruppe ${gruppe:-unveraendert}, 2770)."

  # Das Repository und der Spool-Bereich gehoeren dem Benutzer, der pgBackRest
  # ausfuehrt. Die Gruppe allein genuegt nicht: pgBackRest legt dort
  # Unterverzeichnisse an und will sie besitzen.
  if [[ "$SWISSHUB_PG_MODE" == 'host' && "$(id -u)" -eq 0 ]]; then
    local pg_benutzer="${SWISSHUB_PG_SYSTEM_USER:-postgres}"
    chown -R "$pg_benutzer" "$SWISSHUB_PGBACKREST_REPO" "$SWISSHUB_BACKUP_ROOT/spool-wal" \
      "$SWISSHUB_BACKUP_ROOT/log/pgbackrest" 2>/dev/null || true
    info "Repository, Spool und Protokoll gehoeren $pg_benutzer."
  fi

  laufe 'Stanza anlegen' pgbackrest_lauf --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" stanza-create \
    || warnung 'stanza-create meldete einen Fehler - falls die Stanza schon existiert, ist das erwartet.'

  # `check` ist die einzige Pruefung, die wirklich beantwortet, ob die
  # Archivierung funktioniert: pgBackRest erzwingt einen WAL-Wechsel und
  # wartet, bis die Datei im Repository liegt. Alles andere - eine gesetzte
  # `archive_command`, ein gruener Dienst - ist nur eine Absicht.
  if laufe 'Archivierung pruefen' pgbackrest_lauf --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" check; then
    info 'Archivierung laeuft.'
    lauf_abschliessen 'einrichten' 'erfolg' 'Stanza und Archivierung in Ordnung'
    return 0
  fi

  fehler 'pgbackrest check ist gescheitert.'
  cat <<HINWEIS

  Damit die Archivierung laeuft, muss PostgreSQL sie aufrufen. In
  postgresql.conf:

      wal_level = replica
      archive_mode = on
      archive_command = 'pgbackrest --stanza=$PGBACKREST_STANZA --config=$PGBACKREST_CONF archive-push %p'
      archive_timeout = 300

  \`archive_timeout = 300\` ist die zweite Zeile, an der der RPO haengt: ohne sie
  wird ein WAL-Segment erst archiviert, wenn es voll ist (16 MB). Auf einem
  ruhigen Server kann das Stunden dauern - und so alt waere dann der jungste
  erreichbare Zeitpunkt. 300 Sekunden erzwingen den Wechsel spaetestens alle
  fuenf Minuten und sind damit die Obergrenze des erreichbaren RPO.

  \`wal_level\` und \`archive_mode\` brauchen einen Neustart, \`archive_command\`
  und \`archive_timeout\` nur ein Neuladen (SELECT pg_reload_conf()).

HINWEIS
  lauf_abschliessen 'einrichten' 'fehler' 'pgbackrest check gescheitert'
  return 1
}

# --------------------------------------------------------------------------
# Datenbank
# --------------------------------------------------------------------------

db_backup() {
  local typ="$1"
  werkzeug_pruefen pgbackrest || return 1
  platz_pruefen "$SWISSHUB_PGBACKREST_REPO" || { lauf_abschliessen "db-$typ" 'fehler' 'zu wenig Speicherplatz'; return 1; }

  # Der Zeitpunkt VOR dem Backup. Er ist die Untergrenze des
  # Wiederherstellungspunkts und wird gebraucht, um Datenbank und Dateien
  # aufeinander zu beziehen.
  local vorher
  vorher=$(date --iso-8601=seconds)

  if ! laufe "Basis-Backup ($typ)" pgbackrest_lauf \
      --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" \
      --type="$typ" backup; then
    alarm kritisch "db-backup-$typ" "Das $typ-Basis-Backup der Datenbank ist gescheitert. Ohne gueltiges Basis-Backup ist die WAL-Kette wertlos - es gibt dann keinen Zeitpunkt, den man ansteuern koennte."
    lauf_abschliessen "db-$typ" 'fehler' 'pgbackrest backup gescheitert'
    return 1
  fi

  alarm_entwarnung "db-backup-$typ" "$typ-Basis-Backup wieder erfolgreich"

  local groesse
  groesse=$(du -sb "$SWISSHUB_PGBACKREST_REPO" 2>/dev/null | cut -f1)
  info "Repository umfasst nun $(numfmt --to=iec "${groesse:-0}" 2>/dev/null || echo "${groesse:-0} B")."

  # Die Liste der Wiederherstellungspunkte neu erheben. Sie ist das, was das
  # Recovery Center anzeigt - und sie muss aus pgBackRest kommen und nicht aus
  # einer eigenen Buchhaltung, die auseinanderlaufen kann.
  wiederherstellungspunkte_erheben

  lauf_abschliessen "db-$typ" 'erfolg' "Basis-Backup ($typ) ab $vorher" "${groesse:-0}"
  return 0
}

# Zusaetzlicher logischer Export.
#
# Das physische Backup ist der Weg fuer die Wiederherstellung des Clusters und
# fuer PITR. Es hat aber eine harte Grenze: es laesst sich nur in dieselbe
# PostgreSQL-Hauptversion zurueckspielen. Ein Wechsel von 16 auf 17 braucht
# einen logischen Export - und wer ihn erst dann anlegt, wenn der alte Server
# schon weg ist, hat ihn nicht.
#
# `pg_dumpall --globals-only` ist der Teil, den fast alle vergessen: Rollen und
# ihre Rechte stehen im Cluster, nicht in der Datenbank. Ein Restore ohne sie
# ergibt eine Datenbank, in die sich die Anwendung nicht anmelden kann.
db_logisch() {
  local ziel="$SWISSHUB_BACKUP_ROOT/logisch"
  mkdir -p "$ziel"
  chmod 750 "$ziel"
  platz_pruefen "$ziel" || { lauf_abschliessen 'db-logisch' 'fehler' 'zu wenig Speicherplatz'; return 1; }

  local stempel
  stempel=$(date +%Y%m%dT%H%M%S)
  local dump="$ziel/swisshub-$stempel.dump"
  local globals="$ziel/globals-$stempel.sql"
  local ok=1

  umask 027
  if [[ "$SWISSHUB_PG_MODE" == 'docker' ]]; then
    docker exec -i "$SWISSHUB_PG_CONTAINER" pg_dump --format=custom --no-owner --no-acl \
      -U "$SWISSHUB_PG_USER" "$SWISSHUB_PG_DATABASE" > "$dump" 2>/dev/null || ok=0
    docker exec -i "$SWISSHUB_PG_CONTAINER" pg_dumpall --globals-only \
      -U "$SWISSHUB_PG_USER" > "$globals" 2>/dev/null || ok=0
  else
    pg_dump --format=custom --no-owner --no-acl -U "$SWISSHUB_PG_USER" -h 127.0.0.1 \
      -p "$SWISSHUB_PG_PORT" "$SWISSHUB_PG_DATABASE" > "$dump" 2>/dev/null || ok=0
    pg_dumpall --globals-only -U "$SWISSHUB_PG_USER" -h 127.0.0.1 -p "$SWISSHUB_PG_PORT" > "$globals" 2>/dev/null || ok=0
  fi

  if [[ "$ok" -eq 0 ]]; then
    rm -f -- "$dump" "$globals"
    alarm warnung 'db-logisch' 'Der logische Export ist gescheitert. Das physische Backup ist davon unberuehrt - fuer einen PostgreSQL-Versionswechsel fehlt aber die Grundlage.'
    lauf_abschliessen 'db-logisch' 'fehler' 'pg_dump gescheitert'
    return 1
  fi

  # Ein Dump gilt erst als Dump, wenn er lesbar ist. `pg_restore --list` liest
  # das Inhaltsverzeichnis - ein abgebrochener oder leerer Dump fliegt hier auf
  # und wird nicht als Erfolg verbucht.
  local pruefung=0
  if command -v pg_restore >/dev/null 2>&1; then
    pg_restore --list "$dump" >/dev/null 2>&1 || pruefung=1
  elif [[ "$SWISSHUB_PG_MODE" == 'docker' ]]; then
    docker exec -i "$SWISSHUB_PG_CONTAINER" pg_restore --list /dev/stdin < "$dump" >/dev/null 2>&1 || pruefung=1
  fi
  if [[ "$pruefung" -ne 0 ]]; then
    rm -f -- "$dump" "$globals"
    alarm kritisch 'db-logisch-unlesbar' 'Der erzeugte Dump war nicht lesbar und wurde verworfen. Ein unlesbarer Dump, der als Erfolg gilt, ist schlimmer als keiner.'
    lauf_abschliessen 'db-logisch' 'fehler' 'Dump nicht lesbar'
    return 1
  fi

  # Der Migrationsstand daneben. Ohne ihn weiss beim Einspielen niemand, zu
  # welchem Schema dieser Dump gehoert.
  pg_abfrage "SELECT migration_name FROM _prisma_migrations WHERE finished_at IS NOT NULL ORDER BY finished_at DESC LIMIT 1" \
    > "$ziel/migration-$stempel.txt" 2>/dev/null || true
  sha256sum "$dump" "$globals" > "$ziel/pruefsummen-$stempel.sha256"

  # Nur die letzten sieben behalten.
  #
  # Geloescht werden die Begleitdateien AUSDRUECKLICH beim Namen und nicht ueber
  # ein Muster: ein leerer Zeitstempel in einem `rm`-Muster loescht das ganze
  # Verzeichnis, und dieses Verzeichnis ist eine Sicherung.
  local alt stamp
  while IFS= read -r alt; do
    [[ -n "$alt" ]] || continue
    stamp="$(basename -- "$alt")"
    stamp="${stamp#swisshub-}"
    stamp="${stamp%.dump}"
    [[ -n "$stamp" ]] || continue
    rm -f -- "$alt" \
      "${ziel}/globals-${stamp}.sql" \
      "${ziel}/migration-${stamp}.txt" \
      "${ziel}/pruefsummen-${stamp}.sha256"
  done < <(find "$ziel" -maxdepth 1 -name 'swisshub-*.dump' -printf '%T@ %p\n' | sort -rn | tail -n +8 | cut -d' ' -f2-)

  local bytes
  bytes=$(stat -c %s "$dump")
  alarm_entwarnung 'db-logisch' 'logischer Export wieder erfolgreich'
  lauf_abschliessen 'db-logisch' 'erfolg' "Logischer Export $stempel, geprueft" "$bytes"
  return 0
}

# --------------------------------------------------------------------------
# WAL
# --------------------------------------------------------------------------

# Laeuft die Archivierung - und wie weit ist sie hinterher?
#
# Das ist die Kennzahl, aus der der tatsaechliche RPO folgt. Eine gesetzte
# `archive_command` sagt nichts: sie kann bei jedem Aufruf scheitern, und
# PostgreSQL laeuft dabei unbeirrt weiter. `pg_stat_archiver` weiss, wie viele
# Aufrufe gescheitert sind und wann zuletzt einer geklappt hat.
befehl_wal_pruefen() {
  local zeile
  zeile=$(pg_abfrage "SELECT archived_count||'|'||failed_count||'|'||COALESCE(last_archived_time::text,'')||'|'||COALESCE(last_archived_wal,'')||'|'||COALESCE(last_failed_time::text,'')||'|'||COALESCE(last_failed_wal,'') FROM pg_stat_archiver")
  if [[ -z "$zeile" ]]; then
    alarm kritisch 'wal-unbekannt' 'pg_stat_archiver war nicht abfragbar - der Zustand der WAL-Archivierung ist unbekannt. Solange das so ist, gibt es keine Zusage ueber den erreichbaren Zeitpunkt.'
    lauf_abschliessen 'wal' 'fehler' 'pg_stat_archiver nicht abfragbar'
    return 1
  fi

  IFS='|' read -r archiviert gescheitert letzte_zeit letzte_wal fehl_zeit fehl_wal <<< "$zeile"

  local modus level
  modus=$(pg_abfrage "SELECT current_setting('archive_mode')")
  level=$(pg_abfrage "SELECT current_setting('wal_level')")

  # Der Abstand in Sekunden. Er ist der gemessene RPO fuer die Datenbank -
  # nicht der gewuenschte.
  local abstand=-1
  if [[ -n "$letzte_zeit" ]]; then
    abstand=$(( $(date +%s) - $(date -d "$letzte_zeit" +%s 2>/dev/null || echo 0) ))
  fi

  zustand_schreiben 'wal' "$(printf \
    '{"zeit":%s,"archive_mode":%s,"wal_level":%s,"archiviert":%s,"gescheitert":%s,"letzte_wal":%s,"letzte_zeit":%s,"abstand_s":%s,"letzter_fehler_wal":%s,"letzter_fehler_zeit":%s}' \
    "$(json_text "$(date --iso-8601=seconds)")" "$(json_text "$modus")" "$(json_text "$level")" \
    "${archiviert:-0}" "${gescheitert:-0}" "$(json_text "$letzte_wal")" "$(json_text "$letzte_zeit")" \
    "$abstand" "$(json_text "$fehl_wal")" "$(json_text "$fehl_zeit")")"

  if [[ "$modus" != 'on' && "$modus" != 'always' ]]; then
    alarm kritisch 'wal-aus' "archive_mode steht auf «$modus». Es gibt keine WAL-Archivierung und damit keine Point-in-Time-Recovery - nur die Basis-Backups selbst."
    lauf_abschliessen 'wal' 'fehler' "archive_mode=$modus"
    return 1
  fi
  if [[ "$level" == 'minimal' ]]; then
    alarm kritisch 'wal-level' "wal_level steht auf «minimal». Damit schreibt PostgreSQL nicht genug in das WAL, um daraus wiederherzustellen."
    lauf_abschliessen 'wal' 'fehler' 'wal_level=minimal'
    return 1
  fi

  # Gescheiterte Aufrufe sind der eigentliche Alarm. Ein einziger ist ein
  # Aussetzer; ein wachsender Zaehler heisst, dass die Kette gerade reisst und
  # pg_wal volllaeuft.
  local frueher
  frueher=$(zustand_lesen 'wal-vorher' | python3 -c 'import json,sys; print(json.load(sys.stdin).get("gescheitert",0))' 2>/dev/null || echo 0)
  if [[ "${gescheitert:-0}" -gt "${frueher:-0}" ]]; then
    alarm kritisch 'wal-fehler' "Die WAL-Archivierung scheitert: ${gescheitert} gescheiterte Aufrufe (zuletzt ${fehl_wal:-?} um ${fehl_zeit:-?}). pg_wal laeuft voll, und ab jetzt entsteht eine Luecke in der Kette."
  else
    alarm_entwarnung 'wal-fehler' 'WAL-Archivierung laeuft wieder ohne Fehlschlag'
  fi
  zustand_schreiben 'wal-vorher' "$(printf '{"gescheitert":%s}' "${gescheitert:-0}")"

  # Ein Abstand ueber zehn Minuten heisst: der jungste erreichbare Zeitpunkt
  # ist aelter als der angestrebte RPO von fuenf Minuten.
  if [[ "$abstand" -gt 600 ]]; then
    alarm warnung 'wal-abstand' "Die jungste archivierte WAL-Datei ist ${abstand} Sekunden alt. Der erreichbare Wiederherstellungszeitpunkt liegt damit ueber dem angestrebten RPO. Pruefen: archive_timeout und die Uebertragung."
  elif [[ "$abstand" -ge 0 ]]; then
    alarm_entwarnung 'wal-abstand' "Abstand wieder bei ${abstand} Sekunden"
  fi

  info "WAL: mode=$modus level=$level archiviert=$archiviert gescheitert=$gescheitert abstand=${abstand}s"
  lauf_abschliessen 'wal' 'erfolg' "Abstand ${abstand}s, ${gescheitert} Fehlschlaege"
  return 0
}

# --------------------------------------------------------------------------
# Dateien
# --------------------------------------------------------------------------

restic_repo_bereit() {
  restic_umgebung
  if [[ -z "$SWISSHUB_RESTIC_PASSWORD" ]]; then
    fehler 'SWISSHUB_RESTIC_PASSWORD ist leer. Erzeugen mit: openssl rand -base64 48'
    return 1
  fi
  if ! restic_lokal cat config >/dev/null 2>&1; then
    info 'Restic-Repository wird angelegt.'
    mkdir -p "$SWISSHUB_RESTIC_REPO"
    restic_lokal init >/dev/null 2>&1 || { fehler 'restic init gescheitert.'; return 1; }
  fi
  return 0
}

# Pfade aus einer doppelpunktgetrennten Liste, nur die vorhandenen.
pfade_aus_liste() {
  local liste="$1"
  local pfad
  [[ -n "$liste" ]] || return 0
  while IFS= read -r -d: pfad || [[ -n "$pfad" ]]; do
    [[ -n "$pfad" && -e "$pfad" ]] && printf '%s\n' "$pfad"
  done <<< "${liste}:"
}

befehl_dateien() {
  werkzeug_pruefen restic || return 1
  restic_repo_bereit || { lauf_abschliessen 'dateien' 'fehler' 'Repository nicht bereit'; return 1; }
  platz_pruefen "$SWISSHUB_RESTIC_REPO" || { lauf_abschliessen 'dateien' 'fehler' 'zu wenig Speicherplatz'; return 1; }

  local pfade=()
  [[ -n "$SWISSHUB_UPLOAD_DIR" && -d "$SWISSHUB_UPLOAD_DIR" ]] && pfade+=("$SWISSHUB_UPLOAD_DIR")
  local zusatz
  while IFS= read -r zusatz; do
    [[ -n "$zusatz" ]] && pfade+=("$zusatz")
  done < <(pfade_aus_liste "$SWISSHUB_EXTRA_PATHS")

  if [[ ${#pfade[@]} -eq 0 ]]; then
    alarm kritisch 'dateien-kein-pfad' "Es wurde kein Upload-Verzeichnis gefunden (SWISSHUB_UPLOAD_DIR=«$SWISSHUB_UPLOAD_DIR»). Die Dateien sind damit ungesichert, und die Datenbank verweist auf sie."
    lauf_abschliessen 'dateien' 'fehler' 'kein Pfad vorhanden'
    return 1
  fi

  # Der Datenbankzeitpunkt VOR der Dateisicherung.
  #
  # Er ist der Schluessel dafuer, Dateien und Datenbank aufeinander zu
  # beziehen. Die Uploads dieser Anwendung werden unter serverseitig
  # erzeugten Namen genau einmal geschrieben und danach nie geaendert. Daraus
  # folgt eine Regel, die ein Einfrieren unnoetig macht:
  #
  #   Eine Dateisicherung, die NICHT AELTER ist als der Zielzeitpunkt der
  #   Datenbank, enthaelt jede Datei, auf die diese Datenbank verweist.
  #
  # Umgekehrt waere es falsch: eine aeltere Dateisicherung kann Verweise ins
  # Leere hinterlassen. Ueberzaehlige Dateien dagegen sind harmlos - sie sind
  # Waisen, die nichts kaputt machen.
  #
  # Deshalb wird der Zeitpunkt festgehalten und beim Restore geprueft, statt
  # die Uploads anzuhalten. Ein Einfrieren waere hier eine Ausfallzeit fuer
  # eine Konsistenz, die die Schreibweise der Anwendung schon herstellt.
  local db_zeitpunkt
  db_zeitpunkt=$(pg_abfrage "SELECT now()" | tr -d ' ' || true)

  local marke="$SWISSHUB_BACKUP_ROOT/dateien-bezug.json"
  ( umask 027; printf '{"db_zeitpunkt":%s,"erhoben":%s}\n' \
    "$(json_text "${db_zeitpunkt:-unbekannt}")" "$(json_text "$(date --iso-8601=seconds)")" > "$marke" )

  info "Sichere: ${pfade[*]}"
  local ausgabe status
  ausgabe=$(restic_lokal backup --tag uploads --tag "db:${db_zeitpunkt:-unbekannt}" \
    --host "$(hostname -s)" --json "${pfade[@]}" "$marke" 2>&1)
  status=$?

  if [[ $status -ne 0 ]]; then
    printf '%s\n' "$ausgabe" | verdecke | tail -20 | while IFS= read -r z; do protokoll AUSGABE "$z"; done
    alarm kritisch 'dateien' 'Die Dateisicherung ist gescheitert. Uploads und Datenbank laufen damit auseinander - die Verweise in der Datenbank zeigen auf Dateien, die in keiner Sicherung stehen.'
    lauf_abschliessen 'dateien' 'fehler' 'restic backup gescheitert'
    return 1
  fi

  # Aus der JSON-Ausgabe die Kennzahlen ziehen - restic gibt eine
  # `summary`-Zeile am Ende.
  local zusammenfassung
  zusammenfassung=$(printf '%s\n' "$ausgabe" | python3 -c '
import json, sys
zusammen = {}
for zeile in sys.stdin:
    try:
        eintrag = json.loads(zeile)
    except ValueError:
        continue
    if eintrag.get("message_type") == "summary":
        zusammen = eintrag
print(json.dumps({
    # Auf acht Zeichen gekuerzt - genauso adressiert restic selbst, und eine
    # 64-stellige Kennung in der Uebersicht ist unlesbar.
    "snapshot": (zusammen.get("snapshot_id") or "")[:8],
    "neu": zusammen.get("files_new", 0),
    "geaendert": zusammen.get("files_changed", 0),
    "unveraendert": zusammen.get("files_unmodified", 0),
    "bytes_neu": zusammen.get("data_added", 0),
    "bytes_gesamt": zusammen.get("total_bytes_processed", 0),
}))' 2>/dev/null || printf '{}')

  local bytes snapshot
  bytes=$(printf '%s' "$zusammenfassung" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("bytes_gesamt",0))' 2>/dev/null || echo 0)
  snapshot=$(printf '%s' "$zusammenfassung" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("snapshot",""))' 2>/dev/null || echo '')

  zustand_schreiben 'dateien' "$(printf '{"zeit":%s,"db_zeitpunkt":%s,"snapshot":%s,"kennzahlen":%s}' \
    "$(json_text "$(date --iso-8601=seconds)")" "$(json_text "${db_zeitpunkt:-unbekannt}")" \
    "$(json_text "$snapshot")" "$zusammenfassung")"

  alarm_entwarnung 'dateien' 'Dateisicherung wieder erfolgreich'
  info "Dateisicherung fertig: Snapshot ${snapshot:-?}, $(numfmt --to=iec "${bytes:-0}" 2>/dev/null || echo "$bytes B")."
  lauf_abschliessen 'dateien' 'erfolg' "Snapshot ${snapshot:-?} zum DB-Zeitpunkt ${db_zeitpunkt:-unbekannt}" "${bytes:-0}"
  return 0
}

# --------------------------------------------------------------------------
# Konfiguration und Releasestand
# --------------------------------------------------------------------------

# Der Releasestand als JSON. Auch einzeln aufrufbar - die Pipeline benutzt das.
befehl_release() {
  local commit branch schmutzig migration

  # `-c safe.directory=*`: das Projektverzeichnis gehoert dem Dienstbenutzer
  # der Anwendung, dieses Skript laeuft aber als Backup-Benutzer. Ohne diese
  # Angabe verweigert git seit 2.35.2 jede Auskunft mit «dubious ownership» -
  # und der Releasestand waere dauerhaft «unbekannt», ohne dass jemand einen
  # Fehler saehe.
  if [[ -d "$SWISSHUB_PROJECT_DIR/.git" ]]; then
    commit=$(git -c safe.directory='*' -C "$SWISSHUB_PROJECT_DIR" rev-parse HEAD 2>/dev/null)
    branch=$(git -c safe.directory='*' -C "$SWISSHUB_PROJECT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null)
    schmutzig=$(git -c safe.directory='*' -C "$SWISSHUB_PROJECT_DIR" status --porcelain 2>/dev/null | wc -l)
  fi
  migration=$(trimmen "$(pg_abfrage "SELECT migration_name FROM _prisma_migrations WHERE finished_at IS NOT NULL ORDER BY finished_at DESC, migration_name DESC LIMIT 1")")

  # Die Digests der laufenden Abbilder.
  #
  # Ein `image: swisshub-web:latest` sagt nach einem halben Jahr nichts mehr -
  # `latest` ist dann ein anderes Abbild. Der Digest ist die Kennung, die
  # tatsaechlich lief.
  #
  # Erst pruefen, ob Docker ueberhaupt antwortet, und dann erst die Pipeline:
  # mit `pipefail` faerbt ein gescheitertes `docker ps` die ganze Pipeline
  # rot, der Rueckfall `|| printf {}` feuert zusaetzlich zur Ausgabe von
  # Python, und im JSON standen zwei Objekte hintereinander - womit die ganze
  # Datei unlesbar war.
  local abbilder='{}'
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    local ps_ausgabe
    ps_ausgabe=$(docker ps --format '{{.Names}}|{{.Image}}|{{.ID}}' 2>/dev/null)
    if [[ -n "$ps_ausgabe" ]]; then
      abbilder=$(printf '%s\n' "$ps_ausgabe" | python3 "${SWISSHUB_LIB_DIR:-$HIER/../lib}/abbilder.py" 2>/dev/null)
      [[ -n "$abbilder" ]] || abbilder='{}'
    fi
  fi

  printf '{"erhoben":%s,"commit":%s,"branch":%s,"nicht_committet":%s,"migration":%s,"abbilder":%s,"postgres":%s}\n' \
    "$(json_text "$(date --iso-8601=seconds)")" "$(json_text "${commit:-unbekannt}")" \
    "$(json_text "${branch:-unbekannt}")" "${schmutzig:-0}" "$(json_text "${migration:-unbekannt}")" \
    "$abbilder" "$(json_text "$(trimmen "$(pg_abfrage 'SHOW server_version')")")"
}

# Was ein neuer Server braucht und was in keinem Repository steht.
#
# Die .env ist hier BEWUSST NICHT dabei. Sie enthaelt den
# MASTER_ENCRYPTION_KEY, und der gehoert ausschliesslich in das
# Wiederherstellungspaket - verschluesselt auf einen Schluessel, den dieser
# Server nicht besitzt. Stuende sie hier, laege sie in einem Repository, dessen
# Passwort auf demselben Server liegt: wer den Server hat, haette beides.
befehl_konfiguration() {
  werkzeug_pruefen restic || return 1
  restic_repo_bereit || { lauf_abschliessen 'konfiguration' 'fehler' 'Repository nicht bereit'; return 1; }

  # Ein FESTER Pfad, kein mktemp.
  #
  # Restic erkennt Wiederholungen am Pfad. Ein bei jedem Lauf anderer
  # Verzeichnisname macht aus derselben Konfiguration jedes Mal einen neuen
  # Baum: die Deduplizierung greift nicht mehr, und in `restic snapshots`
  # steht bei jedem Lauf ein anderer Pfad - womit sich zwei Staende nicht
  # mehr vergleichen lassen.
  local sammel="$SWISSHUB_BACKUP_ROOT/konfigurationsstand"
  rm -rf -- "${sammel:?}"
  mkdir -p "$sammel"
  chmod 700 "$sammel"

  befehl_release > "$sammel/release.json"

  # Compose-Dateien und Deploy-Verzeichnis aus dem Projekt.
  if [[ -d "$SWISSHUB_PROJECT_DIR" ]]; then
    mkdir -p "$sammel/projekt"
    local datei
    for datei in docker-compose.prod.yml docker-compose.yml Dockerfile package.json package-lock.json; do
      [[ -f "$SWISSHUB_PROJECT_DIR/$datei" ]] && cp -a "$SWISSHUB_PROJECT_DIR/$datei" "$sammel/projekt/"
    done
    [[ -d "$SWISSHUB_PROJECT_DIR/deploy" ]] && cp -a "$SWISSHUB_PROJECT_DIR/deploy" "$sammel/projekt/"

    # Die Namen der in der .env gesetzten Variablen - ohne Werte.
    #
    # Damit laesst sich nach einem Restore pruefen, ob die neue .env
    # vollstaendig ist, ohne dass hier ein einziger Wert liegt.
    if [[ -r "$SWISSHUB_PROJECT_DIR/.env" ]]; then
      grep -oE '^[A-Z_][A-Z0-9_]*' "$SWISSHUB_PROJECT_DIR/.env" | sort -u > "$sammel/env-variablennamen.txt"
    fi
  fi

  # Hostkonfiguration.
  local pfad ziel
  if [[ -n "$SWISSHUB_CONFIG_PATHS" ]]; then
    mkdir -p "$sammel/host"
    while IFS= read -r pfad; do
      [[ -n "$pfad" ]] || continue
      ziel="$sammel/host/$(printf '%s' "${pfad#/}" | tr '/' '_')"
      # `-L` folgt Symlinks: /etc/nginx/sites-enabled sind Verweise, und der
      # Inhalt ist das, was gebraucht wird.
      cp -aL "$pfad" "$ziel" 2>/dev/null || cp -a "$pfad" "$ziel" 2>/dev/null || true
    done < <(pfade_aus_liste "$SWISSHUB_CONFIG_PATHS")

    # Die eigene Konfiguration enthaelt die eigenen Geheimnisse - hier gehoert
    # nur die Struktur hin, nicht der Inhalt.
    rm -f -- "$sammel/host/etc_swisshub-backup/swisshub-backup.env" \
             "$sammel/host/etc_swisshub-backup/pgbackrest.conf" 2>/dev/null || true
    # Private Schluessel der Zertifikate ebenso: sie sind neu ausstellbar, und
    # ein privater TLS-Schluessel in einem Backup ist ein Risiko ohne Gewinn.
    find "$sammel/host" -name 'privkey*.pem' -delete 2>/dev/null || true
  fi

  # Die Systemumgebung, damit ein neuer Server nachgebaut werden kann.
  {
    printf '# Systemstand %s\n' "$(date --iso-8601=seconds)"
    printf 'host=%s\n' "$(hostname -f 2>/dev/null || hostname)"
    ( . /etc/os-release 2>/dev/null && printf 'os=%s\n' "${PRETTY_NAME:-?}" )
    printf 'kernel=%s\n' "$(uname -r)"
    printf 'docker=%s\n' "$(docker --version 2>/dev/null || echo 'nicht vorhanden')"
    printf 'compose=%s\n' "$(docker compose version --short 2>/dev/null || echo '-')"
    printf 'postgres=%s\n' "$(pg_abfrage 'SELECT version()' | head -1)"
    printf 'pgbackrest=%s\n' "$(pgbackrest version 2>/dev/null || echo '-')"
    printf 'restic=%s\n' "$(restic version 2>/dev/null | head -1)"
    printf 'node=%s\n' "$(node --version 2>/dev/null || echo '-')"
  } > "$sammel/systemstand.txt"

  info "Sichere Konfiguration und Systemstand ($(du -sh "$sammel" 2>/dev/null | cut -f1))."
  local status=0
  restic_lokal backup --tag konfiguration --host "$(hostname -s)" "$sammel" >/dev/null 2>&1 || status=1
  # Das Sammelverzeichnis enthaelt Konfiguration - es wird in jedem Fall
  # aufgeraeumt, auch wenn die Sicherung scheiterte.
  rm -rf -- "${sammel:?}"

  if [[ "$status" -ne 0 ]]; then
    alarm warnung 'konfiguration' 'Die Konfigurationssicherung ist gescheitert. Datenbank und Dateien sind davon unberuehrt; einem neuen Server fehlen aber nginx, Zertifikatsstand und der Releasestand.'
    lauf_abschliessen 'konfiguration' 'fehler' 'restic backup gescheitert'
    return 1
  fi

  alarm_entwarnung 'konfiguration' 'Konfigurationssicherung wieder erfolgreich'
  lauf_abschliessen 'konfiguration' 'erfolg' 'Konfiguration und Systemstand gesichert'
  return 0
}

befehl_geheimnisse() {
  "${SWISSHUB_BIN_DIR:-$HIER}/swisshub-secrets-seal"
}

# --------------------------------------------------------------------------
# Extern
# --------------------------------------------------------------------------

befehl_extern() {
  if ! hat_externes_ziel; then
    alarm warnung 'kein-offsite' 'Es ist kein externes Backup-Ziel konfiguriert. Alle Sicherungen liegen auf demselben Server, der gesichert wird - gegen dessen Verlust schuetzt das nicht, und das ist der haeufigste Ernstfall. Siehe SWISSHUB_S3_* in /etc/swisshub-backup/swisshub-backup.env.'
    lauf_abschliessen 'extern' 'uebersprungen' 'kein externes Ziel konfiguriert'
    return 0
  fi

  local ok=1

  # pgBackRest uebertraegt selbst, weil repo2 in seiner Konfiguration steht -
  # jedes Backup und jedes WAL-Segment geht in beide Repositories. Hier wird
  # deshalb nur geprueft, dass repo2 erreichbar und vollstaendig ist.
  if ! laufe 'Externes pgBackRest-Repository pruefen' pgbackrest_lauf \
      --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" --repo=2 info; then
    ok=0
    alarm kritisch 'extern-pgbackrest' 'Das externe pgBackRest-Repository war nicht erreichbar. Datenbanksicherungen liegen damit nur lokal.'
  fi

  # Restic muss aktiv kopieren. `copy` uebertraegt Snapshots zwischen
  # Repositories, ohne die Daten neu zu lesen.
  restic_umgebung
  export AWS_ACCESS_KEY_ID="$SWISSHUB_S3_WRITE_KEY_ID"
  export AWS_SECRET_ACCESS_KEY="$SWISSHUB_S3_WRITE_SECRET"
  [[ -n "$SWISSHUB_S3_REGION" ]] && export AWS_DEFAULT_REGION="$SWISSHUB_S3_REGION"
  local extern_repo="s3:${SWISSHUB_S3_ENDPOINT%/}/${SWISSHUB_S3_BUCKET}/restic"

  if ! restic --repo "$extern_repo" cat config >/dev/null 2>&1; then
    info 'Externes Restic-Repository wird angelegt.'
    # `--copy-chunker-params`: ohne sie zerlegt das Zielrepository die Daten
    # anders als das Quellrepository, und `copy` uebertraegt dann bei jedem
    # Lauf alles neu statt nur das Neue.
    RESTIC_FROM_PASSWORD="$SWISSHUB_RESTIC_PASSWORD" \
      restic --repo "$extern_repo" init --copy-chunker-params --from-repo "$SWISSHUB_RESTIC_REPO" >/dev/null 2>&1 \
      || { fehler 'Externes Restic-Repository konnte nicht angelegt werden.'; ok=0; }
  fi

  if [[ "$ok" -eq 1 ]]; then
    local grenze=()
    [[ "$SWISSHUB_UPLOAD_LIMIT_KIB" -gt 0 ]] && grenze=(--limit-upload "$SWISSHUB_UPLOAD_LIMIT_KIB")
    if ! RESTIC_FROM_PASSWORD="$SWISSHUB_RESTIC_PASSWORD" \
        restic --repo "$extern_repo" "${grenze[@]}" copy --from-repo "$SWISSHUB_RESTIC_REPO" >/dev/null 2>&1; then
      ok=0
      alarm kritisch 'extern-restic' 'Die Uebertragung der Dateisicherung nach aussen ist gescheitert. Uploads und Konfiguration liegen damit nur lokal.'
    fi
  fi

  if [[ "$ok" -eq 1 ]]; then
    alarm_entwarnung 'extern-pgbackrest' 'externes Repository wieder erreichbar'
    alarm_entwarnung 'extern-restic' 'externe Uebertragung wieder erfolgreich'
    zustand_schreiben 'extern' "$(printf '{"zeit":%s,"ziel":%s,"status":"erfolg"}' \
      "$(json_text "$(date --iso-8601=seconds)")" "$(json_text "${SWISSHUB_S3_ENDPOINT}/${SWISSHUB_S3_BUCKET}")")"
    lauf_abschliessen 'extern' 'erfolg' 'Externe Kopie aktuell' 0 'extern'
    return 0
  fi

  zustand_schreiben 'extern' "$(printf '{"zeit":%s,"ziel":%s,"status":"fehler"}' \
    "$(json_text "$(date --iso-8601=seconds)")" "$(json_text "${SWISSHUB_S3_ENDPOINT}/${SWISSHUB_S3_BUCKET}")")"
  lauf_abschliessen 'extern' 'fehler' 'Externe Uebertragung gescheitert' 0 'extern'
  return 1
}

# --------------------------------------------------------------------------
# Aufraeumen
# --------------------------------------------------------------------------

# Aufbewahrung anwenden - aber nur mit geprueftem Ersatz.
#
# Das ist die Stelle, an der ein Backup-System sich selbst zerstoeren kann:
# eine Aufbewahrungsregel, die stur nach Alter loescht, raeumt nach einer Reihe
# stiller Fehlschlaege die letzte brauchbare Kette weg. Danach gibt es kein
# Backup mehr, und niemand hat etwas gemerkt.
#
# Deshalb drei Bedingungen, alle drei notwendig:
#   1. Es gibt mehr als einen Wiederherstellungspunkt.
#   2. Die Integritaet des Repositories ist geprueft.
#   3. Geloescht wird nur von hier - im externen Repository niemals.
befehl_aufraeumen() {
  local ok=1

  # --- pgBackRest ---------------------------------------------------------
  local anzahl_voll
  anzahl_voll=$(pgbackrest_lauf --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" --output=json info 2>/dev/null \
    | python3 -c '
import json, sys
try:
    daten = json.load(sys.stdin)
except Exception:
    print(0)
    raise SystemExit
print(sum(
    1
    for stanza in daten
    for sicherung in stanza.get("backup", [])
    if sicherung.get("type") == "full"
))' 2>/dev/null || echo 0)

  if [[ "${anzahl_voll:-0}" -lt 2 ]]; then
    warnung "Es gibt nur ${anzahl_voll:-0} Vollbackup(s). Es wird nichts geloescht - ein einziges Backup ist keine Reserve."
  else
    # `expire` ist der einzige Weg, auf dem pgBackRest loescht. Es rechnet die
    # WAL-Aufbewahrung selbst aus (repo-retention-archive-type=full) und
    # zerreisst die Kette damit nicht.
    laufe 'Aufbewahrung pgBackRest' pgbackrest_lauf \
      --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" expire \
      || { ok=0; warnung 'pgbackrest expire ist gescheitert - alte Sicherungen bleiben liegen. Das ist der harmlose Fehler.'; }
  fi

  # --- Restic -------------------------------------------------------------
  restic_umgebung
  if restic_lokal snapshots --json >/dev/null 2>&1; then
    local anzahl_snapshots
    anzahl_snapshots=$(restic_lokal snapshots --json 2>/dev/null | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo 0)

    if [[ "${anzahl_snapshots:-0}" -lt 2 ]]; then
      warnung "Nur ${anzahl_snapshots:-0} Snapshot(s) vorhanden - es wird nichts geloescht."
    elif ! restic_lokal check --no-lock >/dev/null 2>&1; then
      # Bedingung 2: ohne geprueftes Repository wird nicht geloescht. Ein
      # beschaedigtes Repository aufzuraeumen heisst, die brauchbaren Reste
      # ebenfalls zu verlieren.
      ok=0
      alarm kritisch 'aufraeumen-integritaet' 'Die Integritaetspruefung des Restic-Repositories ist gescheitert. Es wird NICHTS geloescht - in einem beschaedigten Repository aufzuraeumen zerstoert auch die brauchbaren Reste.'
    else
      laufe 'Aufbewahrung Restic' restic_lokal forget --prune \
        --keep-hourly "$SWISSHUB_RETENTION_HOURLY" \
        --keep-daily "$SWISSHUB_RETENTION_DAILY" \
        --keep-weekly "$SWISSHUB_RETENTION_WEEKLY" \
        --keep-monthly "$SWISSHUB_RETENTION_MONTHLY" \
        --keep-last 3 \
        || { ok=0; warnung 'restic forget ist gescheitert - alte Snapshots bleiben liegen.'; }
    fi
  fi

  # --- Extern: NICHT loeschen ---------------------------------------------
  #
  # Im externen Repository wird von diesem Server aus grundsaetzlich nicht
  # geloescht, und die dortigen Zugangsdaten duerfen es auch nicht. Die
  # Aufbewahrung regelt die Lifecycle-Regel des Buckets - also die Gegenseite.
  #
  # Das ist der Kern des Ransomware-Schutzes: wer diesen Server uebernimmt, hat
  # keinen Weg, die externe Historie zu vernichten.
  info 'Externes Repository: kein Loeschen von hier aus (Object Lock und Lifecycle-Regel des Buckets).'

  wiederherstellungspunkte_erheben

  if [[ "$ok" -eq 1 ]]; then
    lauf_abschliessen 'aufraeumen' 'erfolg' 'Aufbewahrung angewandt'
    return 0
  fi
  lauf_abschliessen 'aufraeumen' 'fehler' 'Aufbewahrung teilweise gescheitert'
  return 1
}

# --------------------------------------------------------------------------
# Wiederherstellungspunkte
# --------------------------------------------------------------------------

# Die Liste, die das Recovery Center anzeigt.
#
# Sie kommt aus pgBackRest und Restic selbst, nicht aus einer eigenen
# Buchhaltung. Eine zweite Liste liefe irgendwann auseinander - und dann zeigte
# das Dashboard einen Wiederherstellungspunkt an, den es nicht gibt.
wiederherstellungspunkte_erheben() {
  local pg_json restic_json
  pg_json=$(pgbackrest_lauf --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" --output=json info 2>/dev/null || printf '[]')
  restic_umgebung
  restic_json=$(restic_lokal snapshots --json 2>/dev/null || printf '[]')

  local ergebnis
  # Zusammengestellt wird in lib/punkte.py.
  #
  # Als eigene Datei und nicht als eingebettetes Here-Dokument: eine
  # schliessende Klammer am Zeilenanfang im Python-Code kann den
  # bash-Parser einer Befehlssubstitution aus dem Tritt bringen, und dann
  # faellt die Erhebung still aus - die Uebersicht zeigte eine leere Liste
  # und meldete trotzdem Erfolg. Als Datei ist sie ausserdem pruefbar.
  local ergebnis
  ergebnis=$(SWISSHUB_PG_JSON="$pg_json" SWISSHUB_RESTIC_JSON="$restic_json" \
    python3 "${SWISSHUB_LIB_DIR:-$HIER/../lib}/punkte.py" 2>/dev/null)
  [[ -n "$ergebnis" ]] || ergebnis='{"anzahl":0,"punkte":[],"fehler":"Die Erhebung der Wiederherstellungspunkte liess sich nicht ausfuehren."}'
  zustand_schreiben 'wiederherstellungspunkte' "$ergebnis"
}

# --------------------------------------------------------------------------
# Durchgaenge
# --------------------------------------------------------------------------

befehl_stuendlich() {
  sperre_oder_raus 'backup' 60 || return 0
  local status=0
  befehl_wal_pruefen || status=1
  befehl_dateien || status=1
  db_backup incr || status=1
  befehl_extern || status=1
  herzschlag "$status"
  return $status
}

befehl_taeglich() {
  sperre_oder_raus 'backup' 300 || return 0
  local status=0
  befehl_wal_pruefen || status=1
  db_backup diff || status=1
  db_logisch || status=1
  befehl_dateien || status=1
  befehl_konfiguration || status=1
  befehl_geheimnisse || status=1
  befehl_extern || status=1
  befehl_aufraeumen || status=1
  herzschlag "$status"
  return $status
}

befehl_woechentlich() {
  sperre_oder_raus 'backup' 900 || return 0
  local status=0
  db_backup full || status=1
  befehl_dateien || status=1
  befehl_konfiguration || status=1
  befehl_geheimnisse || status=1
  befehl_extern || status=1
  befehl_aufraeumen || status=1
  herzschlag "$status"
  return $status
}

# --------------------------------------------------------------------------
# status
# --------------------------------------------------------------------------

befehl_status() {
  wiederherstellungspunkte_erheben
  python3 "${SWISSHUB_LIB_DIR:-$HIER/../lib}/status.py" "$ZUSTAND_DIR"
}

# --------------------------------------------------------------------------

case "$BEFEHL" in
  konfiguration-schreiben) befehl_konfiguration_schreiben ;;
  einrichten) befehl_einrichten ;;
  db-voll) sperre_oder_raus 'backup' 60 && db_backup full ;;
  db-diff) sperre_oder_raus 'backup' 60 && db_backup diff ;;
  db-inkrementell) sperre_oder_raus 'backup' 60 && db_backup incr ;;
  db-logisch) sperre_oder_raus 'backup' 60 && db_logisch ;;
  wal-pruefen) befehl_wal_pruefen ;;
  dateien) sperre_oder_raus 'backup' 60 && befehl_dateien ;;
  konfiguration) sperre_oder_raus 'backup' 60 && befehl_konfiguration ;;
  geheimnisse) befehl_geheimnisse ;;
  release) befehl_release ;;
  extern) befehl_extern ;;
  aufraeumen) sperre_oder_raus 'backup' 60 && befehl_aufraeumen ;;
  punkte) wiederherstellungspunkte_erheben && zustand_lesen 'wiederherstellungspunkte' ;;
  stuendlich) befehl_stuendlich ;;
  taeglich) befehl_taeglich ;;
  woechentlich) befehl_woechentlich ;;
  status) befehl_status ;;
  hilfe|--help|-h) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) fehler "Unbekannter Befehl: $BEFEHL"; sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 64 ;;
esac
