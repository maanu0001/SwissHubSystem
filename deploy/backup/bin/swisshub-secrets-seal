#!/usr/bin/env bash
# SwissHub - Wiederherstellungspaket erzeugen.
#
#   swisshub-secrets-seal              Paket erzeugen und ablegen
#   swisshub-secrets-seal pruefen <schluesseldatei>
#                                      Paket oeffnen und den Inhalt pruefen.
#                                      NUR auf einem Rechner ausfuehren, auf
#                                      dem der private Schluessel liegen darf -
#                                      also NICHT auf dem produktiven Server.
#
# ==========================================================================
# WARUM DIESES WERKZEUG DAS WICHTIGSTE IM GANZEN BACKUP-SYSTEM IST
# ==========================================================================
#
# SwissHub verschluesselt Bot-Token, OAuth-Secrets und AI-Schluessel mit
# AES-256-GCM in der Datenbank. Der Hauptschluessel dafuer steht in der .env
# auf dem produktiven Server - und NUR dort.
#
# Der Fehler, gegen den dieses Werkzeug gebaut ist, sieht so aus:
#
#     Der Server geht verloren.
#     Die Datenbanksicherung ist vollstaendig und liest sich einwandfrei.
#     Die verschluesselten Zugangsdaten stehen darin.
#     Sie sind dauerhaft unlesbar, weil der Schluessel mit dem Server weg ist.
#
# Die Sicherung waere technisch fehlerfrei und trotzdem unbrauchbar.
#
# Die Loesung darf nicht sein, den Schluessel einfach mitzusichern: dann liegt
# er im selben Archiv wie die mit ihm verschluesselten Daten, und wer das
# Archiv hat, hat beides. Genau das verlangt die Vorgabe zu vermeiden - ein
# Backup darf nicht von einem Schluessel abhaengen, der in ihm selbst liegt.
#
# DIE LOESUNG IST ASYMMETRISCHE VERSCHLUESSELUNG.
#
# Das Paket wird mit `age` auf einen oeffentlichen Empfaengerschluessel
# verschluesselt. Der private Schluessel liegt NICHT auf diesem Server -
# sondern im Passwortmanager und auf einem Medium im Safe.
#
# Daraus folgt die Eigenschaft, um die es geht:
#
#     Dieser Server kann das Paket SCHREIBEN und danach SELBST NICHT LESEN.
#
# Wer den Server uebernimmt, bekommt die Pakete - und kann mit ihnen nichts
# anfangen. Er kann auch nicht nachsehen, was drin ist, und er kann den
# Hauptschluessel nicht daraus holen. Fuer das Schreiben braucht es keinen
# Entschluesselungsschluessel, und deshalb liegt hier keiner.
# ==========================================================================

set -uo pipefail

HIER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/gemeinsam.sh
source "${SWISSHUB_LIB_DIR:-$HIER/../lib}/gemeinsam.sh"

LOG_KONTEXT='secrets'
lade_konfiguration || exit 1
protokoll_eroeffnen 'geheimnisse'

PAKET_DIR="$SWISSHUB_BACKUP_ROOT/recovery"
ENV_DATEI="$SWISSHUB_PROJECT_DIR/.env"

# --------------------------------------------------------------------------
# Fingerabdruecke
# --------------------------------------------------------------------------

# Die Kennung eines Schluessels - dieselbe Rechnung wie in der Anwendung.
#
# `packages/secrets/src/crypto.ts` bildet `keyId` als die ersten acht Zeichen
# eines SHA-256 ueber die 32 rohen Bytes des Schluessels. Genau diese Rechnung
# steht hier nach, und zwar aus einem konkreten Grund: damit das Dashboard
# vergleichen kann, ob der gesicherte Schluessel DERSELBE ist, mit dem die
# laufende Anwendung gerade verschluesselt.
#
# Das ist die Antwort auf die Forderung, dass ein Administrator erkennen soll,
# ob die benoetigten Schluessel gesichert sind, ohne ihre Werte zu sehen. Acht
# Hexzeichen aus einem SHA-256 verraten den Schluessel nicht - sie
# unterscheiden ihn nur von einem anderen.
schluessel_kennung() {
  local roh="$1"
  [[ -n "$roh" ]] || { printf ''; return; }
  # Erst hex, dann base64 - wie in readMasterKey(). Was 32 Bytes ergibt, gilt.
  python3 - "$roh" <<'PY' 2>/dev/null || printf ''
import base64, binascii, hashlib, sys

roh = sys.argv[1].strip()
kandidaten = []
if len(roh) == 64:
    try:
        kandidaten.append(binascii.unhexlify(roh))
    except (binascii.Error, ValueError):
        pass
try:
    kandidaten.append(base64.b64decode(roh + "=" * (-len(roh) % 4)))
except Exception:
    pass

for kandidat in kandidaten:
    if len(kandidat) == 32:
        print(hashlib.sha256(kandidat).hexdigest()[:8])
        break
PY
}

# Ein Fingerabdruck fuer alles andere: SHA-256 des Werts, auf 12 Zeichen
# gekuerzt. Genug, um «hat sich geaendert» zu erkennen, zu wenig zum Raten.
wert_fingerabdruck() {
  local wert="$1"
  [[ -n "$wert" ]] || { printf ''; return; }
  printf '%s' "$wert" | sha256sum | cut -c1-12
}

env_wert() {
  local name="$1"
  [[ -r "$ENV_DATEI" ]] || return 0
  # Nur die erste Zuweisung, Anfuehrungszeichen weg. Kein `source`: die .env
  # koennte Befehlssubstitution enthalten, und die soll hier nicht laufen.
  local zeile
  zeile=$(grep -m1 -E "^${name}=" "$ENV_DATEI" 2>/dev/null) || return 0
  local wert="${zeile#*=}"
  wert="${wert%\"}"; wert="${wert#\"}"
  wert="${wert%\'}"; wert="${wert#\'}"
  printf '%s' "$wert"
}

# --------------------------------------------------------------------------
# Paket erzeugen
# --------------------------------------------------------------------------

paket_erzeugen() {
  werkzeug_pruefen age tar || return 1

  if [[ -z "$SWISSHUB_RECOVERY_AGE_RECIPIENTS" ]]; then
    alarm kritisch 'kein-recovery-empfaenger' \
      'SWISSHUB_RECOVERY_AGE_RECIPIENTS ist leer. Es wird kein Wiederherstellungspaket erzeugt - und damit ist der MASTER_ENCRYPTION_KEY nur auf diesem Server vorhanden. Geht der Server verloren, sind Bot-Token, Discord-OAuth und AI-Schluessel aus der Datenbanksicherung DAUERHAFT unlesbar. Anleitung: der Abschnitt «Wiederherstellungspaket» in /etc/swisshub-backup/swisshub-backup.env.'
    return 1
  fi

  if [[ ! -r "$ENV_DATEI" ]]; then
    alarm kritisch 'env-unlesbar' "Die Datei $ENV_DATEI ist nicht lesbar. Ohne sie enthaelt das Wiederherstellungspaket keinen MASTER_ENCRYPTION_KEY."
    return 1
  fi

  local master
  master=$(env_wert MASTER_ENCRYPTION_KEY)
  if [[ -z "$master" ]]; then
    alarm kritisch 'kein-master-key' \
      "In $ENV_DATEI steht kein MASTER_ENCRYPTION_KEY. Entweder laeuft die Anwendung ohne ihn - dann sind die Zugangsdaten in der Datenbank gar nicht verschluesselt hinterlegt - oder er kommt von woanders. Beides muss geklaert werden, bevor eine Sicherung als vollstaendig gelten kann."
    return 1
  fi

  local sammel
  sammel=$(mktemp -d "$SWISSHUB_BACKUP_ROOT/.recovery.XXXXXX") || return 1
  chmod 700 "$sammel"

  local stempel
  stempel=$(date +%Y%m%dT%H%M%S)
  local kennung
  kennung=$(schluessel_kennung "$master")

  # --- Inhalt --------------------------------------------------------------

  mkdir -p "$sammel/paket"

  # Die vollstaendige .env. Sie ist das, was ein neuer Server braucht - und
  # der einzige Ort im ganzen System, an dem sie ausserhalb des produktiven
  # Servers liegt.
  install -m 0400 "$ENV_DATEI" "$sammel/paket/swisshub.env"

  # Die Backup-Konfiguration: ohne die Repository-Passwoerter darin laesst
  # sich das externe Repository nicht oeffnen. Sie hier mitzugeben ist genau
  # der Punkt - auf dem verlorenen Server steht sie nicht mehr zur Verfuegung.
  if [[ -r "$SWISSHUB_CONFIG_FILE" ]]; then
    install -m 0400 "$SWISSHUB_CONFIG_FILE" "$sammel/paket/swisshub-backup.env"
  fi

  # Die Schluessel und Zugangsdaten noch einmal einzeln und ausdruecklich.
  #
  # Doppelt, ja - aber wer im Ernstfall dieses Paket oeffnet, soll nicht in
  # zwei Konfigurationsdateien nach dem richtigen Namen suchen muessen.
  {
    printf '# SwissHub - Schluessel und Zugangsdaten fuer die Wiederherstellung\n'
    printf '# Erzeugt: %s auf %s\n' "$(date --iso-8601=seconds)" "$(hostname -f 2>/dev/null || hostname)"
    printf '#\n'
    printf '# Diese Datei existiert AUSSCHLIESSLICH in diesem verschluesselten Paket.\n\n'
    printf 'MASTER_ENCRYPTION_KEY=%s\n' "$master"
    printf '# Kennung dieses Schluessels (erste 8 Zeichen des SHA-256): %s\n' "$kennung"
    printf '# Die Anwendung nennt dieselbe Kennung im Umschlag jedes Geheimnisses:\n'
    printf '#   v1.%s.<iv>.<tag>.<geheimtext>\n' "$kennung"
    printf '# Stimmen beide nicht ueberein, ist es der falsche Schluessel.\n\n'
    printf 'AUTH_SECRET=%s\n' "$(env_wert AUTH_SECRET)"
    printf 'POSTGRES_PASSWORD=%s\n' "$(env_wert POSTGRES_PASSWORD)"
    printf 'SWISSHUB_OWNER_DISCORD_ID=%s\n' "$(env_wert SWISSHUB_OWNER_DISCORD_ID)"
    printf '\n# --- Backup-Repositories ---\n'
    printf 'SWISSHUB_PGBACKREST_CIPHER_PASS=%s\n' "$SWISSHUB_PGBACKREST_CIPHER_PASS"
    printf 'SWISSHUB_RESTIC_PASSWORD=%s\n' "$SWISSHUB_RESTIC_PASSWORD"
    printf '\n# --- Externer Speicher ---\n'
    printf 'SWISSHUB_S3_ENDPOINT=%s\n' "$SWISSHUB_S3_ENDPOINT"
    printf 'SWISSHUB_S3_BUCKET=%s\n' "$SWISSHUB_S3_BUCKET"
    printf 'SWISSHUB_S3_REGION=%s\n' "$SWISSHUB_S3_REGION"
    printf '#\n'
    printf '# Die LESENDEN Zugangsdaten stehen hier bewusst NICHT: sie liegen nie auf\n'
    printf '# dem produktiven Server und gehoeren deshalb auch nicht in ein Paket, das\n'
    printf '# er erzeugt. Sie sind an demselben getrennten Ort aufzubewahren wie der\n'
    printf '# private age-Schluessel, mit dem dieses Paket geoeffnet wird.\n'
  } > "$sammel/paket/schluessel.txt"
  chmod 400 "$sammel/paket/schluessel.txt"

  # Die Notfallanleitung IM Paket.
  #
  # Nicht nur im Repository: im Ernstfall ist unklar, ob das Repository
  # erreichbar ist. Wer dieses Paket oeffnen kann, hat damit auch die
  # Anleitung.
  cat > "$sammel/paket/ANLEITUNG.txt" <<ANLEITUNG
SwissHub - Wiederherstellung
============================
Paket erzeugt: $(date --iso-8601=seconds)
Quelle:        $(hostname -f 2>/dev/null || hostname)
Kennung des Hauptschluessels: $kennung

Du hast dieses Paket geoeffnet. Das heisst: du hast den privaten
age-Schluessel, und damit alles, was eine Wiederherstellung braucht.

REIHENFOLGE - sie ist nicht beliebig
------------------------------------

 1. Neuen Server aufsetzen (Ubuntu 24.04, Docker, nginx).

 2. DNS auf die neue Adresse zeigen lassen.
    Ohne DNS scheitert die Discord-Anmeldung und es gibt kein Zertifikat.

 3. Quelltext holen:
       git clone https://github.com/maanu0001/SwissHub_Bot-WebApp.git /opt/swisshub
       cd /opt/swisshub && git checkout <commit aus release.json>
    Ist GitHub nicht erreichbar, liegt eine Kopie im Restic-Repository
    unter der Marke «konfiguration».

 4. swisshub.env aus diesem Paket nach /opt/swisshub/.env kopieren,
    chmod 600. Sie enthaelt den MASTER_ENCRYPTION_KEY - ohne ihn sind die
    Zugangsdaten in der Datenbank unlesbar.

 5. swisshub-backup.env nach /etc/swisshub-backup/ kopieren und die
    LESENDEN S3-Zugangsdaten eintragen (SWISSHUB_S3_RESTORE_KEY_ID und
    SWISSHUB_S3_RESTORE_SECRET). Sie liegen an demselben Ort wie der
    private age-Schluessel.

 6. Wiederherstellen - das Werkzeug fuehrt durch alle Schritte:
       swisshub-recovery vorbereiten
       swisshub-recovery punkte
       swisshub-recovery pruefen --zeit '<Zielzeitpunkt>'
       swisshub-recovery wiederherstellen --zeit '<Zielzeitpunkt>'
       swisshub-recovery validieren

 7. ERST nach erfolgreicher Validierung Bot und Musik-Laufzeit starten:
       swisshub-recovery freigeben

    Vorher NICHT. Der Bot wirkt nach aussen: er vergibt Discord-Rollen,
    schreibt in Kanaele und arbeitet Jail-Fristen ab. Auf unvalidierten
    Daten richtet er Schaden an, den kein Backup zuruecknimmt.

 8. Sicherstellen, dass die ALTE Instanz nicht mehr laeuft. Zwei Bots mit
    demselben Token gleichzeitig ist der Fehler, der am meisten anrichtet.

WENN DU KEINE ZEIT HAST, ETWAS ZU LESEN
---------------------------------------
    swisshub-recovery notfall
liest dieses Paket, prueft alles und fuehrt Schritt fuer Schritt.

WAS IN DIESEM PAKET LIEGT
-------------------------
    schluessel.txt         Hauptschluessel und Repository-Passwoerter
    swisshub.env           Die vollstaendige .env des Servers
    swisshub-backup.env    Die Backup-Konfiguration
    release.json           Commit, Abbild-Digests, Migrationsstand
    fingerabdruecke.txt    Womit sich pruefen laesst, ob es das Richtige ist
    ANLEITUNG.txt          Diese Datei

Ausfuehrlich: docs/DISASTER-RECOVERY.md im Repository.
ANLEITUNG

  # Der Releasestand - wozu genau dieses Paket gehoert.
  "${SWISSHUB_BIN_DIR:-$HIER}/swisshub-backup" release > "$sammel/paket/release.json" 2>/dev/null \
    || printf '{}' > "$sammel/paket/release.json"

  # Fingerabdruecke. Sie beantworten nach dem Oeffnen die Frage «ist das das
  # richtige Paket zu dieser Datenbank».
  {
    printf 'master_key_kennung=%s\n' "$kennung"
    printf 'auth_secret=%s\n' "$(wert_fingerabdruck "$(env_wert AUTH_SECRET)")"
    printf 'postgres_password=%s\n' "$(wert_fingerabdruck "$(env_wert POSTGRES_PASSWORD)")"
    printf 'pgbackrest_cipher=%s\n' "$(wert_fingerabdruck "$SWISSHUB_PGBACKREST_CIPHER_PASS")"
    printf 'restic_password=%s\n' "$(wert_fingerabdruck "$SWISSHUB_RESTIC_PASSWORD")"
    printf 'erzeugt=%s\n' "$(date --iso-8601=seconds)"
  } > "$sammel/paket/fingerabdruecke.txt"

  # --- Verschluesseln -----------------------------------------------------

  mkdir -p "$PAKET_DIR"
  chmod 750 "$PAKET_DIR"
  local ziel="$PAKET_DIR/swisshub-recovery-$stempel.tar.age"

  # Jeder Empfaenger kann das Paket allein oeffnen. Das ist gewollt: ein
  # einzelner verlorener privater Schluessel darf nicht alles verlieren.
  local empfaenger=()
  local empfaenger_anzahl=0
  local eintrag
  for eintrag in $SWISSHUB_RECOVERY_AGE_RECIPIENTS; do
    [[ -n "$eintrag" ]] || continue
    empfaenger+=(--recipient "$eintrag")
    empfaenger_anzahl=$(( empfaenger_anzahl + 1 ))
  done
  # Gezaehlt werden die Empfaenger, nicht die Array-Eintraege: je Empfaenger
  # stehen dort ZWEI (der Schalter und der Wert). Die Array-Laenge meldete
  # deshalb bei einem Empfaenger «zwei» und verschluckte die Warnung, um die es
  # geht.
  if [[ "$empfaenger_anzahl" -lt 2 ]]; then
    warnung "Es ist nur ein Empfaengerschluessel eingetragen. Geht dessen privater Schluessel verloren, ist das Paket dauerhaft verschlossen - und damit der MASTER_ENCRYPTION_KEY. Zwei Empfaenger eintragen."
  fi

  # `tar | age` in einer Pipe: der Klartext wird nie als Datei geschrieben.
  # Ein Tar-Archiv mit dem Hauptschluessel, das auch nur fuer Sekunden auf der
  # Platte liegt, ist ein Zeitfenster, das es nicht geben muss.
  if ! tar --create --directory "$sammel" --numeric-owner paket 2>/dev/null \
      | age --encrypt "${empfaenger[@]}" --output "$ziel" 2>/dev/null; then
    rm -rf -- "${sammel:?}"
    rm -f -- "$ziel"
    alarm kritisch 'recovery-paket' 'Das Wiederherstellungspaket konnte nicht erzeugt werden. Damit existiert der MASTER_ENCRYPTION_KEY nur auf diesem Server. Pruefen: sind die Empfaengerschluessel in SWISSHUB_RECOVERY_AGE_RECIPIENTS gueltige age-Empfaenger (age1...)?'
    return 1
  fi

  chmod 640 "$ziel"
  rm -rf -- "${sammel:?}"

  # --- Gegenprobe ---------------------------------------------------------
  #
  # Was sich hier pruefen LAESST, wird geprueft; was nicht, wird gesagt.
  #
  # Dieser Server kann das Paket nicht oeffnen - das ist der ganze Zweck der
  # Anlage. Geprueft wird deshalb, was ohne privaten Schluessel pruefbar ist:
  # dass die Datei ein age-Archiv mit der erwarteten Zahl von Empfaengern ist
  # und dass sie eine plausible Groesse hat. Der Beweis, dass sie sich
  # oeffnen laesst, kann nur woanders erbracht werden - in der
  # vierteljaehrlichen Uebung mit dem privaten Schluessel
  # (`swisshub-secrets-seal pruefen`).
  local groesse empfaenger_im_paket
  groesse=$(stat -c %s "$ziel")
  # Der age-Kopf ist Klartext: eine `-> X25519`-Zeile je Empfaenger.
  empfaenger_im_paket=$(head -c 4096 "$ziel" | grep -c '^-> ' || true)

  if [[ "$groesse" -lt 512 ]]; then
    rm -f -- "$ziel"
    alarm kritisch 'recovery-paket-leer' "Das erzeugte Paket war nur ${groesse} Bytes gross und wurde verworfen. Ein leeres Paket, das als Erfolg gilt, ist schlimmer als keins."
    return 1
  fi
  if [[ "$empfaenger_im_paket" -lt "$empfaenger_anzahl" ]]; then
    warnung "Im Paket stehen $empfaenger_im_paket Empfaenger, konfiguriert sind $empfaenger_anzahl. Bitte SWISSHUB_RECOVERY_AGE_RECIPIENTS pruefen."
  fi

  # Aufbewahrung: die letzten zwoelf. Ausdruecklich beim Namen geloescht.
  local alt
  while IFS= read -r alt; do
    [[ -n "$alt" ]] && rm -f -- "$alt"
  done < <(find "$PAKET_DIR" -maxdepth 1 -name 'swisshub-recovery-*.tar.age' -printf '%T@ %p\n' \
           | sort -rn | tail -n +13 | cut -d' ' -f2-)

  # --- Nach aussen --------------------------------------------------------
  #
  # Das Paket geht in das Restic-Repository und damit auch in die externe,
  # unveraenderbare Kopie. Doppelt verschluesselt - von age und von Restic -
  # und das ist kein Uebermass: die age-Schicht ist die, die den Verlust des
  # Servers ueberlebt.
  local extern_ok='nein'
  if restic_repo_bereit_leise; then
    if restic_lokal backup --tag recovery --host "$(hostname -s)" "$PAKET_DIR" >/dev/null 2>&1; then
      extern_ok='ja'
    else
      warnung 'Das Wiederherstellungspaket konnte nicht in das Restic-Repository uebernommen werden.'
    fi
  fi

  zustand_schreiben 'geheimnisse' "$(printf \
    '{"zeit":%s,"paket":%s,"bytes":%s,"master_key_kennung":%s,"empfaenger":%s,"in_repository":%s,"anleitung_enthalten":true}' \
    "$(json_text "$(date --iso-8601=seconds)")" "$(json_text "$(basename "$ziel")")" "$groesse" \
    "$(json_text "$kennung")" "$empfaenger_im_paket" "$(json_text "$extern_ok")")"

  alarm_entwarnung 'recovery-paket' 'Wiederherstellungspaket wieder erfolgreich erzeugt'
  alarm_entwarnung 'kein-recovery-empfaenger' 'Empfaengerschluessel sind wieder eingetragen'
  info "Wiederherstellungspaket erzeugt: $(basename "$ziel") ($(numfmt --to=iec "$groesse" 2>/dev/null || echo "$groesse B")), Schluesselkennung $kennung, $empfaenger_im_paket Empfaenger."
  return 0
}

# Restic-Repository, ohne einen Fehler zu erzwingen - das Paket liegt lokal
# auch dann, wenn das Repository gerade nicht bereit ist.
restic_repo_bereit_leise() {
  [[ -n "$SWISSHUB_RESTIC_PASSWORD" ]] || return 1
  restic_umgebung
  restic_lokal cat config >/dev/null 2>&1
}

# --------------------------------------------------------------------------
# pruefen - die Gegenprobe mit dem privaten Schluessel
# --------------------------------------------------------------------------

# Der einzige echte Beweis, dass das Paket taugt.
#
# Diese Funktion gehoert NICHT auf den produktiven Server: sie braucht den
# privaten Schluessel, und der darf dort nicht liegen. Sie ist Teil der
# vierteljaehrlichen Uebung und laeuft auf dem Rechner, auf dem der Schluessel
# aufbewahrt wird.
paket_pruefen() {
  local schluesseldatei="${1:-}"
  local paket="${2:-}"

  if [[ -z "$schluesseldatei" ]]; then
    cat <<'HILFE'
  swisshub-secrets-seal pruefen <private-schluesseldatei> [paket.tar.age]

  Oeffnet das Paket und prueft seinen Inhalt. Ohne Paketangabe wird das
  jungste im Verzeichnis recovery/ genommen.

  NUR auf einem Rechner ausfuehren, auf dem der private age-Schluessel liegen
  darf. Auf dem produktiven Server darf er NICHT liegen - sonst ist die ganze
  Anlage sinnlos: wer den Server uebernimmt, haette dann auch den Schluessel.
HILFE
    return 64
  fi
  [[ -r "$schluesseldatei" ]] || { fehler "Schluesseldatei nicht lesbar: $schluesseldatei"; return 1; }

  if [[ -z "$paket" ]]; then
    paket=$(find "$PAKET_DIR" -maxdepth 1 -name 'swisshub-recovery-*.tar.age' -printf '%T@ %p\n' 2>/dev/null \
            | sort -rn | head -1 | cut -d' ' -f2-)
  fi
  [[ -n "$paket" && -r "$paket" ]] || { fehler 'Kein Paket gefunden.'; return 1; }

  info "Pruefe $paket"
  local ziel
  ziel=$(mktemp -d) || return 1
  chmod 700 "$ziel"

  if ! age --decrypt --identity "$schluesseldatei" "$paket" 2>/dev/null \
      | tar --extract --directory "$ziel" 2>/dev/null; then
    rm -rf -- "${ziel:?}"
    fehler 'Das Paket liess sich mit diesem Schluessel nicht oeffnen.'
    return 1
  fi

  local fehlend=()
  local datei
  for datei in schluessel.txt swisshub.env ANLEITUNG.txt release.json fingerabdruecke.txt; do
    [[ -s "$ziel/paket/$datei" ]] || fehlend+=("$datei")
  done

  local master kennung erwartet
  master=$(grep -m1 '^MASTER_ENCRYPTION_KEY=' "$ziel/paket/schluessel.txt" 2>/dev/null | cut -d= -f2-)
  kennung=$(schluessel_kennung "$master")
  erwartet=$(grep -m1 '^master_key_kennung=' "$ziel/paket/fingerabdruecke.txt" 2>/dev/null | cut -d= -f2-)

  printf '\n  Inhalt:\n'
  ( cd "$ziel" && find paket -type f -printf '    %-28p %s Bytes\n' )
  printf '\n  Hauptschluessel: Kennung %s' "${kennung:-FEHLT}"
  if [[ -n "$kennung" && "$kennung" == "$erwartet" ]]; then
    printf ' (stimmt mit dem Fingerabdruck ueberein)\n'
  else
    printf ' (WEICHT AB vom Fingerabdruck «%s»)\n' "${erwartet:-?}"
    fehlend+=('master_key_kennung')
  fi

  # Der abschliessende Beweis waere, mit diesem Schluessel einen echten
  # Umschlag aus der Datenbanksicherung zu entschluesseln. Genau das tut der
  # Restore-Test in Stufe 6 - dort steht eine wiederhergestellte Datenbank
  # daneben, hier nicht.
  printf '\n  Der Beweis, dass dieser Schluessel die Daten in der Sicherung\n'
  printf '  entschluesselt, wird in Stufe 6 des Restore-Tests erbracht\n'
  printf '  (swisshub-restore-test). Hier ist nur geprueft, dass das Paket\n'
  printf '  sich oeffnen laesst und vollstaendig ist.\n'

  rm -rf -- "${ziel:?}"

  if [[ ${#fehlend[@]} -gt 0 ]]; then
    fehler "Unvollstaendig oder abweichend: ${fehlend[*]}"
    return 1
  fi
  info 'Paket vollstaendig und oeffenbar.'
  zustand_schreiben 'geheimnisse-geprueft' "$(printf '{"zeit":%s,"paket":%s,"ergebnis":"erfolg"}' \
    "$(json_text "$(date --iso-8601=seconds)")" "$(json_text "$(basename "$paket")")")"
  return 0
}

case "${1:-erzeugen}" in
  erzeugen|'') paket_erzeugen ;;
  pruefen) shift; paket_pruefen "$@" ;;
  kennung) shift; schluessel_kennung "${1:-$(env_wert MASTER_ENCRYPTION_KEY)}" ;;
  *) fehler "Unbekannter Befehl: $1"; exit 64 ;;
esac
