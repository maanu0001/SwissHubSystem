#!/usr/bin/env bash
# SwissHub - Ueberwachung.
#
#   swisshub-backup-monitor            Alles pruefen und bei Bedarf alarmieren
#   swisshub-backup-monitor --ruhig    Nur den Zustand ausgeben, nicht alarmieren
#
# ==========================================================================
# WARUM DIESE UEBERWACHUNG NICHT UEBER DEN DISCORD-BOT LAEUFT
# ==========================================================================
#
# Der naheliegende Weg waere, Warnungen in einen Discord-Kanal zu schicken.
# SwissHub hat einen Bot, der Kanal ist da, es waere schnell gebaut.
#
# Und es waere die Alarmierung, die genau dann ausfaellt, wenn sie gebraucht
# wird. Der Bot laeuft auf demselben Server. Faellt der Server aus, faellt der
# Bot mit aus - und die Meldung ueber den Ausfall kommt nie an. Dasselbe gilt
# fuer jede Alarmierung, die von diesem Server ausgehen muss: bei einem
# Totalausfall gibt es niemanden, der sie verschickt.
#
# Deshalb ist der wichtigste Weg der umgekehrte: der TOTMANNSCHALTER. Ein
# externer Dienst erwartet in regelmaessigen Abstaenden ein Lebenszeichen und
# schlaegt Alarm, wenn es AUSBLEIBT. Eine Meldung, die nicht kommt, faellt auf -
# und dafuer muss der Server nichts tun koennen.
#
# Die uebrigen Wege - E-Mail ueber einen externen SMTP-Anbieter, ein Webhook
# eines externen Dienstes - sind fuer alles da, was der Server noch melden
# kann: eine gescheiterte Sicherung, ein knappes Laufwerk, ein abgelaufenes
# Zertifikat. Discord kommt zusaetzlich, nie allein.
# ==========================================================================

set -uo pipefail

HIER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/gemeinsam.sh
source "${SWISSHUB_LIB_DIR:-$HIER/../lib}/gemeinsam.sh"

LOG_KONTEXT='monitor'
lade_konfiguration || exit 1
protokoll_eroeffnen 'monitor'

RUHIG='nein'
[[ "${1:-}" == '--ruhig' ]] && RUHIG='ja'

BEFUNDE=()
FEHLER=0
WARNUNGEN=0

melde() {
  local stufe="$1" kennung="$2" text="$3"
  BEFUNDE+=("$(printf '{"stufe":%s,"kennung":%s,"text":%s}' \
    "$(json_text "$stufe")" "$(json_text "$kennung")" "$(json_text "$text")")")
  case "$stufe" in
    kritisch) FEHLER=$(( FEHLER + 1 )) ;;
    warnung) WARNUNGEN=$(( WARNUNGEN + 1 )) ;;
  esac
  if [[ "$RUHIG" == 'ja' ]]; then
    printf '  [%s] %s: %s\n' "$stufe" "$kennung" "$text"
  else
    alarm "$stufe" "$kennung" "$text"
  fi
}

entwarne() {
  [[ "$RUHIG" == 'ja' ]] || alarm_entwarnung "$1" "$2"
}

# Das Alter einer Zustandsdatei in Stunden, oder -1.
alter_stunden() {
  local datei="$ZUSTAND_DIR/$1.json"
  [[ -f "$datei" ]] || { printf '%s' -1; return; }
  local zeit
  zeit=$(python3 -c '
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as datei:
        daten = json.load(datei)
except Exception:
    print(""); raise SystemExit
print(daten.get("zeit") or daten.get("erhoben") or "")' "$datei" 2>/dev/null)
  [[ -n "$zeit" ]] || { printf '%s' -1; return; }
  local epoche
  epoche=$(date -d "$zeit" +%s 2>/dev/null) || { printf '%s' -1; return; }
  printf '%s' $(( ( $(date +%s) - epoche ) / 3600 ))
}

# --------------------------------------------------------------------------
titel_ausgeben() { [[ "$RUHIG" == 'ja' ]] && printf '\n%s\n' "$1"; }
# --------------------------------------------------------------------------

titel_ausgeben '1. Alter der Sicherungen'

# Die Datenbank. Gesucht ist die JUNGSTE erfolgreiche Sicherung, gleich
# welcher Art: ein inkrementeller Lauf von vor einer Stunde ist eine bessere
# Auskunft als ein Vollbackup von vorgestern.
neueste_db=-1
for art in db-incr db-diff db-full; do
  wert=$(alter_stunden "letzter-erfolg-$art")
  if [[ "$wert" -ge 0 ]] && { [[ "$neueste_db" -lt 0 ]] || [[ "$wert" -lt "$neueste_db" ]]; }; then
    neueste_db="$wert"
  fi
done
if [[ "$neueste_db" -lt 0 ]]; then
  melde kritisch 'backup-db-fehlt' 'Es gibt keine erfolgreiche Datenbanksicherung. Entweder ist die Anlage nicht eingerichtet, oder jeder Lauf scheitert.'
elif [[ "$neueste_db" -gt 26 ]]; then
  melde kritisch 'backup-db-alt' "Die jungste erfolgreiche Datenbanksicherung ist ${neueste_db} Stunden alt. Erwartet sind stuendliche inkrementelle und taegliche differentielle Laeufe."
elif [[ "$neueste_db" -gt 6 ]]; then
  melde warnung 'backup-db-alt' "Die jungste erfolgreiche Datenbanksicherung ist ${neueste_db} Stunden alt."
else
  entwarne 'backup-db-alt' "Datenbanksicherung ist ${neueste_db} Stunden alt"
  entwarne 'backup-db-fehlt' 'es gibt wieder eine Datenbanksicherung'
  [[ "$RUHIG" == 'ja' ]] && printf '  [ok] Datenbanksicherung %s Stunden alt\n' "$neueste_db"
fi

# Die Dateien. Angestrebt ist stuendlich, also ist alles ueber drei Stunden
# ein Hinweis.
dateien_alter=$(alter_stunden 'letzter-erfolg-dateien')
if [[ "$dateien_alter" -lt 0 ]]; then
  melde kritisch 'backup-dateien-fehlt' 'Es gibt keine erfolgreiche Dateisicherung. Die Datenbank verweist auf Uploads, die in keiner Sicherung stehen.'
elif [[ "$dateien_alter" -gt 6 ]]; then
  melde kritisch 'backup-dateien-alt' "Die jungste Dateisicherung ist ${dateien_alter} Stunden alt. Angestrebt ist maximal eine Stunde Datenverlust bei Dateien."
elif [[ "$dateien_alter" -gt 3 ]]; then
  melde warnung 'backup-dateien-alt' "Die jungste Dateisicherung ist ${dateien_alter} Stunden alt."
else
  entwarne 'backup-dateien-alt' "Dateisicherung ist ${dateien_alter} Stunden alt"
  entwarne 'backup-dateien-fehlt' 'es gibt wieder eine Dateisicherung'
  [[ "$RUHIG" == 'ja' ]] && printf '  [ok] Dateisicherung %s Stunden alt\n' "$dateien_alter"
fi

# Das Wiederherstellungspaket. Es ist die Voraussetzung dafuer, dass eine
# Sicherung ueberhaupt vollstaendig verwertbar ist.
paket_alter=$(alter_stunden 'geheimnisse')
if [[ "$paket_alter" -lt 0 ]]; then
  melde kritisch 'recovery-paket-fehlt' 'Es gibt kein Wiederherstellungspaket. Der MASTER_ENCRYPTION_KEY liegt damit nur auf diesem Server - nach seinem Verlust sind Bot-Token, Discord-OAuth und AI-Schluessel aus der Datenbanksicherung dauerhaft unlesbar.'
elif [[ "$paket_alter" -gt 192 ]]; then
  melde warnung 'recovery-paket-alt' "Das Wiederherstellungspaket ist $(( paket_alter / 24 )) Tage alt. Aenderungen an der .env seither sind darin nicht enthalten."
else
  entwarne 'recovery-paket-alt' 'Wiederherstellungspaket ist aktuell'
  entwarne 'recovery-paket-fehlt' 'es gibt wieder ein Wiederherstellungspaket'
  [[ "$RUHIG" == 'ja' ]] && printf '  [ok] Wiederherstellungspaket %s Stunden alt\n' "$paket_alter"
fi

titel_ausgeben '2. WAL-Archivierung'

wal=$(zustand_lesen 'wal')
wal_modus=$(printf '%s' "$wal" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("archive_mode",""))' 2>/dev/null)
wal_abstand=$(printf '%s' "$wal" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("abstand_s",-1))' 2>/dev/null)
wal_gescheitert=$(printf '%s' "$wal" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("gescheitert",0))' 2>/dev/null)
wal_fehler_zeit=$(printf '%s' "$wal" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("letzter_fehler_zeit") or "")' 2>/dev/null)
wal_alter=$(alter_stunden 'wal')

# Wie lange ist der letzte gescheiterte Archivierungsversuch her?
#
# Der KUMULATIVE Zaehler allein taugt nicht als Alarm: er wird nur beim
# Neustart von PostgreSQL zurueckgesetzt, und ein paar Fehlschlaege aus der
# Einrichtungsphase stehen dann monatelang darin. Ein hoher Zaehler ohne
# frischen Fehlschlag ist Vergangenheit.
#
# Umgekehrt ist ein FRISCHER Fehlschlag der wichtigste Einzelwert der ganzen
# Ueberwachung: ab da laeuft pg_wal voll, und in der Kette entsteht eine
# Luecke, die spaeter keinen Zeitpunkt mehr erreichbar macht.
wal_fehler_alter=-1
if [[ -n "$wal_fehler_zeit" ]]; then
  fehler_epoche=$(date -d "$wal_fehler_zeit" +%s 2>/dev/null)
  [[ -n "$fehler_epoche" ]] && wal_fehler_alter=$(( ( $(date +%s) - fehler_epoche ) / 60 ))
fi

if [[ -z "$wal_modus" || "$wal_alter" -lt 0 ]]; then
  melde kritisch 'wal-unbekannt' 'Der Zustand der WAL-Archivierung ist unbekannt - es wurde nie erhoben oder die Erhebung scheitert. Solange das so ist, gibt es keine Zusage ueber den erreichbaren Wiederherstellungszeitpunkt.'
elif [[ "$wal_alter" -gt 6 ]]; then
  melde warnung 'wal-veraltet' "Die Auskunft ueber die WAL-Archivierung ist ${wal_alter} Stunden alt."
elif [[ "$wal_modus" != 'on' && "$wal_modus" != 'always' ]]; then
  melde kritisch 'wal-aus' "archive_mode steht auf «$wal_modus» - es gibt keine Point-in-Time-Recovery."
elif [[ "$wal_fehler_alter" -ge 0 && "$wal_fehler_alter" -lt 60 ]]; then
  melde kritisch 'wal-fehler-frisch' "Die WAL-Archivierung ist vor ${wal_fehler_alter} Minuten gescheitert (insgesamt ${wal_gescheitert} Fehlschlaege, zuletzt bei $wal_fehler_zeit). Ab jetzt entsteht eine Luecke in der Kette, und pg_wal laeuft voll."
elif [[ "${wal_abstand:-0}" -gt 900 ]]; then
  # 900 statt der 600 in `swisshub-backup wal-pruefen`: der Lauf dort prueft
  # unmittelbar nach einer Sicherung und darf empfindlicher sein. Die
  # Ueberwachung laeuft dazwischen und soll nicht bei jedem ruhigen
  # Fuenfminutenfenster melden.
  melde warnung 'wal-abstand' "Die jungste archivierte WAL-Datei ist ${wal_abstand} Sekunden alt. So gross ist der Datenverlust bei einem Ausfall in diesem Moment."
else
  entwarne 'wal-abstand' "Abstand wieder bei ${wal_abstand} Sekunden"
  entwarne 'wal-aus' 'Archivierung wieder eingeschaltet'
  entwarne 'wal-unbekannt' 'Zustand der Archivierung wieder erhebbar'
  entwarne 'wal-fehler-frisch' 'seit einer Stunde kein gescheiterter Archivierungsversuch'
  [[ "$RUHIG" == 'ja' ]] && printf '  [ok] WAL: %s, Abstand %ss, %s Fehlschlaege insgesamt (letzter vor %s Minuten)\n' \
    "$wal_modus" "$wal_abstand" "$wal_gescheitert" "$( [[ "$wal_fehler_alter" -ge 0 ]] && printf '%s' "$wal_fehler_alter" || printf 'nie' )"
fi

titel_ausgeben '3. Externe Kopie'

if ! hat_externes_ziel; then
  melde kritisch 'kein-offsite' 'Es ist kein externes Backup-Ziel konfiguriert. Alle Kopien liegen auf dem Server, der gesichert wird - gegen dessen Verlust schuetzt das nicht, und das ist der haeufigste Ernstfall.'
else
  extern_alter=$(alter_stunden 'extern')
  extern_status=$(zustand_lesen 'extern' | python3 -c 'import json,sys; print(json.load(sys.stdin).get("status",""))' 2>/dev/null)
  if [[ "$extern_alter" -lt 0 ]]; then
    melde kritisch 'extern-nie' 'Es hat nie eine erfolgreiche externe Uebertragung gegeben.'
  elif [[ "$extern_status" != 'erfolg' ]]; then
    melde kritisch 'extern-fehler' 'Die letzte externe Uebertragung ist gescheitert. Die Sicherungen liegen nur lokal.'
  elif [[ "$extern_alter" -gt 26 ]]; then
    melde kritisch 'extern-alt' "Die letzte erfolgreiche externe Uebertragung ist ${extern_alter} Stunden alt. So gross ist der Datenverlust bei einem Serververlust."
  else
    entwarne 'extern-alt' "externe Kopie ist ${extern_alter} Stunden alt"
    entwarne 'extern-fehler' 'externe Uebertragung wieder erfolgreich'
    entwarne 'extern-nie' 'es gibt eine externe Kopie'
    [[ "$RUHIG" == 'ja' ]] && printf '  [ok] Externe Kopie %s Stunden alt\n' "$extern_alter"
  fi
fi

titel_ausgeben '4. Pruefung und Restore-Test'

verify=$(zustand_lesen 'verify')
verify_gesamt=$(printf '%s' "$verify" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("gesamt",""))' 2>/dev/null)
verify_alter=$(alter_stunden 'verify')
if [[ "$verify_alter" -lt 0 ]]; then
  melde warnung 'verify-nie' 'Die Sicherungen wurden nie geprueft. Ein abgeschlossener Kopiervorgang ist kein wiederherstellbares Backup.'
elif [[ "$verify_alter" -gt 48 ]]; then
  melde warnung 'verify-alt' "Die letzte Pruefung ist ${verify_alter} Stunden alt."
elif [[ "$verify_gesamt" == 'fehler' ]]; then
  melde kritisch 'verify-fehler' 'Die letzte Pruefung der Sicherungen hat Fehler gefunden. Einzelheiten unter System -> Backup & Recovery.'
else
  entwarne 'verify-fehler' 'Pruefung wieder ohne Fehler'
  entwarne 'verify-alt' 'Pruefung wieder aktuell'
  [[ "$RUHIG" == 'ja' ]] && printf '  [ok] Pruefung %s Stunden alt, Ergebnis: %s\n' "$verify_alter" "$verify_gesamt"
fi

# Der Restore-Test ist der einzige Nachweis, der zaehlt.
test_alter=$(alter_stunden 'restore-test')
test_ergebnis=$(zustand_lesen 'restore-test' | python3 -c 'import json,sys; print(json.load(sys.stdin).get("ergebnis",""))' 2>/dev/null)
grenze_stunden=$(( SWISSHUB_RESTORE_TEST_MAX_AGE_DAYS * 24 ))
if [[ "$test_alter" -lt 0 ]]; then
  melde kritisch 'restore-test-nie' 'Es hat NIE einen Restore-Test gegeben. Damit ist unbewiesen, dass sich aus diesen Sicherungen etwas wiederherstellen laesst - und das ist der Befund, der alle uebrigen gruenen Haken entwertet.'
elif [[ "$test_ergebnis" == 'fehler' ]]; then
  melde kritisch 'restore-test-fehler' 'Der letzte Restore-Test ist gescheitert. Die Sicherungen sind moeglicherweise nicht wiederherstellbar.'
elif [[ "$test_alter" -gt "$grenze_stunden" ]]; then
  melde warnung 'restore-test-alt' "Der letzte erfolgreiche Restore-Test ist $(( test_alter / 24 )) Tage alt. Angestrebt ist woechentlich."
else
  entwarne 'restore-test-fehler' 'Restore-Test wieder erfolgreich'
  entwarne 'restore-test-alt' 'Restore-Test wieder aktuell'
  entwarne 'restore-test-nie' 'es gibt einen Restore-Test'
  [[ "$RUHIG" == 'ja' ]] && printf '  [ok] Restore-Test %s Stunden alt, Ergebnis: %s\n' "$test_alter" "$test_ergebnis"
fi

titel_ausgeben '5. Speicherplatz'

# Zwei Fragen, und die zweite ist die wichtigere: nicht nur «ist noch Platz»,
# sondern «wie lange noch». Ein Laufwerk, das in vier Tagen voll ist, ist heute
# schon ein Problem - und ein volles Laufwerk nimmt PostgreSQL und den Bot mit.
frei_gb=$(freier_platz_gb "$SWISSHUB_BACKUP_ROOT")
if [[ "$frei_gb" -lt "$SWISSHUB_MIN_FREE_GB" ]]; then
  melde kritisch 'speicherplatz' "Nur noch ${frei_gb} GB frei. Unter ${SWISSHUB_MIN_FREE_GB} GB bricht jede Sicherung ab - und ein vollstaendig belegtes Laufwerk nimmt PostgreSQL und den Bot mit."
elif [[ "$frei_gb" -lt $(( SWISSHUB_MIN_FREE_GB * 2 )) ]]; then
  melde warnung 'speicherplatz-knapp' "Noch ${frei_gb} GB frei (Untergrenze ${SWISSHUB_MIN_FREE_GB} GB)."
else
  entwarne 'speicherplatz' "wieder ${frei_gb} GB frei"
  entwarne 'speicherplatz-knapp' "wieder ${frei_gb} GB frei"
  [[ "$RUHIG" == 'ja' ]] && printf '  [ok] %s GB frei\n' "$frei_gb"
fi

# Die Prognose aus dem Wachstum der letzten Tage.
prognose=$(python3 "${SWISSHUB_LIB_DIR:-$HIER/../lib}/platzprognose.py" \
  "$ZUSTAND_DIR" "$frei_gb" 2>/dev/null)
if [[ -n "$prognose" && "$prognose" != 'unbekannt' ]]; then
  tage="${prognose%% *}"
  if [[ "$tage" =~ ^[0-9]+$ ]] && [[ "$tage" -lt 14 ]]; then
    melde warnung 'speicherplatz-prognose' "Bei gleichbleibendem Wachstum ist die Untergrenze in etwa ${tage} Tagen erreicht (${prognose#* })."
  else
    [[ "$RUHIG" == 'ja' ]] && printf '  [ok] Prognose: %s\n' "$prognose"
  fi
fi

titel_ausgeben '6. Dienste und Zertifikate'

# Die WebApp.
if curl -fsS --max-time 10 http://127.0.0.1:3000/api/health >/dev/null 2>&1; then
  entwarne 'webapp' 'WebApp antwortet wieder'
  [[ "$RUHIG" == 'ja' ]] && printf '  [ok] WebApp antwortet\n'
else
  melde kritisch 'webapp' 'Die WebApp antwortet nicht auf /api/health.'
fi

# PostgreSQL.
if [[ -n "$(pg_abfrage 'SELECT 1')" ]]; then
  entwarne 'postgres' 'PostgreSQL antwortet wieder'
  [[ "$RUHIG" == 'ja' ]] && printf '  [ok] PostgreSQL antwortet\n'
else
  melde kritisch 'postgres' 'PostgreSQL antwortet nicht.'
fi

# Der Bot - ueber seinen Herzschlag in der Datenbank. «Prozess laeuft» waere
# keine Auskunft: der Prozess laeuft auch dann, wenn die Verbindung zu Discord
# abgerissen ist und kein Job mehr durchkommt.
herzschlag=$(trimmen "$(pg_abfrage "SELECT EXTRACT(EPOCH FROM (now() - \"lastSeenAt\"))::int FROM \"BotStatus\" ORDER BY \"lastSeenAt\" DESC LIMIT 1")")
if [[ -z "$herzschlag" ]]; then
  melde warnung 'bot-kein-herzschlag' 'Es gibt keinen Bot-Herzschlag in der Datenbank.'
elif [[ "$herzschlag" -gt 300 ]]; then
  melde kritisch 'bot-offline' "Der letzte Bot-Herzschlag ist ${herzschlag} Sekunden alt. Der Bot arbeitet keine Jobs mehr ab - Jail-Fristen laufen nicht aus, Erinnerungen bleiben liegen."
else
  entwarne 'bot-offline' "Bot-Herzschlag wieder frisch (${herzschlag}s)"
  entwarne 'bot-kein-herzschlag' 'Bot schreibt wieder einen Herzschlag'
  [[ "$RUHIG" == 'ja' ]] && printf '  [ok] Bot-Herzschlag %ss alt\n' "$herzschlag"
fi

# Container, sofern Docker im Spiel ist.
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  ungesund=$(docker ps --filter 'health=unhealthy' --format '{{.Names}}' 2>/dev/null | tr '\n' ' ')
  if [[ -n "$ungesund" ]]; then
    melde kritisch 'container-ungesund' "Diese Container sind ungesund: $ungesund"
  else
    entwarne 'container-ungesund' 'alle Container wieder gesund'
    [[ "$RUHIG" == 'ja' ]] && printf '  [ok] Kein ungesunder Container\n'
  fi
fi

# Zertifikate. Ein abgelaufenes Zertifikat ist ein Ausfall, den niemand als
# Ausfall erkennt - die Seite laedt einfach nicht mehr.
for zertifikat in /etc/letsencrypt/live/*/cert.pem; do
  [[ -f "$zertifikat" ]] || continue
  name=$(basename "$(dirname "$zertifikat")")
  if ! openssl x509 -checkend 0 -noout -in "$zertifikat" >/dev/null 2>&1; then
    melde kritisch "zertifikat-$name" "Das Zertifikat fuer $name ist ABGELAUFEN."
  elif ! openssl x509 -checkend 1209600 -noout -in "$zertifikat" >/dev/null 2>&1; then
    melde warnung "zertifikat-$name" "Das Zertifikat fuer $name laeuft in weniger als 14 Tagen ab. Pruefen: systemctl status certbot.timer"
  else
    entwarne "zertifikat-$name" "Zertifikat fuer $name wieder gueltig"
    [[ "$RUHIG" == 'ja' ]] && printf '  [ok] Zertifikat %s gueltig bis %s\n' "$name" "$(openssl x509 -enddate -noout -in "$zertifikat" | cut -d= -f2)"
  fi
done

# --------------------------------------------------------------------------

GESAMT='ok'
[[ "$WARNUNGEN" -gt 0 ]] && GESAMT='warnung'
[[ "$FEHLER" -gt 0 ]] && GESAMT='kritisch'

zustand_schreiben 'monitor' "$(printf \
  '{"zeit":%s,"gesamt":%s,"fehler":%s,"warnungen":%s,"befunde":[%s]}' \
  "$(json_text "$(date --iso-8601=seconds)")" "$(json_text "$GESAMT")" \
  "$FEHLER" "$WARNUNGEN" "$(IFS=,; printf '%s' "${BEFUNDE[*]:-}")")"

# Der Totmannschalter - ganz am Ende und nur bei einem sauberen Durchgang.
#
# Genau hier liegt der Wert: bleibt dieser Ping aus, weil der Server aus ist,
# weil das Skript abgestuerzt ist oder weil das Laufwerk voll ist, alarmiert
# der externe Dienst. Er braucht diesen Server dafuer nicht.
if [[ "$RUHIG" != 'ja' ]]; then
  if [[ "$FEHLER" -eq 0 ]]; then
    herzschlag 0
  else
    herzschlag 1
  fi
fi

if [[ "$RUHIG" == 'ja' ]]; then
  printf '\nGesamt: %s (%d Fehler, %d Warnungen)\n' "$GESAMT" "$FEHLER" "$WARNUNGEN"
fi

[[ "$FEHLER" -gt 0 ]] && exit 1
exit 0
