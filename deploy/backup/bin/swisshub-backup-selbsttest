#!/usr/bin/env bash
# SwissHub - Selbsttest der Backup-Anlage.
#
#   swisshub-backup-selbsttest [--behalten]
#
# Baut einen WEGWERF-PostgreSQL-Cluster auf, spielt die vollstaendige Kette
# durch - Archivierung, Basis-Backup, Point-in-Time-Recovery, Pruefung - und
# raeumt alles wieder ab.
#
# Er beruehrt NICHTS Produktives: eigenes Datenverzeichnis, eigener Port,
# eigenes Repository, eigene Konfigurationsdatei. Er laesst sich deshalb
# gefahrlos ausfuehren, auch auf dem produktiven Server, und er laeuft ebenso
# in der CI.
#
# ==========================================================================
# WOZU
# ==========================================================================
#
# Die Werkzeuge in diesem Verzeichnis lassen sich nur an einer echten Datenbank
# beweisen. Ein Selbsttest, der einen Cluster anlegt, ihn beschaedigt und auf
# den Zeitpunkt VOR der Beschaedigung zurueckfuehrt, beantwortet die Frage, auf
# die es ankommt: funktioniert Point-in-Time-Recovery hier - auf DIESEM Rechner,
# mit DIESEN Programmversionen?
#
# Das Szenario ist das aus der Aufgabenstellung:
#
#     Um 14:32 wird durch eine fehlerhafte Aktion eine wichtige Tabelle
#     beschaedigt. Die Datenbank soll auf den Zeitpunkt unmittelbar VOR
#     diesem Ereignis zurueckgefuehrt werden.
#
# Der Test macht genau das - nur in Sekunden statt in Stunden.
# ==========================================================================

set -uo pipefail

HIER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="${SWISSHUB_LIB_DIR:-$HIER/../lib}"
VORLAGEN="${SWISSHUB_VORLAGEN_DIR:-$HIER/../vorlagen}"

BEHALTEN='nein'
[[ "${1:-}" == '--behalten' ]] && BEHALTEN='ja'

ARBEIT="${SWISSHUB_SELBSTTEST_DIR:-$(mktemp -d /tmp/swisshub-selbsttest.XXXXXX)}"
PORT="${SWISSHUB_SELBSTTEST_PORT:-55444}"
QUELL_DATA="$ARBEIT/quelle/pgdata"
ZIEL_DATA="$ARBEIT/ziel/pgdata"
REPO="$ARBEIT/repo"
CONF="$ARBEIT/pgbackrest.conf"
STANZA='selbsttest'
DB='swisshub'
# Genau 32 Bytes in base64 - dasselbe Format wie MASTER_ENCRYPTION_KEY.
# AES-256 nimmt nur 32 Bytes; eine Zeichenkette, die 37 ergibt, wird nicht
# stillschweigend gekuerzt, sondern abgelehnt.
MASTER_KEY='c3dpc3NodWItc2VsYnN0dGVzdC1rZXktMzJieXRlcyE='

BESTANDEN=0
GESCHEITERT=0

gruen() { printf '  \033[32m✓\033[0m %s\n' "$1"; BESTANDEN=$(( BESTANDEN + 1 )); }
rot() { printf '  \033[31m✗\033[0m %s\n' "$1"; GESCHEITERT=$(( GESCHEITERT + 1 )); }
schritt() { printf '\n\033[1m%s\033[0m\n' "$1"; }

# Die PostgreSQL-Serverprogramme finden - siehe lib/gemeinsam.sh.
PG_BIN=''
for kandidat in $(ls -d /usr/lib/postgresql/*/bin /usr/pgsql-*/bin 2>/dev/null | sort -rV); do
  [[ -x "$kandidat/pg_ctl" ]] && { PG_BIN="$kandidat"; break; }
done
if [[ -z "$PG_BIN" ]]; then
  kandidat=$(command -v pg_ctl 2>/dev/null) && PG_BIN="$(dirname "$kandidat")"
fi

# Wer den Cluster besitzt. `postgres` weigert sich, als root zu laufen.
BENUTZER="${SWISSHUB_SELBSTTEST_USER:-}"
if [[ -z "$BENUTZER" ]]; then
  if [[ "$(id -u)" -eq 0 ]]; then
    id -u postgres >/dev/null 2>&1 && BENUTZER='postgres' || BENUTZER='nobody'
  else
    BENUTZER="$(id -un)"
  fi
fi

# Ein Befehl als Clusterbenutzer.
als() {
  if [[ "$(id -un)" == "$BENUTZER" ]]; then
    "$@"
  else
    su "$BENUTZER" -s /bin/bash -c "$(printf '%q ' "$@")"
  fi
}

aufraeumen() {
  als "$PG_BIN/pg_ctl" -D "$QUELL_DATA" -m immediate stop >/dev/null 2>&1 || true
  als "$PG_BIN/pg_ctl" -D "$ZIEL_DATA" -m immediate stop >/dev/null 2>&1 || true
  if [[ "$BEHALTEN" == 'ja' ]]; then
    printf '\nArbeitsverzeichnis bleibt liegen: %s\n' "$ARBEIT"
  else
    [[ -n "${ARBEIT:-}" && "$ARBEIT" == /tmp/swisshub-selbsttest.* ]] && rm -rf -- "${ARBEIT:?}"
  fi
}
trap aufraeumen EXIT

psql_quelle() { als "$PG_BIN/psql" -h 127.0.0.1 -p "$PORT" -U "$BENUTZER" -d "${2:-$DB}" -A -t -q -c "$1" 2>&1; }

# Aussen kuerzen, innen nichts anfassen.
#
# `tr -d " "` schien bequem und machte aus dem Zeitstempel
# «2026-09-25 11:19:50+00» das unbrauchbare «2026-09-2511:19:50+00» - pgBackRest
# lehnte ihn ab, und der Fehler sah aus wie ein Fehler der Wiederherstellung.
trimmen() { local wert="$1"; wert="${wert#"${wert%%[![:space:]]*}"}"; printf '%s' "${wert%"${wert##*[![:space:]]}"}"; }
psql_ziel() { als "$PG_BIN/psql" -h 127.0.0.1 -p "$(( PORT + 1 ))" -U "$BENUTZER" -d "${2:-$DB}" -A -t -q -c "$1" 2>&1; }

printf '\033[1mSwissHub - Selbsttest der Backup-Anlage\033[0m\n'
printf 'Arbeitsverzeichnis: %s\n' "$ARBEIT"
printf 'Clusterbenutzer:    %s\n' "$BENUTZER"

# ==========================================================================
schritt '0. Voraussetzungen'
# ==========================================================================

# pgBackRest und Restic kennen kein `--version`, sondern `version`. Der
# Unterschied ist hier kein Schoenheitsfehler: `gruen` zaehlte eine bestandene
# Pruefung, obwohl die Ausgabe eine Fehlermeldung war. Eine Pruefung, die bei
# jeder Antwort gruen wird, prueft nichts.
version_von() {
  case "$1" in
    pgbackrest) pgbackrest version 2>/dev/null ;;
    restic) restic version 2>/dev/null | head -1 ;;
    *) "$1" --version 2>/dev/null | head -1 ;;
  esac
}

for werkzeug in pgbackrest restic age python3; do
  if ! command -v "$werkzeug" >/dev/null 2>&1; then
    rot "$werkzeug fehlt"
    continue
  fi
  fassung=$(version_von "$werkzeug")
  if [[ -n "$fassung" ]]; then
    gruen "$werkzeug: $fassung"
  else
    rot "$werkzeug antwortet nicht auf die Versionsabfrage"
  fi
done
if [[ -n "$PG_BIN" ]]; then
  gruen "PostgreSQL-Programme: $PG_BIN ($("$PG_BIN/postgres" --version 2>&1))"
else
  rot 'PostgreSQL-Serverprogramme (pg_ctl, initdb) nicht gefunden'
  printf '\nOhne sie kann der Selbsttest nichts pruefen.\n'
  exit 1
fi
if python3 -c 'import cryptography' 2>/dev/null; then
  gruen "python3-cryptography vorhanden"
else
  rot 'python3-cryptography fehlt - die Pruefung der Geheimnisse ist damit nicht moeglich'
fi

[[ "$GESCHEITERT" -gt 0 ]] && { printf '\nVoraussetzungen unvollstaendig - Abbruch.\n'; exit 1; }

# ==========================================================================
schritt '1. Wegwerf-Cluster anlegen'
# ==========================================================================

# `log/pgbackrest` ausdruecklich: pgBackRest legt sein Protokollverzeichnis
# nicht selbst an und lief sonst mit einer Warnung ohne Protokoll - womit im
# Fehlerfall genau die Auskunft fehlt, die man braucht.
mkdir -p "$ARBEIT"/{quelle,ziel,repo,spool} "$ARBEIT/log/pgbackrest"
chown -R "$BENUTZER" "$ARBEIT" 2>/dev/null || true
chmod 750 "$ARBEIT"

if als "$PG_BIN/initdb" -D "$QUELL_DATA" --encoding=UTF8 --locale=C -U "$BENUTZER" >/dev/null 2>&1; then
  gruen "Cluster angelegt: $QUELL_DATA"
else
  rot 'initdb ist gescheitert'
  exit 1
fi

# ==========================================================================
schritt '2. pgBackRest konfigurieren und Archivierung einschalten'
# ==========================================================================

# Die Konfiguration aus derselben Vorlage, die auch produktiv verwendet wird -
# nur mit Wegwerfwerten. Ein Selbsttest gegen eine handgeschriebene
# Sonderkonfiguration wuerde die produktive Vorlage nicht pruefen.
CIPHER='selbsttest-nur-zum-pruefen-kein-echtes-geheimnis-4711'
inhalt=$(cat "$VORLAGEN/pgbackrest.conf.vorlage")
inhalt="${inhalt//@PGBACKREST_REPO@/$REPO}"
inhalt="${inhalt//@PGBACKREST_CIPHER_PASS@/$CIPHER}"
inhalt="${inhalt//@BACKUP_ROOT@/$ARBEIT}"
inhalt="${inhalt//@RETENTION_FULL@/2}"
inhalt="${inhalt//@RETENTION_DIFF@/4}"
inhalt="${inhalt//@PGBACKREST_PROCESSES@/1}"
inhalt="${inhalt//@PG_DATA@/$QUELL_DATA}"
inhalt="${inhalt//@PG_PORT@/$PORT}"
inhalt="${inhalt//@PG_USER@/$BENUTZER}"
inhalt="${inhalt//@S3_BLOCK@/# Kein externes Repository im Selbsttest.}"
printf '%s\n' "$inhalt" > "$CONF"
printf '\n[%s]\npg1-path=%s\npg1-port=%s\npg1-user=%s\n' "$STANZA" "$QUELL_DATA" "$PORT" "$BENUTZER" >> "$CONF"
# Der Vorlagenblock nennt die Stanza «swisshub» - im Selbsttest heisst sie
# anders, damit sie auf keinen Fall mit einer produktiven kollidiert.
python3 - "$CONF" "$STANZA" <<'PY'
import sys
pfad, stanza = sys.argv[1], sys.argv[2]
with open(pfad, encoding='utf-8') as datei:
    zeilen = datei.readlines()
ergebnis, im_alten = [], False
for zeile in zeilen:
    if zeile.strip() == '[swisshub]':
        im_alten = True
        continue
    if im_alten:
        if zeile.startswith('[') or zeile.startswith('pg1-'):
            if zeile.startswith('['):
                im_alten = False
            else:
                continue
        elif zeile.strip() == '':
            im_alten = False
    ergebnis.append(zeile)
with open(pfad, 'w', encoding='utf-8') as datei:
    datei.writelines(ergebnis)
PY
chown "$BENUTZER" "$CONF" 2>/dev/null || true
chmod 640 "$CONF"
gruen "pgbackrest.conf aus der produktiven Vorlage erzeugt"

{
  printf "port = %s\n" "$PORT"
  printf "listen_addresses = '127.0.0.1'\n"
  printf "wal_level = replica\n"
  printf "archive_mode = on\n"
  printf "archive_command = '%s/pgbackrest --stanza=%s --config=%s archive-push %%p'\n" \
    "$(dirname "$(command -v pgbackrest)")" "$STANZA" "$CONF"
  # 10 Sekunden statt der produktiven 300: der Selbsttest soll nicht fuenf
  # Minuten auf ein Segment warten. Produktiv sind 300 der richtige Wert.
  printf "archive_timeout = 10\n"
  # Damit `pg_backup_start` nicht auf den naechsten regulaeren Checkpoint
  # wartet.
  printf "checkpoint_timeout = 30\n"
} >> "$QUELL_DATA/postgresql.conf"
gruen 'Archivierung in postgresql.conf eingeschaltet'

if als "$PG_BIN/pg_ctl" -D "$QUELL_DATA" -l "$ARBEIT/quelle.log" -w -t 60 start >/dev/null 2>&1; then
  gruen "Cluster laeuft auf Port $PORT"
else
  rot 'Cluster ist nicht gestartet'
  tail -20 "$ARBEIT/quelle.log" 2>/dev/null
  exit 1
fi

als "$PG_BIN/createdb" -h 127.0.0.1 -p "$PORT" -U "$BENUTZER" "$DB" >/dev/null 2>&1
gruen "Datenbank «$DB» angelegt"

if als pgbackrest --stanza="$STANZA" --config="$CONF" stanza-create >/dev/null 2>&1; then
  gruen 'Stanza angelegt'
else
  rot 'stanza-create ist gescheitert'
  exit 1
fi

# Die Pruefung, die wirklich beantwortet, ob archiviert wird: pgBackRest
# erzwingt einen WAL-Wechsel und wartet, bis die Datei im Repository liegt.
if als pgbackrest --stanza="$STANZA" --config="$CONF" check >/dev/null 2>&1; then
  gruen 'pgbackrest check: die WAL-Archivierung funktioniert wirklich'
else
  rot 'pgbackrest check ist gescheitert - es wird nicht archiviert, also gibt es kein PITR'
  als pgbackrest --stanza="$STANZA" --config="$CONF" check 2>&1 | tail -10
  exit 1
fi

# ==========================================================================
schritt '3. SwissHub-aehnliche Daten anlegen'
# ==========================================================================

# Nachgebaut wird nur, was die Pruefungen von Stufe 6 brauchen: die
# Kerntabellen, die Hash-Kette des Audit Logs und ein echt verschluesseltes
# Geheimnis. Das vollstaendige Prisma-Schema waere fuer diesen Zweck
# unnoetiger Aufwand - und es wuerde Prisma voraussetzen.
psql_quelle "
CREATE TABLE _prisma_migrations (
  id text PRIMARY KEY,
  migration_name text NOT NULL,
  finished_at timestamptz,
  applied_steps_count integer NOT NULL DEFAULT 1
);
CREATE TABLE \"AuditLog\" (
  id text PRIMARY KEY,
  sequence bigserial UNIQUE,
  \"createdAt\" timestamptz NOT NULL DEFAULT now(),
  action text NOT NULL,
  success boolean NOT NULL DEFAULT true,
  metadata jsonb NOT NULL DEFAULT '{}',
  \"previousHash\" text,
  hash text NOT NULL
);
CREATE TABLE \"IntegrationSecret\" (
  id text PRIMARY KEY,
  scope text NOT NULL DEFAULT 'GLOBAL',
  \"guildId\" text NOT NULL DEFAULT '',
  provider text NOT NULL,
  key text NOT NULL,
  ciphertext text NOT NULL
);
CREATE TABLE \"GuildConfig\" (id text PRIMARY KEY, \"guildId\" text, \"setupCompletedAt\" timestamptz);
CREATE TABLE \"RolePermission\" (id text PRIMARY KEY, \"roleId\" text, permission text);
CREATE TABLE \"ModuleState\" (id text PRIMARY KEY, \"moduleId\" text, enabled boolean);
CREATE TABLE \"Session\" (id text PRIMARY KEY, \"userId\" text);
CREATE TABLE \"TicketTranscript\" (id text PRIMARY KEY, \"fileName\" text);
CREATE TABLE \"AppealAttachment\" (id text PRIMARY KEY, \"fileName\" text);
INSERT INTO _prisma_migrations (id, migration_name, finished_at)
  VALUES ('m1','20260101000000_start',now()), ('m2','20260201000000_weiter',now());
INSERT INTO \"GuildConfig\" VALUES ('g1','100000000000000001',now());
INSERT INTO \"RolePermission\" VALUES ('r1','200000000000000001','admin.full');
INSERT INTO \"ModuleState\" VALUES ('m1','jail',true);
" >/dev/null 2>&1

if [[ "$(psql_quelle "SELECT count(*) FROM information_schema.tables WHERE table_schema='public'" | tr -d ' ')" -ge 9 ]]; then
  gruen 'Kerntabellen angelegt'
else
  rot 'Die Tabellen liessen sich nicht anlegen'
  exit 1
fi

# Ein echt verschluesseltes Geheimnis - mit demselben Umschlagformat wie
# packages/secrets/src/crypto.ts. Damit prueft Stufe 6 spaeter eine echte
# Entschluesselung und keine Attrappe.
umschlag=$(SWISSHUB_MASTER_KEY="$MASTER_KEY" python3 - <<'PY'
import base64, hashlib, os, secrets
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

schluessel = base64.b64decode(os.environ['SWISSHUB_MASTER_KEY'])
kennung = hashlib.sha256(schluessel).hexdigest()[:8]
iv = secrets.token_bytes(12)
anhang = '\u0000'.join(['GLOBAL', '', 'discord', 'botToken']).encode('utf-8')
roh = AESGCM(schluessel).encrypt(iv, b'ein-erfundener-bot-token-nur-fuer-den-selbsttest', anhang)
geheimtext, tag = roh[:-16], roh[-16:]

def b64url(werte):
    return base64.urlsafe_b64encode(werte).rstrip(b'=').decode('ascii')

print('.'.join(['v1', kennung, b64url(iv), b64url(tag), b64url(geheimtext)]))
PY
)
if [[ -z "$umschlag" || "$umschlag" != v1.* ]]; then
  rot "Der Umschlag liess sich nicht bilden - der Selbsttest kann die Entschluesselung dann nicht pruefen. Ausgabe: ${umschlag:-leer}"
else
  psql_quelle "INSERT INTO \"IntegrationSecret\" (id,scope,\"guildId\",provider,key,ciphertext)
               VALUES ('s1','GLOBAL','','discord','botToken','$umschlag')" >/dev/null 2>&1
  if [[ "$(trimmen "$(psql_quelle 'SELECT count(*) FROM "IntegrationSecret"' )")" == '1' ]]; then
    gruen "Verschluesseltes Geheimnis angelegt (Umschlag ${umschlag:0:14}...)"
  else
    rot 'Das Geheimnis wurde nicht in die Datenbank geschrieben'
  fi
fi

# Die Hash-Kette des Audit Logs - wie packages/database/src/audit.ts sie baut.
python3 - "$MASTER_KEY" <<'PY' > "$ARBEIT/audit.sql"
import hashlib, sys

vorher = None
zeilen = []
for nummer in range(1, 21):
    nutzlast = 'AKTION_%02d' % nummer
    hash_wert = hashlib.sha256(
        ('%s|%s' % (vorher or 'GENESIS', nutzlast)).encode('utf-8')
    ).hexdigest()
    zeilen.append(
        "INSERT INTO \"AuditLog\" (id, action, \"previousHash\", hash) "
        "VALUES ('a%02d', '%s', %s, '%s');"
        % (nummer, nutzlast, "NULL" if vorher is None else "'%s'" % vorher, hash_wert)
    )
    vorher = hash_wert
print('\n'.join(zeilen))
PY
als "$PG_BIN/psql" -h 127.0.0.1 -p "$PORT" -U "$BENUTZER" -d "$DB" -q -f "$ARBEIT/audit.sql" >/dev/null 2>&1
anzahl=$(psql_quelle 'SELECT count(*) FROM "AuditLog"' | tr -d ' ')
gruen "Audit Log mit $anzahl Zeilen und lueckenloser Hash-Kette"

# ==========================================================================
schritt '4. Basis-Backup'
# ==========================================================================

if als pgbackrest --stanza="$STANZA" --config="$CONF" --type=full backup >/dev/null 2>&1; then
  gruen 'Vollstaendiges Basis-Backup erstellt'
else
  rot 'pgbackrest backup ist gescheitert'
  als pgbackrest --stanza="$STANZA" --config="$CONF" --type=full backup 2>&1 | tail -15
  exit 1
fi

# ==========================================================================
schritt '5. Das Szenario: wichtige Tabelle wird beschaedigt'
# ==========================================================================

# Nach dem Backup noch etwas arbeiten - diese Daten muessen die
# Wiederherstellung ueberleben. Genau das unterscheidet Point-in-Time-Recovery
# von «das Backup zurueckspielen»: dessen Ergebnis waere der Stand von Schritt 4
# und alles danach verloren.
psql_quelle "INSERT INTO \"AuditLog\" (id, action, \"previousHash\", hash)
  SELECT 'nach'||g, 'NACH_BACKUP_'||g, NULL, md5(random()::text)
  FROM generate_series(1,5) g" >/dev/null 2>&1
psql_quelle "CREATE TABLE \"WichtigeTabelle\" (id serial PRIMARY KEY, inhalt text);
  INSERT INTO \"WichtigeTabelle\" (inhalt) SELECT 'wertvoller-datensatz-'||g FROM generate_series(1,100) g" >/dev/null 2>&1

wichtig_vorher=$(psql_quelle 'SELECT count(*) FROM "WichtigeTabelle"' | tr -d ' ')
audit_vorher=$(psql_quelle 'SELECT count(*) FROM "AuditLog"' | tr -d ' ')
gruen "Nach dem Backup entstanden: $wichtig_vorher Datensaetze in WichtigeTabelle, Audit Log jetzt $audit_vorher Zeilen"

# Der Zeitpunkt, auf den zurueckgefuehrt werden soll - das «unmittelbar vor
# 14:32» aus der Aufgabenstellung.
sleep 1
ZIELZEIT=$(trimmen "$(psql_quelle 'SELECT now()')")
printf '  Zielzeitpunkt (unmittelbar vor dem Schaden): %s\n' "$ZIELZEIT"
sleep 2

# Und nun der Schaden.
psql_quelle 'DROP TABLE "WichtigeTabelle"' >/dev/null 2>&1
psql_quelle "DELETE FROM \"AuditLog\" WHERE id LIKE 'nach%'" >/dev/null 2>&1
if [[ "$(psql_quelle "SELECT count(*) FROM information_schema.tables WHERE table_name='WichtigeTabelle'" | tr -d ' ')" == '0' ]]; then
  gruen 'Schaden angerichtet: WichtigeTabelle geloescht, Audit-Zeilen entfernt'
else
  rot 'Der Schaden liess sich nicht anrichten - der Test prueft dann nichts'
fi

# Ein WAL-Wechsel, damit das Segment mit dem Zielzeitpunkt sicher archiviert
# ist. Produktiv erledigt das `archive_timeout`; hier wird nicht gewartet.
psql_quelle 'SELECT pg_switch_wal()' >/dev/null 2>&1
als pgbackrest --stanza="$STANZA" --config="$CONF" check >/dev/null 2>&1
gruen 'WAL-Segment mit dem Zielzeitpunkt ist archiviert'

# ==========================================================================
schritt '6. Point-in-Time-Recovery auf den Zeitpunkt VOR dem Schaden'
# ==========================================================================

# In ein EIGENES Datenverzeichnis, nicht ueber die Quelle. Das ist der Ablauf,
# den die Aufgabenstellung verlangt: die Instanz isoliert wiederherstellen,
# nachsehen, und dann kontrolliert entscheiden - nicht die Produktion
# zuruecksetzen und hoffen.
mkdir -p "$ZIEL_DATA"
chown -R "$BENUTZER" "$ARBEIT/ziel" 2>/dev/null || true
chmod 700 "$ZIEL_DATA"

RESTORE_START=$(date +%s)
# `--archive-mode=off`: ohne das archivierte der wiederhergestellte Cluster in
# dasselbe Repository und legte dort eine neue Zeitlinie an - der Test
# beschaedigte die Sicherung, die er prueft.
if als pgbackrest --stanza="$STANZA" --config="$CONF" \
    --pg1-path="$ZIEL_DATA" --archive-mode=off \
    --type=time --target="$ZIELZEIT" --target-action=promote \
    --log-level-console=warn restore >/dev/null 2>&1; then
  gruen "Wiederherstellung auf $ZIELZEIT ausgefuehrt"
else
  rot 'pgbackrest restore ist gescheitert'
  als pgbackrest --stanza="$STANZA" --config="$CONF" --pg1-path="$ZIEL_DATA" \
    --archive-mode=off --type=time --target="$ZIELZEIT" --target-action=promote restore 2>&1 | tail -15
  exit 1
fi

{
  printf "\nport = %s\n" "$(( PORT + 1 ))"
  printf "listen_addresses = '127.0.0.1'\n"
  printf "archive_mode = off\n"
  printf "archive_command = '/bin/true'\n"
} >> "$ZIEL_DATA/postgresql.auto.conf"

if als "$PG_BIN/pg_ctl" -D "$ZIEL_DATA" -l "$ARBEIT/ziel.log" -w -t 120 start >/dev/null 2>&1; then
  gruen "Wiederhergestellter Cluster laeuft auf Port $(( PORT + 1 ))"
else
  rot 'Der wiederhergestellte Cluster ist nicht gestartet'
  tail -25 "$ARBEIT/ziel.log" 2>/dev/null
  exit 1
fi

# Warten, bis die Wiederherstellung durch ist. Ein Cluster, der noch WAL
# einspielt, antwortet schon - mit einem Stand, der noch nicht das Ziel ist.
grenze=$(( $(date +%s) + 120 ))
while true; do
  zustand=$(psql_ziel 'SELECT pg_is_in_recovery()' postgres | tr -d ' ')
  [[ "$zustand" == 'f' ]] && break
  if [[ "$(date +%s)" -ge "$grenze" ]]; then
    rot 'Die Wiederherstellung war nach zwei Minuten nicht abgeschlossen'
    tail -25 "$ARBEIT/ziel.log" 2>/dev/null
    exit 1
  fi
  sleep 2
done
RESTORE_DAUER=$(( $(date +%s) - RESTORE_START ))
gruen "Wiederherstellung abgeschlossen, Cluster beschreibbar (${RESTORE_DAUER}s)"

# ==========================================================================
schritt '7. Ist der Zeitpunkt wirklich getroffen?'
# ==========================================================================

# Das ist der Kern des ganzen Tests. Drei Aussagen muessen gleichzeitig
# zutreffen, und nur alle drei zusammen belegen PITR:
#
#   a) Die geloeschte Tabelle ist wieder da.       -> der Schaden ist zurueckgenommen
#   b) Sie enthaelt ALLE 100 Datensaetze.          -> nichts nach dem Backup verloren
#   c) Die nach dem Backup entstandenen Audit-Zeilen sind da.
#
# Waere nur (a) erfuellt, haette man das Basis-Backup zurueckgespielt und
# alles danach verloren. Genau diesen Unterschied macht die WAL-Kette.

wieder=$(psql_ziel "SELECT count(*) FROM information_schema.tables WHERE table_name='WichtigeTabelle'" | tr -d ' ')
if [[ "$wieder" == '1' ]]; then
  gruen 'a) Die geloeschte Tabelle WichtigeTabelle existiert wieder'
else
  rot 'a) Die geloeschte Tabelle ist NICHT zurueck - PITR hat nicht funktioniert'
fi

wichtig_nachher=$(psql_ziel 'SELECT count(*) FROM "WichtigeTabelle"' | tr -d ' ')
if [[ "$wichtig_nachher" == "$wichtig_vorher" ]]; then
  gruen "b) Alle $wichtig_nachher Datensaetze sind vorhanden - nach dem Backup entstandene Daten sind NICHT verloren"
else
  rot "b) Es sind $wichtig_nachher von $wichtig_vorher Datensaetzen da - die WAL-Kette wurde nicht vollstaendig eingespielt"
fi

audit_nachher=$(psql_ziel 'SELECT count(*) FROM "AuditLog"' | tr -d ' ')
if [[ "$audit_nachher" == "$audit_vorher" ]]; then
  gruen "c) Audit Log hat $audit_nachher Zeilen wie zum Zielzeitpunkt - auch die geloeschten sind zurueck"
else
  rot "c) Audit Log hat $audit_nachher statt $audit_vorher Zeilen"
fi

# Gegenprobe: der Stand ist NICHT der aktuelle. Ohne sie koennte der Test
# auch dann gruen sein, wenn versehentlich die Quelle geprueft wuerde.
psql_quelle "INSERT INTO \"AuditLog\" (id, action, hash) VALUES ('danach','NACH_ZIELZEIT','x')" >/dev/null 2>&1
danach=$(psql_ziel "SELECT count(*) FROM \"AuditLog\" WHERE id='danach'" | tr -d ' ')
if [[ "$danach" == '0' ]]; then
  gruen 'Gegenprobe: was NACH dem Zielzeitpunkt geschah, fehlt im wiederhergestellten Stand - der Zeitpunkt ist getroffen und nicht nur die Quelle abgefragt'
else
  rot 'Gegenprobe gescheitert: der wiederhergestellte Stand enthaelt Daten von NACH dem Zielzeitpunkt'
fi

# ==========================================================================
schritt '8. Stufe 6: ist es die richtige Datenbank?'
# ==========================================================================

migrationen=$(psql_ziel 'SELECT count(*) FROM _prisma_migrations WHERE finished_at IS NOT NULL' | tr -d ' ')
[[ "$migrationen" == '2' ]] && gruen "Migrationsstand wiederhergestellt: $migrationen Migrationen" \
  || rot "Migrationsstand falsch: $migrationen statt 2"

luecken=$(psql_ziel 'SELECT count(*) FROM (SELECT "previousHash", lag(hash) OVER (ORDER BY sequence) AS vorher FROM "AuditLog" WHERE id LIKE '"'"'a%'"'"') p WHERE vorher IS NOT NULL AND "previousHash" IS DISTINCT FROM vorher' | tr -d ' ')
[[ "$luecken" == '0' ]] && gruen 'Die Hash-Kette des Audit Logs ist nach der Wiederherstellung lueckenlos' \
  || rot "Die Hash-Kette hat $luecken Bruchstelle(n)"

rollen=$(psql_ziel 'SELECT count(*) FROM pg_roles WHERE rolcanlogin' postgres | tr -d ' ')
[[ "${rollen:-0}" -ge 1 ]] && gruen "$rollen anmeldefaehige Rolle(n) im wiederhergestellten Cluster" \
  || rot 'Keine anmeldefaehige Rolle - die Anwendung kaeme nicht herein'

# Die wichtigste Einzelpruefung: laesst sich das Geheimnis mit dem gesicherten
# Schluessel wirklich entschluesseln?
zeilen=$(psql_ziel "SELECT scope||E'\t'||\"guildId\"||E'\t'||provider||E'\t'||key||E'\t'||ciphertext FROM \"IntegrationSecret\"")
ergebnis=$(SWISSHUB_MASTER_KEY="$MASTER_KEY" python3 "$LIB/geheimnis-pruefung.py" <<<"$zeilen" 2>&1)
read -r marke gelesen gescheitert fremd kennung <<< "$ergebnis"
if [[ "$marke" == 'OK' && "${gelesen:-0}" -ge 1 && "${gescheitert:-1}" -eq 0 && "${fremd:-1}" -eq 0 ]]; then
  gruen "Das verschluesselte Geheimnis liess sich mit dem gesicherten Hauptschluessel entschluesseln (Kennung $kennung)"
else
  rot "Die Entschluesselung ist gescheitert: $ergebnis"
fi

# Und die Gegenprobe mit einem FALSCHEN Schluessel. Ohne sie waere unbewiesen,
# dass die Pruefung ueberhaupt etwas prueft.
falsch=$(SWISSHUB_MASTER_KEY="ZmFsc2NoZXItc2VsYnN0dGVzdC1rZXktMzJieXRlcyE=" \
  python3 "$LIB/geheimnis-pruefung.py" <<<"$zeilen" 2>&1)
read -r f_marke _ _ f_fremd _ <<< "$falsch"
if [[ "$f_marke" == 'OK' && "${f_fremd:-0}" -ge 1 ]]; then
  gruen 'Gegenprobe: mit einem falschen Schluessel wird die Abweichung erkannt und nicht stillschweigend als Erfolg verbucht'
else
  rot "Gegenprobe mit falschem Schluessel lieferte Unerwartetes: $falsch"
fi

# ==========================================================================
schritt '9. Restic und das Wiederherstellungspaket'
# ==========================================================================

export RESTIC_PASSWORD='selbsttest-nur-zum-pruefen'
export RESTIC_CACHE_DIR="$ARBEIT/restic-cache"
RESTIC_REPO="$ARBEIT/restic"

mkdir -p "$ARBEIT/dateien/uploads/transcripts"
printf 'Ein Ticket-Verlauf.\n' > "$ARBEIT/dateien/uploads/transcripts/ticket-0001.html"
printf 'Ein Logo.\n' > "$ARBEIT/dateien/uploads/logo-abc123.png"

if restic --repo "$RESTIC_REPO" init >/dev/null 2>&1 \
   && restic --repo "$RESTIC_REPO" backup --tag uploads "$ARBEIT/dateien" >/dev/null 2>&1; then
  gruen 'Restic-Repository angelegt und Dateien gesichert'
else
  rot 'Restic ist gescheitert'
fi

if restic --repo "$RESTIC_REPO" check >/dev/null 2>&1; then
  gruen 'restic check: Repository unbeschaedigt'
else
  rot 'restic check ist gescheitert'
fi

# Die Datei ganz zuruecklesen und Byte fuer Byte vergleichen. «Restore hat
# nicht gemeckert» ist keine Pruefung.
rm -f -- "$ARBEIT/dateien/uploads/logo-abc123.png"
if restic --repo "$RESTIC_REPO" restore latest --target "$ARBEIT/restore-ziel" >/dev/null 2>&1; then
  wieder="$ARBEIT/restore-ziel$ARBEIT/dateien/uploads/logo-abc123.png"
  if [[ -f "$wieder" ]] && grep -q 'Ein Logo' "$wieder"; then
    gruen 'Eine geloeschte Datei wurde aus der Sicherung inhaltsgleich zurueckgeholt'
  else
    rot 'Die zurueckgeholte Datei fehlt oder weicht ab'
  fi
else
  rot 'restic restore ist gescheitert'
fi

# Das Wiederherstellungspaket: verschluesseln auf einen oeffentlichen
# Schluessel, dann mit dem privaten oeffnen - und die Gegenprobe, dass es sich
# OHNE ihn nicht oeffnen laesst.
age-keygen -o "$ARBEIT/recovery.key" >/dev/null 2>&1
empfaenger=$(grep -oE 'age1[a-z0-9]+' "$ARBEIT/recovery.key" | head -1)
if [[ -z "$empfaenger" ]]; then
  empfaenger=$(age-keygen -y "$ARBEIT/recovery.key" 2>/dev/null)
fi

if [[ -n "$empfaenger" ]]; then
  printf 'MASTER_ENCRYPTION_KEY=%s\n' "$MASTER_KEY" > "$ARBEIT/paket-inhalt.txt"
  if tar -cf - -C "$ARBEIT" paket-inhalt.txt 2>/dev/null | age --encrypt -r "$empfaenger" -o "$ARBEIT/paket.tar.age" 2>/dev/null; then
    gruen "Wiederherstellungspaket auf den oeffentlichen Schluessel verschluesselt ($empfaenger)"
  else
    rot 'Das Paket liess sich nicht verschluesseln'
  fi

  if age --decrypt -i "$ARBEIT/recovery.key" "$ARBEIT/paket.tar.age" 2>/dev/null \
     | tar -xO paket-inhalt.txt 2>/dev/null | grep -q "$MASTER_KEY"; then
    gruen 'Das Paket liess sich mit dem privaten Schluessel oeffnen und enthaelt den Hauptschluessel'
  else
    rot 'Das Paket liess sich nicht oeffnen'
  fi

  # Die Gegenprobe, auf der die ganze Anlage beruht: OHNE den privaten
  # Schluessel geht es nicht auf. Genau deshalb kann der produktive Server das
  # Paket schreiben und danach selbst nicht lesen - und genau deshalb bringt es
  # einem Angreifer nichts, der den Server uebernimmt.
  age-keygen -o "$ARBEIT/fremd.key" >/dev/null 2>&1
  if age --decrypt -i "$ARBEIT/fremd.key" "$ARBEIT/paket.tar.age" >/dev/null 2>&1; then
    rot 'Das Paket liess sich mit einem FREMDEN Schluessel oeffnen - die Verschluesselung greift nicht'
  else
    gruen 'Gegenprobe: mit einem fremden Schluessel laesst sich das Paket nicht oeffnen'
  fi
else
  rot 'age-keygen hat keinen Empfaengerschluessel geliefert'
fi

# ==========================================================================
schritt '10. Die Kette prueft sich selbst'
# ==========================================================================

# Stufe 4 aus swisshub-backup-verify: bilden Basis-Backup und WAL-Archiv eine
# lueckenlose Kette? Hier gegen das Selbsttest-Repository.
kette=$(als pgbackrest --stanza="$STANZA" --config="$CONF" --output=json info 2>/dev/null | python3 -c '
import json, sys
try:
    daten = json.load(sys.stdin)
except Exception:
    print("FEHLER"); raise SystemExit
schwer = []
for stanza in daten:
    # Zugeordnet wird ueber database.id - beide Seiten tragen sie. `archive.id`
    # ist die Kennung der Datenbankhistorie («16-1») und NICHT die Zeitlinie.
    spanne = {
        eintrag.get("database", {}).get("id"): (eintrag.get("min"), eintrag.get("max"))
        for eintrag in stanza.get("archive", [])
    }
    for sicherung in stanza.get("backup", []):
        archiv = sicherung.get("archive", {})
        start, stop = archiv.get("start"), archiv.get("stop")
        if not start or not stop:
            schwer.append("%s ohne WAL-Spanne" % sicherung.get("label"))
            continue
        von, bis = spanne.get(sicherung.get("database", {}).get("id"), (None, None))
        if von is None:
            schwer.append("%s: kein WAL-Archiv fuer diese Datenbankhistorie" % sicherung.get("label"))
        elif start < von:
            schwer.append("%s beginnt bei %s, das Archiv erst bei %s" % (sicherung.get("label"), start, von))
        elif bis and stop > bis:
            schwer.append("%s endet bei %s, das Archiv nur bei %s" % (sicherung.get("label"), stop, bis))
print("OK" if not schwer else "LUECKE " + "; ".join(schwer))' 2>/dev/null)

if [[ "$kette" == 'OK' ]]; then
  gruen 'Stufe 4: Basis-Backup und WAL-Archiv bilden eine lueckenlose Kette'
else
  rot "Stufe 4: $kette"
fi

if als pgbackrest --stanza="$STANZA" --config="$CONF" --repo=1 verify >/dev/null 2>&1; then
  gruen 'Stufe 2: pgbackrest verify - alle Pruefsummen im Repository stimmen'
else
  rot 'Stufe 2: pgbackrest verify ist gescheitert'
fi

# Verschluesselung des Repositories belegen, nicht behaupten: der Klartext
# darf in den Repository-Dateien nicht auffindbar sein.
if grep -rqa 'wertvoller-datensatz' "$REPO" 2>/dev/null; then
  rot 'Im Repository stehen Klartextdaten - die Verschluesselung greift nicht'
else
  gruen 'Gegenprobe: im verschluesselten Repository ist kein Klartext der Nutzdaten auffindbar'
fi

# ==========================================================================
printf '\n\033[1m========================================\033[0m\n'
if [[ "$GESCHEITERT" -eq 0 ]]; then
  printf '\033[32mSELBSTTEST BESTANDEN\033[0m  %d Pruefungen\n' "$BESTANDEN"
  printf 'Point-in-Time-Recovery funktioniert auf diesem Rechner.\n'
  printf 'Wiederherstellung des Wegwerf-Clusters: %ds\n' "$RESTORE_DAUER"
  printf '\033[1m========================================\033[0m\n'
  exit 0
fi
printf '\033[31mSELBSTTEST GESCHEITERT\033[0m  %d bestanden, %d fehlerhaft\n' "$BESTANDEN" "$GESCHEITERT"
printf '\033[1m========================================\033[0m\n'
exit 1
