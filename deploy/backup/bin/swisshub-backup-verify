#!/usr/bin/env bash
# SwissHub - Pruefung der Sicherungen, Stufen 1 bis 4.
#
#   swisshub-backup-verify [--tief]
#
# --tief liest zusaetzlich einen Teil der Nutzdaten wirklich (nicht nur
# Pruefsummen der Metadaten). Das kostet Zeit und I/O und gehoert in den
# woechentlichen Lauf, nicht in den taeglichen.
#
# ==========================================================================
# WARUM ES SECHS STUFEN GIBT
# ==========================================================================
#
# Ein abgeschlossener Kopiervorgang ist kein wiederherstellbares Backup. Jede
# Stufe hier beantwortet eine Frage, die die vorige offenlaesst:
#
#   1  Sind die Dateien ueberhaupt da?
#   2  Sind sie unbeschaedigt?              (Pruefsummen, Repository-Struktur)
#   3  Sind sie auch AUSSERHALB da?         (externe Kopie lesbar)
#   4  Bilden sie eine gueltige Kette?      (Basis-Backup + WAL ohne Luecke)
#   5  Laesst sich daraus wirklich eine Datenbank herstellen?  <- restore-test
#   6  Ist die hergestellte Datenbank die richtige?            <- restore-test
#
# Stufe 4 ist die, die am haeufigsten fehlt und am teuersten ist: ein
# Basis-Backup, dessen WAL-Kette eine Luecke hat, laesst sich nicht auf einen
# Zeitpunkt zurueckfuehren. Es sieht in jeder Uebersicht aus wie ein Backup.
#
# Stufen 5 und 6 stehen in swisshub-restore-test, weil sie eine eigene
# isolierte Umgebung brauchen.
# ==========================================================================

set -uo pipefail

HIER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/gemeinsam.sh
source "${SWISSHUB_LIB_DIR:-$HIER/../lib}/gemeinsam.sh"

LOG_KONTEXT='verify'
lade_konfiguration || exit 1
protokoll_eroeffnen 'verify'

TIEF='nein'
[[ "${1:-}" == '--tief' ]] && TIEF='ja'

BEFUNDE=()
FEHLER_ANZAHL=0
WARNUNG_ANZAHL=0

# Ein Befund je Pruefung. Sie landen alle in der Zustandsdatei, damit das
# Dashboard nicht «Integritaet: rot» zeigen muss, sondern sagen kann, welche
# der sechs Stufen gescheitert ist.
befund() {
  local stufe="$1" name="$2" ergebnis="$3" text="$4"
  BEFUNDE+=("$(printf '{"stufe":%s,"name":%s,"ergebnis":%s,"text":%s}' \
    "$stufe" "$(json_text "$name")" "$(json_text "$ergebnis")" "$(json_text "$text")")")
  case "$ergebnis" in
    fehler) FEHLER_ANZAHL=$(( FEHLER_ANZAHL + 1 )); fehler "Stufe $stufe / $name: $text" ;;
    warnung) WARNUNG_ANZAHL=$(( WARNUNG_ANZAHL + 1 )); warnung "Stufe $stufe / $name: $text" ;;
    *) info "Stufe $stufe / $name: $text" ;;
  esac
}

# --------------------------------------------------------------------------
# Stufe 1 - Vollstaendigkeit
# --------------------------------------------------------------------------

stufe1() {
  local pg_info
  pg_info=$(pgbackrest_lauf --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" --output=json info 2>/dev/null || printf '[]')

  local anzahl
  anzahl=$(printf '%s' "$pg_info" | python3 -c '
import json, sys
try:
    daten = json.load(sys.stdin)
except Exception:
    print(0); raise SystemExit
print(sum(len(stanza.get("backup", [])) for stanza in daten))' 2>/dev/null || echo 0)

  if [[ "${anzahl:-0}" -eq 0 ]]; then
    befund 1 'datenbank-vorhanden' 'fehler' 'Im pgBackRest-Repository liegt kein einziges Basis-Backup. Es gibt nichts wiederherzustellen.'
  else
    befund 1 'datenbank-vorhanden' 'erfolg' "$anzahl Basis-Backup(s) im Repository."
  fi

  # Das Alter des jungsten. Ein Repository voller Backups von vor drei Wochen
  # ist kein aktuelles Backup - und das faellt in einer Anzahl nicht auf.
  local jungster
  jungster=$(printf '%s' "$pg_info" | python3 -c '
import json, sys
try:
    daten = json.load(sys.stdin)
except Exception:
    print(0); raise SystemExit
zeiten = [
    sicherung.get("timestamp", {}).get("stop", 0)
    for stanza in daten
    for sicherung in stanza.get("backup", [])
]
print(max(zeiten) if zeiten else 0)' 2>/dev/null || echo 0)

  if [[ "${jungster:-0}" -gt 0 ]]; then
    local alter=$(( ( $(date +%s) - jungster ) / 3600 ))
    if [[ "$alter" -gt 48 ]]; then
      befund 1 'datenbank-alter' 'fehler' "Das jungste Basis-Backup ist ${alter} Stunden alt. Bei stuendlichen und taeglichen Laeufen darf es nicht so alt sein - es laeuft etwas nicht."
    elif [[ "$alter" -gt 26 ]]; then
      befund 1 'datenbank-alter' 'warnung' "Das jungste Basis-Backup ist ${alter} Stunden alt."
    else
      befund 1 'datenbank-alter' 'erfolg' "Jungstes Basis-Backup ist ${alter} Stunden alt."
    fi
  fi

  # Restic.
  restic_umgebung
  if ! restic_lokal cat config >/dev/null 2>&1; then
    befund 1 'dateien-repository' 'fehler' 'Das Restic-Repository ist nicht lesbar. Uploads und Konfiguration sind damit nicht wiederherstellbar.'
    return
  fi

  local snapshots
  snapshots=$(restic_lokal snapshots --json 2>/dev/null || printf '[]')
  local uploads_alter
  uploads_alter=$(printf '%s' "$snapshots" | python3 -c '
import datetime, json, sys
try:
    daten = json.load(sys.stdin)
except Exception:
    print(-1); raise SystemExit
zeiten = []
for snapshot in daten:
    if "uploads" not in (snapshot.get("tags") or []):
        continue
    roh = (snapshot.get("time") or "").replace("Z", "+00:00")
    try:
        zeiten.append(datetime.datetime.fromisoformat(roh))
    except ValueError:
        continue
if not zeiten:
    print(-1)
else:
    jetzt = datetime.datetime.now(datetime.timezone.utc)
    print(int((jetzt - max(zeiten)).total_seconds() // 60))' 2>/dev/null || echo -1)

  if [[ "${uploads_alter:-−1}" -lt 0 ]]; then
    befund 1 'dateien-vorhanden' 'fehler' 'Es gibt keinen Snapshot der Uploads. Die Datenbank verweist auf Dateien, die in keiner Sicherung stehen.'
  elif [[ "$uploads_alter" -gt 180 ]]; then
    befund 1 'dateien-vorhanden' 'fehler' "Der jungste Upload-Snapshot ist ${uploads_alter} Minuten alt. Angestrebt ist maximal eine Stunde."
  elif [[ "$uploads_alter" -gt 90 ]]; then
    befund 1 'dateien-vorhanden' 'warnung' "Der jungste Upload-Snapshot ist ${uploads_alter} Minuten alt."
  else
    befund 1 'dateien-vorhanden' 'erfolg' "Jungster Upload-Snapshot ist ${uploads_alter} Minuten alt."
  fi

  # Das Wiederherstellungspaket. Ohne es ist alles andere unvollstaendig.
  local paket
  paket=$(find "$SWISSHUB_BACKUP_ROOT/recovery" -maxdepth 1 -name 'swisshub-recovery-*.tar.age' -printf '%T@\n' 2>/dev/null | sort -rn | head -1 | cut -d. -f1)
  if [[ -z "$paket" ]]; then
    befund 1 'recovery-paket' 'fehler' 'Es gibt kein Wiederherstellungspaket. Der MASTER_ENCRYPTION_KEY liegt damit nur auf diesem Server - nach seinem Verlust sind die verschluesselten Zugangsdaten in der Datenbanksicherung dauerhaft unlesbar.'
  else
    local paket_alter=$(( ( $(date +%s) - paket ) / 86400 ))
    if [[ "$paket_alter" -gt 8 ]]; then
      befund 1 'recovery-paket' 'warnung' "Das jungste Wiederherstellungspaket ist ${paket_alter} Tage alt. Aenderungen an der .env seither sind darin nicht enthalten."
    else
      befund 1 'recovery-paket' 'erfolg' "Wiederherstellungspaket ist ${paket_alter} Tage alt."
    fi
  fi
}

# --------------------------------------------------------------------------
# Stufe 2 - Integritaet
# --------------------------------------------------------------------------

stufe2() {
  # pgBackRest `verify` liest die Pruefsummen jeder Datei im Repository. Das
  # ist die Pruefung, die stille Bitfehler findet - und stille Bitfehler sind
  # genau die Art Schaden, die bis zum Ernstfall unbemerkt bleibt.
  if pgbackrest_lauf --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" --repo=1 verify >/dev/null 2>&1; then
    befund 2 'pgbackrest-verify' 'erfolg' 'Alle Pruefsummen im lokalen pgBackRest-Repository stimmen.'
  else
    befund 2 'pgbackrest-verify' 'fehler' 'pgbackrest verify ist gescheitert - im lokalen Repository stimmt eine Pruefsumme nicht. Mindestens eine Sicherung ist beschaedigt.'
  fi

  restic_umgebung
  local args=(check --no-lock)
  if [[ "$TIEF" == 'ja' ]]; then
    # Fuenf Prozent der Nutzdaten wirklich lesen und gegen die Pruefsummen
    # halten. `check` ohne das prueft nur die Struktur - ein beschaedigter
    # Datenblock faellt dabei nicht auf.
    args+=(--read-data-subset=5%)
  fi
  if restic_lokal "${args[@]}" >/dev/null 2>&1; then
    befund 2 'restic-check' 'erfolg' "Restic-Repository unbeschaedigt${TIEF:+ (mit Stichprobe der Nutzdaten)}."
  else
    befund 2 'restic-check' 'fehler' 'restic check ist gescheitert - das Dateirepository ist beschaedigt. Es wird deshalb nichts daraus geloescht.'
  fi

  # Die Pruefsummen der logischen Exporte.
  local pruefdatei
  pruefdatei=$(find "$SWISSHUB_BACKUP_ROOT/logisch" -maxdepth 1 -name 'pruefsummen-*.sha256' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
  if [[ -n "$pruefdatei" ]]; then
    if ( cd "$SWISSHUB_BACKUP_ROOT/logisch" && sha256sum --check --status "$(basename "$pruefdatei")" ); then
      befund 2 'logisch-pruefsummen' 'erfolg' 'Pruefsummen des jungsten logischen Exports stimmen.'
    else
      befund 2 'logisch-pruefsummen' 'fehler' 'Die Pruefsummen des logischen Exports stimmen nicht - er ist beschaedigt.'
    fi
  fi
}

# --------------------------------------------------------------------------
# Stufe 3 - die externe Kopie
# --------------------------------------------------------------------------

stufe3() {
  if ! hat_externes_ziel; then
    befund 3 'extern-vorhanden' 'fehler' 'Es ist kein externes Ziel konfiguriert. Alle Kopien liegen auf dem Server, der gesichert wird. Gegen seinen Verlust - den haeufigsten Ernstfall - schuetzt das nicht.'
    return
  fi

  if pgbackrest_lauf --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" --repo=2 info >/dev/null 2>&1; then
    befund 3 'extern-pgbackrest' 'erfolg' 'Das externe pgBackRest-Repository ist erreichbar und lesbar.'
  else
    befund 3 'extern-pgbackrest' 'fehler' 'Das externe pgBackRest-Repository ist nicht lesbar. Die Datenbanksicherung liegt nur lokal.'
  fi

  restic_umgebung
  export AWS_ACCESS_KEY_ID="$SWISSHUB_S3_WRITE_KEY_ID"
  export AWS_SECRET_ACCESS_KEY="$SWISSHUB_S3_WRITE_SECRET"
  [[ -n "$SWISSHUB_S3_REGION" ]] && export AWS_DEFAULT_REGION="$SWISSHUB_S3_REGION"
  local extern="s3:${SWISSHUB_S3_ENDPOINT%/}/${SWISSHUB_S3_BUCKET}/restic"

  local extern_snapshots
  extern_snapshots=$(restic --repo "$extern" snapshots --json --no-lock 2>/dev/null || printf '')
  if [[ -z "$extern_snapshots" ]]; then
    befund 3 'extern-restic' 'fehler' 'Das externe Restic-Repository ist nicht lesbar. Uploads liegen nur lokal.'
    return
  fi

  # Lokal und extern vergleichen.
  #
  # «Erreichbar» genuegt nicht: ein Repository, in dem der jungste Snapshot
  # von vorletzter Woche ist, ist erreichbar und trotzdem veraltet. Verglichen
  # wird die Zahl der Snapshots und das Alter des jungsten.
  local lokal_anzahl extern_anzahl extern_alter
  lokal_anzahl=$(restic_lokal snapshots --json --no-lock 2>/dev/null | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo 0)
  extern_anzahl=$(printf '%s' "$extern_snapshots" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo 0)
  extern_alter=$(printf '%s' "$extern_snapshots" | python3 -c '
import datetime, json, sys
daten = json.load(sys.stdin)
zeiten = []
for snapshot in daten:
    roh = (snapshot.get("time") or "").replace("Z", "+00:00")
    try:
        zeiten.append(datetime.datetime.fromisoformat(roh))
    except ValueError:
        continue
if not zeiten:
    print(-1)
else:
    print(int((datetime.datetime.now(datetime.timezone.utc) - max(zeiten)).total_seconds() // 60))' 2>/dev/null || echo -1)

  if [[ "${extern_alter:-−1}" -lt 0 || "${extern_alter}" -gt 1500 ]]; then
    befund 3 'extern-aktualitaet' 'fehler' "Der jungste externe Snapshot ist ${extern_alter} Minuten alt. Die externe Kopie haengt zurueck - der Datenverlust bei Serververlust ist so gross wie dieser Abstand."
  elif [[ "$extern_alter" -gt 180 ]]; then
    befund 3 'extern-aktualitaet' 'warnung' "Der jungste externe Snapshot ist ${extern_alter} Minuten alt."
  else
    befund 3 'extern-aktualitaet' 'erfolg' "Externe Kopie ist ${extern_alter} Minuten alt, ${extern_anzahl} von ${lokal_anzahl} Snapshots uebertragen."
  fi

  # Unveraenderbarkeit.
  #
  # Ob Object Lock wirklich greift, laesst sich nicht behaupten - es laesst
  # sich pruefen, und zwar auf die einzige ehrliche Weise: einen Loeschversuch
  # unternehmen und feststellen, dass er scheitert.
  stufe3_unveraenderbarkeit
}

# Der Loeschversuch, der scheitern MUSS.
#
# Das ist die einzige Pruefung, die «unveraenderbar» belegt statt zu behaupten.
# Geschrieben wird eine eigene Probedatei - niemals an einem echten Objekt
# versucht.
#
# Zwei Ergebnisse sind richtig, und nur eines ist falsch:
#   - Loeschen scheitert  -> Object Lock greift.
#   - Loeschen klappt     -> Object Lock greift NICHT, und die Historie ist
#                            genauso loeschbar wie alles andere. Ein Angreifer
#                            mit diesem Server koennte sie vernichten.
stufe3_unveraenderbarkeit() {
  if ! command -v aws >/dev/null 2>&1; then
    befund 3 'unveraenderbarkeit' 'warnung' 'Die aws-CLI ist nicht installiert - der Loeschversuch, der Object Lock belegt, konnte nicht durchgefuehrt werden. Ohne diese Pruefung ist «unveraenderbar» eine Annahme. Installieren: apt install awscli.'
    return
  fi

  local probe="verify/object-lock-probe-$(date +%s).txt"
  local temp
  temp=$(mktemp) || return
  printf 'SwissHub Object-Lock-Probe %s\n' "$(date --iso-8601=seconds)" > "$temp"

  AWS_ACCESS_KEY_ID="$SWISSHUB_S3_WRITE_KEY_ID" \
  AWS_SECRET_ACCESS_KEY="$SWISSHUB_S3_WRITE_SECRET" \
  AWS_DEFAULT_REGION="${SWISSHUB_S3_REGION:-us-east-1}" \
    aws --endpoint-url "$SWISSHUB_S3_ENDPOINT" s3 cp "$temp" \
      "s3://$SWISSHUB_S3_BUCKET/$probe" >/dev/null 2>&1
  local hochgeladen=$?
  rm -f -- "$temp"

  if [[ $hochgeladen -ne 0 ]]; then
    befund 3 'unveraenderbarkeit' 'fehler' 'Die Probedatei liess sich nicht hochladen - die schreibenden Zugangsdaten funktionieren nicht. Dann funktioniert auch die externe Sicherung nicht.'
    return
  fi

  # Jetzt der Loeschversuch mit denselben Zugangsdaten, die der Server hat.
  if AWS_ACCESS_KEY_ID="$SWISSHUB_S3_WRITE_KEY_ID" \
     AWS_SECRET_ACCESS_KEY="$SWISSHUB_S3_WRITE_SECRET" \
     AWS_DEFAULT_REGION="${SWISSHUB_S3_REGION:-us-east-1}" \
       aws --endpoint-url "$SWISSHUB_S3_ENDPOINT" s3api delete-object \
         --bucket "$SWISSHUB_S3_BUCKET" --key "$probe" >/dev/null 2>&1; then
    # Ein `delete-object` auf einem versionierten Bucket setzt nur eine
    # Loeschmarkierung; die Fassung selbst bleibt. Deshalb wird zusaetzlich
    # geprueft, ob sie wirklich weg ist.
    if AWS_ACCESS_KEY_ID="$SWISSHUB_S3_WRITE_KEY_ID" \
       AWS_SECRET_ACCESS_KEY="$SWISSHUB_S3_WRITE_SECRET" \
       AWS_DEFAULT_REGION="${SWISSHUB_S3_REGION:-us-east-1}" \
         aws --endpoint-url "$SWISSHUB_S3_ENDPOINT" s3api list-object-versions \
           --bucket "$SWISSHUB_S3_BUCKET" --prefix "$probe" 2>/dev/null | grep -q '"VersionId"'; then
      befund 3 'unveraenderbarkeit' 'erfolg' 'Loeschen setzt nur eine Loeschmarkierung; die Fassung bleibt erhalten (versionierter Bucket). Die Historie ist mit den Zugangsdaten dieses Servers nicht zu vernichten.'
    else
      befund 3 'unveraenderbarkeit' 'fehler' 'Die Probedatei liess sich mit den Zugangsdaten DIESES SERVERS restlos loeschen. Object Lock greift nicht. Wer diesen Server uebernimmt, kann die gesamte externe Backup-Historie vernichten - siehe deploy/backup/vorlagen/s3-richtlinien.md.'
    fi
  else
    befund 3 'unveraenderbarkeit' 'erfolg' 'Der Loeschversuch mit den Zugangsdaten dieses Servers wurde abgelehnt. Object Lock beziehungsweise die Richtlinie greift.'
  fi
}

# --------------------------------------------------------------------------
# Stufe 4 - die Kette
# --------------------------------------------------------------------------

# Bilden Basis-Backup und WAL-Archiv eine Kette ohne Luecke?
#
# Das ist die Pruefung, die am haeufigsten fehlt. Ein Basis-Backup allein
# stellt den Zeitpunkt seines eigenen Endes her. Jeden anderen Zeitpunkt
# erreicht man nur, wenn die WAL-Segmente von diesem Backup bis zum Ziel
# LUECKENLOS vorliegen. Fehlt eines in der Mitte, endet die Wiederherstellung
# dort - und zwar ohne dass die Uebersicht vorher etwas gesagt haette.
stufe4() {
  local pg_info
  pg_info=$(pgbackrest_lauf --stanza="$PGBACKREST_STANZA" --config="$PGBACKREST_CONF" --output=json info 2>/dev/null || printf '[]')

  local bericht
  bericht=$(printf '%s' "$pg_info" | python3 - <<'PY' 2>/dev/null || printf '{}'
import json, sys

try:
    daten = json.load(sys.stdin)
except Exception:
    print(json.dumps({"fehler": "pgbackrest info war nicht lesbar"}))
    raise SystemExit

meldungen = []
schwer = []
spanne = {}

for stanza in daten:
    zustand = stanza.get("status", {})
    if zustand.get("code", 0) != 0:
        schwer.append("pgBackRest meldet fuer die Stanza: %s" % zustand.get("message", "?"))

    sicherungen = stanza.get("backup", [])
    archive = stanza.get("archive", [])

    # Die Spanne des Archivs je Datenbankhistorie.
    #
    # Geschluessselt wird mit `database.id`, weil Sicherung und Archiveintrag
    # beide diese Kennung tragen. `archive.id` ist die Historienkennung im
    # Format «<version>-<db-id>» (etwa «16-1») und ausdruecklich NICHT die
    # Zeitlinie - wer sie mit den ersten acht Zeichen eines WAL-Namens
    # vergleicht, findet nie eine Uebereinstimmung und meldet dann eine
    # unterbrochene Kette, obwohl sie vollstaendig ist. Ein Fehlalarm an dieser
    # Stelle ist besonders teuer: er entwertet jede weitere Meldung.
    for eintrag in archive:
        spanne[eintrag.get("database", {}).get("id")] = {
            "von": eintrag.get("min"),
            "bis": eintrag.get("max"),
        }

    for sicherung in sicherungen:
        label = sicherung.get("label", "?")
        archiv = sicherung.get("archive", {})
        start, stop = archiv.get("start"), archiv.get("stop")
        if not start or not stop:
            schwer.append(
                "Sicherung %s nennt keine WAL-Spanne - sie ist nicht auf einen "
                "Zeitpunkt zurueckfuehrbar." % label
            )
            continue

        historie = sicherung.get("database", {}).get("id")
        vorhanden = spanne.get(historie)
        if not vorhanden:
            schwer.append(
                "Fuer Sicherung %s (Datenbankhistorie %s) liegt kein WAL-Archiv "
                "vor. Sie stellt nur ihren eigenen Endzeitpunkt her, keinen "
                "anderen." % (label, historie)
            )
            continue

        # Deckt das Archiv den Bereich der Sicherung ab? Verglichen wird
        # lexikografisch - WAL-Dateinamen sind dafuer gebaut.
        if vorhanden["von"] and start < vorhanden["von"]:
            schwer.append(
                "Sicherung %s beginnt bei WAL %s, das Archiv erst bei %s. Der "
                "Anfang der Kette fehlt - diese Sicherung ist nicht "
                "wiederherstellbar." % (label, start, vorhanden["von"])
            )
        elif vorhanden["bis"] and stop > vorhanden["bis"]:
            schwer.append(
                "Sicherung %s endet bei WAL %s, das Archiv nur bei %s. Die "
                "Sicherung ist unvollstaendig archiviert." % (label, stop, vorhanden["bis"])
            )
        else:
            meldungen.append("Sicherung %s: WAL %s..%s liegt vollstaendig vor." % (label, start, stop))

# Die erreichbare Spanne: vom Ende des aeltesten Basis-Backups bis zum
# jungsten archivierten WAL. Das ist der Bereich, in dem ein Zeitpunkt
# tatsaechlich ansteuerbar ist - und die Zahl, die das Dashboard zeigen soll.
print(json.dumps({
    "in_ordnung": meldungen,
    "schwer": schwer,
    "archiv_spanne": spanne,
}))
PY
)

  local schwer_anzahl
  schwer_anzahl=$(printf '%s' "$bericht" | python3 -c 'import json,sys; print(len(json.load(sys.stdin).get("schwer",[])))' 2>/dev/null || echo 1)

  if [[ "${schwer_anzahl:-1}" -eq 0 ]]; then
    local ok_anzahl
    ok_anzahl=$(printf '%s' "$bericht" | python3 -c 'import json,sys; print(len(json.load(sys.stdin).get("in_ordnung",[])))' 2>/dev/null || echo 0)
    befund 4 'wal-kette' 'erfolg' "Alle $ok_anzahl Basis-Backups haben eine lueckenlose WAL-Kette. Point-in-Time-Recovery ist moeglich."
  else
    local texte
    texte=$(printf '%s' "$bericht" | python3 -c 'import json,sys; print(" | ".join(json.load(sys.stdin).get("schwer",[])))' 2>/dev/null)
    befund 4 'wal-kette' 'fehler' "${texte:-Die WAL-Kette ist nicht pruefbar.}"
  fi

  # Der Bezug zwischen Dateien und Datenbank.
  #
  # Geprueft wird die Regel, auf der die Konsistenz beruht: zu jedem
  # Datenbankzeitpunkt muss es einen Datei-Snapshot geben, der NICHT AELTER
  # ist. Andernfalls verweist die wiederhergestellte Datenbank auf Dateien,
  # die in keiner Sicherung stehen.
  restic_umgebung
  local bezug
  bezug=$(restic_lokal snapshots --json --no-lock 2>/dev/null | python3 - "$(zustand_lesen 'wiederherstellungspunkte')" <<'PY' 2>/dev/null || printf 'unbekannt'
import datetime, json, sys

def zeit(roh):
    if not roh:
        return None
    try:
        return datetime.datetime.fromisoformat(roh.replace("Z", "+00:00"))
    except ValueError:
        return None

try:
    snapshots = json.load(sys.stdin)
except Exception:
    print("unbekannt")
    raise SystemExit

try:
    punkte = json.loads(sys.argv[1]).get("punkte", [])
except Exception:
    punkte = []

datei_zeiten = sorted(
    filter(None, (zeit(s.get("time")) for s in snapshots if "uploads" in (s.get("tags") or [])))
)
if not datei_zeiten:
    print("keine-dateisicherung")
    raise SystemExit

# Der jungste Datenbankzeitpunkt, fuer den es KEINE gleich alte oder juengere
# Dateisicherung gibt.
ohne = []
for punkt in punkte:
    if punkt.get("art") != "datenbank":
        continue
    ende = zeit(punkt.get("ende"))
    if ende is None:
        continue
    if not any(datei >= ende for datei in datei_zeiten):
        ohne.append(punkt.get("kennung"))

if ohne:
    print("ohne-passende-dateien:" + ",".join(filter(None, ohne[:3])))
else:
    print("stimmig")
PY
)

  case "$bezug" in
    stimmig)
      befund 4 'datei-datenbank-bezug' 'erfolg' 'Zu jedem Datenbank-Wiederherstellungspunkt gibt es eine gleich alte oder juengere Dateisicherung. Datenbank und Uploads sind konsistent wiederherstellbar.' ;;
    keine-dateisicherung)
      befund 4 'datei-datenbank-bezug' 'fehler' 'Es gibt keine Dateisicherung. Jede wiederhergestellte Datenbank wuerde auf Uploads verweisen, die nicht existieren.' ;;
    ohne-passende-dateien:*)
      befund 4 'datei-datenbank-bezug' 'warnung' "Fuer diese Wiederherstellungspunkte gibt es keine gleich alte oder juengere Dateisicherung: ${bezug#ohne-passende-dateien:}. Eine Wiederherstellung auf sie hinterlaesst Verweise auf fehlende Dateien. Der jungste Punkt ist normalerweise betroffen, solange der naechste Dateilauf noch aussteht." ;;
    *)
      befund 4 'datei-datenbank-bezug' 'warnung' 'Der Bezug zwischen Dateien und Datenbank war nicht pruefbar.' ;;
  esac
}

# --------------------------------------------------------------------------

sperre_oder_raus 'verify' 30 || exit 0

info "Pruefung beginnt${TIEF:+ (tief)}."
START=$(date +%s)

stufe1
stufe2
stufe3
stufe4

DAUER=$(( $(date +%s) - START ))

# Stufen 5 und 6 kommen aus dem Restore-Test - hier wird nur weitergegeben,
# wie alt sein Ergebnis ist. Ein Restore-Test von vor drei Wochen ist kein
# Nachweis fuer die Sicherung von heute.
RESTORE_TEST=$(zustand_lesen 'restore-test')

GESAMT='erfolg'
[[ "$WARNUNG_ANZAHL" -gt 0 ]] && GESAMT='warnung'
[[ "$FEHLER_ANZAHL" -gt 0 ]] && GESAMT='fehler'

zustand_schreiben 'verify' "$(printf \
  '{"zeit":%s,"tief":%s,"dauer_s":%s,"gesamt":%s,"fehler":%s,"warnungen":%s,"befunde":[%s]}' \
  "$(json_text "$(date --iso-8601=seconds)")" "$(json_text "$TIEF")" "$DAUER" \
  "$(json_text "$GESAMT")" "$FEHLER_ANZAHL" "$WARNUNG_ANZAHL" \
  "$(IFS=,; printf '%s' "${BEFUNDE[*]}")")"

verlauf_anhaengen 'laeufe' "$(printf '{"id":%s,"art":"verify","status":%s,"beginn":%s,"dauer_s":%s,"bytes":0,"ziel":"lokal","meldung":%s}' \
  "$(json_text "$(date +%Y%m%dT%H%M%S)-$$")" "$(json_text "$([[ "$GESAMT" == 'fehler' ]] && echo fehler || echo erfolg)")" \
  "$(json_text "$(date -d "@$START" --iso-8601=seconds)")" "$DAUER" \
  "$(json_text "$FEHLER_ANZAHL Fehler, $WARNUNG_ANZAHL Warnungen")")"

if [[ "$FEHLER_ANZAHL" -gt 0 ]]; then
  alarm kritisch 'verify' "Die Pruefung der Sicherungen hat $FEHLER_ANZAHL Fehler gefunden. Einzelheiten unter System -> Backup & Recovery oder in $PROTOKOLL_DATEI."
  exit 1
fi
if [[ "$WARNUNG_ANZAHL" -gt 0 ]]; then
  alarm warnung 'verify' "Die Pruefung der Sicherungen hat $WARNUNG_ANZAHL Warnungen ergeben."
  exit 0
fi
alarm_entwarnung 'verify' 'alle Pruefstufen 1 bis 4 wieder in Ordnung'
info "Pruefung abgeschlossen: alles in Ordnung (${DAUER}s)."
exit 0
