[Unit]
Description=SwissHub Backup-Controller Reissleine

[Timer]
Unit=swisshub-backup-controller.service
# Jede Minute. Fast immer ohne Arbeit - und genau dann wertvoll, wenn die
# Pfadbeobachtung eine Anforderung verpasst hat.
OnCalendar=*:*:00
AccuracySec=15s
Persistent=false

[Install]
WantedBy=timers.target
