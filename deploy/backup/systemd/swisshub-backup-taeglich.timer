# Der taegliche Durchgang: differentielles Basis-Backup, logischer Export,
# Dateien, Konfiguration, Wiederherstellungspaket, extern, Aufbewahrung.

[Unit]
Description=SwissHub Sicherung taeglich
Documentation=file:///opt/swisshub/docs/BACKUP.md

[Timer]
Unit=swisshub-backup@taeglich.service
# 03:17 - in der ruhigsten Stunde, und auf einer Minute, die kein anderer
# Zeitplan benutzt. 03:00 waere die Stunde, in der auch logrotate,
# certbot.timer und apt-daily-upgrade anlaufen.
OnCalendar=*-*-* 03:17:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
