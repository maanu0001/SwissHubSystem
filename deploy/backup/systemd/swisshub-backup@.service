# SwissHub - ein Backup-Durchgang.
#
# Instanziiert: swisshub-backup@stuendlich, @taeglich, @woechentlich.
# Eine Unit statt drei, weil sich alles ausser dem Argument gleicht - und drei
# fast gleiche Units laufen mit der Zeit auseinander.
#
#   systemctl start swisshub-backup@taeglich
#   journalctl -u swisshub-backup@taeglich -f

[Unit]
Description=SwissHub Sicherung (%i)
Documentation=file:///opt/swisshub/docs/BACKUP.md
# `After` und nicht `Requires`: laeuft PostgreSQL nicht, soll der Lauf trotzdem
# starten und mit einer verstaendlichen Meldung scheitern - statt still
# uebersprungen zu werden. Ein uebersprungener Backup-Lauf ist genau der
# Fehlschlag, den niemand bemerkt.
After=network-online.target docker.service postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=swisshub-backup
Group=swisshub-backup
# Der Datenbankzugriff braucht die Gruppe von PostgreSQL bzw. des
# Docker-Sockets. Welche das sind, setzt install.sh ein.
SupplementaryGroups=postgres docker

ExecStart=/usr/local/lib/swisshub-backup/bin/swisshub-backup %i

# --- Ressourcen ---------------------------------------------------------
#
# Der produktive Discord-Bot laeuft daneben. Eine Sicherung, die ihn
# ausbremst, wird abgeschaltet - und eine abgeschaltete Sicherung ist keine.
#
# `IOWeight` und `CPUWeight` sind Gewichtungen, keine Obergrenzen: solange
# nichts anderes will, darf die Sicherung die ganze Maschine nutzen. Erst wenn
# Bot oder WebApp etwas brauchen, tritt sie zurueck. Das ist genau das
# gewuenschte Verhalten - eine harte Grenze machte die Sicherung auch auf einem
# leerlaufenden Server langsam.
IOWeight=20
CPUWeight=20
# `idle` heisst: nur wenn sonst niemand will.
IOSchedulingClass=idle
Nice=10

# Speicher begrenzen, damit ein Fehler in der Kompression nicht den Bot
# verdraengt. pgBackRest mit einem Prozess braucht deutlich weniger.
MemoryMax=1G
MemoryHigh=768M

# Kein Lauf laeuft ewig. Die Werkzeuge haben eigene Zeitgrenzen; das hier ist
# die aeussere Reissleine.
TimeoutStartSec=6h

# --- Haertung ------------------------------------------------------------
#
# Der Dienst liest Datenbankdateien und schreibt in sein Repository. Alles
# uebrige braucht er nicht, und was er nicht braucht, soll er nicht koennen.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# Ausdruecklich beschreibbar: nur das Backup-Verzeichnis.
ReadWritePaths=/var/lib/swisshub-backup
# Lesend: Konfiguration, Projekt, Uploads, Datenverzeichnis.
ReadOnlyPaths=/etc/swisshub-backup /opt/swisshub

[Install]
WantedBy=multi-user.target
