# SwissHub - Restore-Test in einer isolierten Umgebung (Stufen 5 und 6).
#
# Der einzige Nachweis, der zaehlt. Alles andere prueft, ob Dateien da sind;
# das hier prueft, ob daraus eine Datenbank wird.

[Unit]
Description=SwissHub Restore-Test
Documentation=file:///opt/swisshub/docs/BACKUP.md
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
# Ausnahmsweise root, und der Grund gehoert hierher: der Test legt einen
# PostgreSQL-Cluster an, startet ihn unter dem PostgreSQL-Systembenutzer und
# entfernt ihn wieder. Dafuer braucht es einen Benutzerwechsel, und den kann
# nur root.
#
# Der Test fuehrt dabei NICHTS aus der WebApp aus und nichts aus einer
# Anforderung: die Argumente stehen in dieser Unit bzw. kommen aus dem
# Controller, der sie gegen eine feste Liste prueft.
ExecStart=/usr/local/lib/swisshub-backup/bin/swisshub-restore-test

IOWeight=20
CPUWeight=20
IOSchedulingClass=idle
Nice=10
# Ein Restore braucht mehr Speicher als eine Sicherung: PostgreSQL faehrt
# hoch und spielt WAL ein.
MemoryMax=2G
TimeoutStartSec=4h

NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
RestrictSUIDSGID=false
