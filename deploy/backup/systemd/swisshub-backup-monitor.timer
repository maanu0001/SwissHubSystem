[Unit]
Description=SwissHub Backup-Ueberwachung alle 15 Minuten

[Timer]
Unit=swisshub-backup-monitor.service
# Alle 15 Minuten. Haeufiger waere Laerm, seltener hiesse, eine gerissene
# WAL-Kette erst nach einer halben Stunde zu bemerken - und in dieser halben
# Stunde laeuft pg_wal weiter voll.
#
# Dieser Lauf ist auch der, der den Totmannschalter pingt. Der externe Dienst
# ist deshalb auf eine Erwartung von etwa einer Stunde einzustellen: drei
# ausgefallene Laeufe sind ein Befund, einer ist ein Aussetzer.
OnCalendar=*:00/15
RandomizedDelaySec=2min
Persistent=false

[Install]
WantedBy=timers.target
