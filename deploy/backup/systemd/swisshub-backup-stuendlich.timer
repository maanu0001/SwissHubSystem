# Der stuendliche Durchgang: WAL pruefen, Dateien sichern, inkrementelles
# Basis-Backup, extern uebertragen.

[Unit]
Description=SwissHub Sicherung stuendlich
Documentation=file:///opt/swisshub/docs/BACKUP.md

[Timer]
Unit=swisshub-backup@stuendlich.service
# Zur Minute 20: nicht zur vollen Stunde. Dort laufen die Zeitplaene aller
# uebrigen Dienste, und ein Backup, das mit dem stuendlichen Abgleich des Bots
# zusammenfaellt, verlangsamt beide.
OnCalendar=*-*-* *:20:00
# Bis zu fuenf Minuten Streuung. Ohne sie starten nach einem Neustart alle
# Timer gleichzeitig.
RandomizedDelaySec=5min
# Ein verpasster Lauf wird nachgeholt - nach einem Neustart oder wenn der
# Server geschlafen hat.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
