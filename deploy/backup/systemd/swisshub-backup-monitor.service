# SwissHub - Ueberwachung und Alarmierung.

[Unit]
Description=SwissHub Backup-Ueberwachung
Documentation=file:///opt/swisshub/docs/BACKUP.md
After=network-online.target

[Service]
Type=oneshot
User=swisshub-backup
Group=swisshub-backup
SupplementaryGroups=postgres docker
ExecStart=/usr/local/lib/swisshub-backup/bin/swisshub-backup-monitor

# Kurze Grenze: die Ueberwachung fragt nur ab. Bleibt sie haengen, ist das
# selbst ein Befund - und der Totmannschalter meldet den ausbleibenden Ping.
TimeoutStartSec=10min

# Wie bei den uebrigen Diensten: hinter dem produktiven Betrieb zurueck.
# Die Ueberwachung fragt nur ab - aber sie fragt PostgreSQL ab und liest
# Zustandsdateien, und auch das ist I/O.
IOWeight=50
CPUWeight=50
Nice=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/swisshub-backup
ReadOnlyPaths=/etc/swisshub-backup /opt/swisshub /etc/letsencrypt
