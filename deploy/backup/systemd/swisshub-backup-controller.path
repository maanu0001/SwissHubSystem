# Sobald die WebApp eine Anforderung ablegt, laeuft der Controller.
#
# Ein Pfad-Beobachter und kein Dienst, der wartet: es gibt keinen Prozess, der
# dauerhaft laeuft und abstuerzen koennte. systemd beobachtet das Verzeichnis
# und startet den Controller, wenn etwas darin liegt.
#
# Der Timer daneben ist die Reissleine: fiele die Beobachtung aus - etwa weil
# das Verzeichnis neu angelegt wurde und der Inode nicht mehr derselbe ist -
# bliebe eine Anforderung sonst ewig liegen, und im Dashboard staende
# «laeuft» ohne dass etwas laeuft.

[Unit]
Description=SwissHub Backup-Controller beobachtet den Eingang
Documentation=file:///opt/swisshub/docs/BACKUP.md

[Path]
PathExistsGlob=/var/lib/swisshub-backup/spool/eingang/*.json
Unit=swisshub-backup-controller.service

[Install]
WantedBy=multi-user.target
