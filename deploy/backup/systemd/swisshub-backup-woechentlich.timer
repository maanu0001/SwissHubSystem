# Der woechentliche Durchgang: vollstaendiges Basis-Backup.

[Unit]
Description=SwissHub Sicherung woechentlich (Vollbackup)
Documentation=file:///opt/swisshub/docs/BACKUP.md

[Timer]
Unit=swisshub-backup@woechentlich.service
# Sonntag frueh. Ein Vollbackup ist der teuerste Lauf; er gehoert in die
# Stunde mit der geringsten Aktivitaet der Woche.
OnCalendar=Sun *-*-* 02:33:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
