{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Tests pruefen auch Bauteile der WebApp, und einige davon sind `.tsx` -
    // etwa die Karten zum Teilen. `apps/web/tsconfig.json` steht auf
    // "preserve", weil Next die Uebersetzung selbst macht; hier gibt es kein
    // Next, also die neue Uebersetzung direkt.
    "jsx": "react-jsx",
    // Damit Tests die Server-Helfer der WebApp unter demselben Kuerzel
    // ansprechen wie die WebApp selbst. Vitest kennt dieselbe Zuordnung.
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/bot/src/**/*.ts",
    "apps/game-agent/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/.next",
    /*
     * Tests, die Bauteile der WebApp wirklich zeichnen, gehoeren in das
     * TypeScript-Projekt der WebApp - `apps/web/tsconfig.json` listet sie
     * dort auf.
     *
     * Hier steht `lib: ["ES2022"]` ohne DOM, und das mit Absicht: der Bot
     * und die Pakete laufen in Node, und ein versehentliches `document`
     * soll dort auffallen. Ein Bauteil wie `DiscordAvatar` fragt aber
     * `img.complete` ab - echter Browser-Code, der ohne DOM-Typen nicht
     * uebersetzt. Die Wahl ist also: DOM fuer alles aufmachen, oder diese
     * paar Tests dort pruefen, wo die DOM-Typen ohnehin gelten.
     */
    "tests/unit/leaderboard-kachel.test.ts",
    "tests/unit/warteschlange-filter.test.ts"
  ]
}
