{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    // Tests, die Bauteile dieser Anwendung zeichnen. Sie brauchen die
    // DOM-Typen von hier; das Wurzelprojekt laesst sie deshalb aus.
    "../../tests/unit/leaderboard-kachel.test.ts"
  ],
  "exclude": ["node_modules"]
}
